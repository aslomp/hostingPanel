FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server python3 && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* && mkdir -p /jails /run/sshd /run/hostingpanel-keys && chmod 0755 /jails /run/sshd /run/hostingpanel-keys
COPY deploy/openssh/start.py /usr/local/lib/hostingpanel-sftp.py
COPY deploy/openssh/sshd_config /etc/ssh/hostingpanel_sshd_config
EXPOSE 2022
ENTRYPOINT ["/usr/bin/python3","/usr/local/lib/hostingpanel-sftp.py"]
