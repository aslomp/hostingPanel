# Optional: attach to an existing HTTPS Gateway listener in another namespace.
# The Gateway listener must explicitly permit routes from the hostingpanel namespace.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: hostingpanel
  namespace: hostingpanel
spec:
  parentRefs:
    - name: your-gateway
      namespace: your-gateway-namespace
      sectionName: https
  hostnames:
    - panel.example.invalid
  rules:
    - backendRefs:
        - name: panel-hostingpanel-web
          port: 8080
