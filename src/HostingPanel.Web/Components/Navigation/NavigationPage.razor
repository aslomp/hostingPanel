                S("Messages", "api/messages/list")),
            ["create-admin"] = P("Create administrator", "Account management",
                "The current Swagger does not contain an administrator creation operation. Account data can be viewed.",
                S("Accounts", "api/search/users?limit=1000")),
            ["httpd-config"] = P("Custom HTTPD configurations", "Server management",
                "Available web server information through the official API.",
                S("DirectAdmin configuration", "api/server-settings/directadmin-conf/active"),
