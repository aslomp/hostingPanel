@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/navigation/{Key}"
@using System.Text.Json
@inject PanelSession Session
@inject CompatibilityApiClient ApiClient

@if (Key == "ip-management")
{
    <BackendSettings @key="Key" IpOnly="true" />
}
else if (Key == "name-servers")
{
    <BackendSettings @key="Key" NameserversOnly="true" />
}
else if (Key == "file-manager")
{
    <FileManagerOverview @key="Key" />
}
else if (Key == "domain-ssl")
{
    <DomainSslOverview @key="Key" />
}
else
{
<PageTitle>@Title — HostingPanel</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@Category</Breadcrumb>
    <TitleContent>@Title</TitleContent>
    <Description>@Description</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>

@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">dashboard</a>.</MudPaper>
}
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Data from DirectAdmin"]</h2>
        @if (Sources.Count == 0)
        {
            <p>@L["The current API specification provides no suitable read operation for this feature. No data is fabricated."]</p>
            <p>@L["The backend may offer additional legacy functionality, which requires a separate adapter."]</p>
        }
        else
        {
            <label for="data-source">@L["Information"]</label>
            <MudSelect T="string" @bind-Value="selected" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="data-source">
                @foreach (var source in Sources)
                {
                    <MudSelectItem T="string" Value='@source.Path'>@L[source.Label]</MudSelectItem>
                }
            </MudSelect>
            @if (selected.Contains("{domain}", StringComparison.Ordinal) ||
                 selected.Contains("{username}", StringComparison.Ordinal) ||
                 selected.Contains("{skin}", StringComparison.Ordinal) ||
                 selected.Contains("{id}", StringComparison.Ordinal))
            {
                <label for="resource-name">@(selected.Contains("{domain}") ? L["Domain name"].Value :
                    selected.Contains("{username}") ? L["Username"].Value :
                    selected.Contains("{skin}") ? L["Skin name"].Value : L["Identifier"].Value)</label>
                <MudTextField T="string" @bind-Value="resource" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="resource-name" Placeholder="@L["Enter the required value"].Value" />
            }
            @if (Key == "file-manager")
            {
                <label for="file-path">Directory</label>
                <MudTextField T="string" @bind-Value="directory" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="file-path" Placeholder="." />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Load">@L["Retrieve"]</MudButton>
            @if (!string.IsNullOrEmpty(statusText))
            {
                <p role="status">@statusText</p>
            }
            @if (!string.IsNullOrWhiteSpace(response))
            {
                <JsonOverview Json="@response" />
            }
        }
    </MudPaper>
}

}

@code {
    [Parameter] public string Key { get; set; } = "";
    private sealed record DataSource(string Label, string Path);
    private sealed record PageDefinition(string Title, string Category, string Description, DataSource[] Sources);
    private string selected = "", resource = "", directory = ".";
    private string? response, statusText;
    private bool busy;
    private string Title => L[Definition.Title].Value;
    private string Category => L[Definition.Category].Value;
    private string Description => L[Definition.Description].Value;
    private IReadOnlyList<DataSource> Sources => Definition.Sources;
    private PageDefinition Definition => Pages.TryGetValue(Key, out var page) ? page
        : new("Unknown page", "HostingPanel", "This navigation page does not exist.", []);

    protected override async Task OnParametersSetAsync()
    {
        if (Key is "ip-management" or "name-servers" or "domain-ssl" or "file-manager") return;
        selected = Sources.FirstOrDefault()?.Path ?? "";
        response = null;
        statusText = null;
        if (Session.Connected && selected.Length != 0 && !selected.Contains('{'))
            await Load();
    }

    private async Task Load()
    {
        if (busy || !Session.Connected || string.IsNullOrWhiteSpace(selected)) return;
        var path = selected;
        foreach (var placeholder in new[] { "{domain}", "{username}", "{skin}", "{id}" })
        {
            if (!path.Contains(placeholder, StringComparison.Ordinal)) continue;
            if (string.IsNullOrWhiteSpace(resource))
            {
                statusText = L["Enter the required identifier first."].Value;
                return;
            }
            path = path.Replace(placeholder, Uri.EscapeDataString(resource.Trim()),
                StringComparison.Ordinal);
        }
        if (Key == "file-manager" && (path == "api/filemanager/list" || path == "api/filemanager/tree"))
            path += "?path=" + Uri.EscapeDataString(directory);
        if (path is "api/email-logs" or "api/email-logs-summary")
            path += "?from=" + Uri.EscapeDataString(DateTimeOffset.UtcNow.AddDays(-1).ToString("O"));
        if (!CompatibilityApiClient.IsAllowedEndpoint(path))
        {
            statusText = L["Invalid API path."].Value;
            return;
        }
        busy = true;
        try
        {
            var (status, body) = await ApiClient.GetRawAsync(path);
            statusText = status is >= 200 and < 300
                ? L["Data received from DirectAdmin (HTTP {0}).", status].Value
                : L["DirectAdmin returned HTTP {0}.", status].Value;
            response = body;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            statusText = ex.Message;
            response = null;
        }
        finally { busy = false; }
    }

    private static PageDefinition P(string title, string category, string description,
        params DataSource[] sources) => new(title, category, description, sources);
    private static DataSource S(string label, string path) => new(label, path);

    // Only actual paths in the pinned DirectAdmin Swagger are used here.
    // An empty mapping means the public contract has no matching read operation.
