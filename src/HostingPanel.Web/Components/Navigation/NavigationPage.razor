                S("CustomBuild options", "api/custombuild/options-v2"),
                S("Software", "api/custombuild/software"),
                S("Versions", "api/custombuild/versions")),
            ["custombuild"] = P("CustomBuild", "Server management",
                "Configuration, versions, updates and execution status.",
                S("Options", "api/custombuild/options-v2"),
                S("Updates", "api/custombuild/updates"),
                S("Software", "api/custombuild/software"),
                S("Versions", "api/custombuild/versions"),
                S("Status", "api/custombuild/state"),
                S("Actions", "api/custombuild/actions"),
                S("Logs", "api/custombuild/logs")),
            ["backup-restore"] = P("Backup and restore", "Admin tools",
                "The pinned modern Swagger has no general backup/restore operation."),
            ["brute-force-monitor"] = P("Brute force monitor", "Admin tools",
                "Login and security events from the available API.",
