@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using HostingPanel.Api.Services
@inject PanelSession Session
@inject AccountOperations Accounts
@inject IDialogService Dialogs

<PageTitle>@L[ResellersOnly ? "Resellers — HostingPanel" : "Account tree — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Account management"]</Breadcrumb>
    <TitleContent>@L[ResellersOnly ? "Reseller management" : "User management"]</TitleContent>
    <Description>@L[ResellersOnly ? "Accounts accessible to the current identity." : "All accessible accounts, including resellers and their users."]</Description>
    <Actions>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <CrudAddButton OnClick="OpenCreateDialog" Disabled="@(!Session.Connected || loading || mutating)">@L[ResellersOnly ? "Create reseller" : "Add user"]</CrudAddButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Load" Disabled="@(loading || mutating)">@(loading ? L["Loading…"].Value : L["Refresh"].Value)</MudButton>
        </MudStack>
    </Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-2">@error <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Load">@L["Try again"]</MudButton></MudAlert>
}
else if (loading)
{
    <PanelLoading>@L["Loading account tree…"]</PanelLoading>
}
else if (accounts is not null)
{
    @if (operationMessage is not null) { <MudAlert Severity="@(operationFailed ? Severity.Error : Severity.Success)" Class="my-2">@operationMessage</MudAlert> }
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <div class="dashboard-section-heading"><h2>@L["All accessible accounts"]</h2><MudChip T="string" Size="Size.Small" Color="Color.Success">@Visible.Count()</MudChip></div>
        <label for="userFilter">@L["Search users"]</label>
        <MudTextField T="string" @bind-Value="search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="userFilter" Placeholder="@L["Search username or owner…"].Value" />
        <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><thead><tr><th>@L["Account"]</th><th>@L["Role"]</th><th>@L["Created by"]</th><th>@L["Domains"]</th><th>@L["Actions"]</th></tr></thead>
        <tbody>
        @foreach (var item in Visible)
        {
            <tr>
                <td><span style="@($"padding-left:{item.Depth * 18}px")">@(item.Depth > 0 ? "↳ " : "")<a href="@DetailHref(item.Account)">@item.Account.Username</a></span></td>
                <td><MudChip T="string" Size="Size.Small" Color="Color.Default">@item.Account.Role</MudChip></td>
                <td>@(item.Account.Creator ?? "—")</td>
                <td><a href="@($"/domains?user={Uri.EscapeDataString(item.Account.Username)}")">@L["View domains"]</a></td>
                <td>
                    @if (!item.Account.Role.Equals("admin", StringComparison.OrdinalIgnoreCase) &&
                        !item.Account.Username.Equals(Session.Username, StringComparison.OrdinalIgnoreCase))
                    {
                        <CrudDeleteButton Label="@DeleteLabel(item.Account)" Disabled="@mutating" OnClick="@(() => ConfirmDelete(item.Account))" />
                    }
                </td>
            </tr>
        }
        </tbody></MudSimpleTable>
        @if (!Visible.Any()) { <PanelEmptyState>@L["No accessible accounts."]</PanelEmptyState> }
    </MudPaper>
    @if (ResellersOnly)
    {
        <ResellerPackageOverview />
    }
}
@code {
    [Parameter] public bool ResellersOnly { get; set; }
    private bool operationFailed;
    private string DeleteLabel(VisibleAccount account) => L[account.Role.Equals("reseller", StringComparison.OrdinalIgnoreCase) ? "Delete reseller" : "Delete user"].Value;
    private string DetailHref(VisibleAccount account) => $"/{(account.Role.Equals("reseller", StringComparison.OrdinalIgnoreCase) ? "resellers" : "users")}/{Uri.EscapeDataString(account.Username)}";
    private sealed record TreeItem(VisibleAccount Account, int Depth);
    private List<VisibleAccount>? accounts;
    private string search = "";
    private string? error;
    private bool loading;
    private bool mutating;
    private string? operationMessage;

    private IEnumerable<TreeItem> Visible => Ordered().Where(item => !ResellersOnly || item.Account.Role.Equals("reseller", StringComparison.OrdinalIgnoreCase)).Where(item =>
        item.Account.Username.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        (item.Account.Creator?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<TreeItem> Ordered()
    {
        if (accounts is null) yield break;
        var byName = accounts.Select(x => x.Username).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var children = accounts.Where(x => x.Creator is not null).ToLookup(x => x.Creator!, StringComparer.OrdinalIgnoreCase);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var roots = accounts.Where(x => x.Creator is null ||
            !byName.Contains(x.Creator) ||
            x.Creator.Equals(x.Username, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Role == "admin" ? 0 : x.Role == "reseller" ? 1 : 2)
            .ThenBy(x => x.Username, StringComparer.OrdinalIgnoreCase);
        foreach (var root in roots)
            foreach (var item in Descendants(root, 0)) yield return item;
        foreach (var remaining in accounts)
            foreach (var item in Descendants(remaining, 0)) yield return item;

        IEnumerable<TreeItem> Descendants(VisibleAccount parent, int depth)
        {
            if (!visited.Add(parent.Username)) yield break;
            yield return new(parent, depth);
            foreach (var child in children[parent.Username]
                .OrderBy(x => x.Username, StringComparer.OrdinalIgnoreCase))
                foreach (var item in Descendants(child, depth + 1))
                    yield return item;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (mutating || !Session.Connected) return;
        mutating = true;
        operationMessage = null;
        try
        {
            var dialog = await Dialogs.ShowAsync<UserCreateDialog>(
                L[ResellersOnly ? "Create reseller" : "Create user"].Value,
                new DialogParameters<UserCreateDialog> { { x => x.Kind, ResellersOnly ? "reseller" : "user" } },
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false, CloseOnEscapeKey = false });
            var result = await dialog.Result;
            if (result is { Canceled: false }) { operationFailed = false; operationMessage = L["Account creation request accepted."].Value; await Load(); }
        }
        finally { mutating = false; }
    }

    private async Task ConfirmDelete(VisibleAccount account)
    {
        if (mutating || !Session.Connected) return;
        if (account.Role.Equals("admin", StringComparison.OrdinalIgnoreCase) ||
            account.Username.Equals(Session.Username, StringComparison.OrdinalIgnoreCase)) return;
        var identity = Session.Username;
        mutating = true;
        operationMessage = null;
        try
        {
        var confirmed = await Dialogs.ConfirmResourceDeletionAsync(
            $"{L["Delete account"]}: {account.Username}", account.Username,
            L["Deleting this account is irreversible. All associated data will be removed."].Value,
            L["Confirm account name"].Value);
        if (!confirmed || !Session.Connected || !string.Equals(identity, Session.Username, StringComparison.Ordinal))
            return;
            var (status, errorCode) = await Accounts.DeleteAsync(account.Username, account.Username);
            operationFailed = errorCode is not null || status is < 200 or >= 300;
            if (!operationFailed) { operationMessage = L["Deletion request accepted for '{0}'.", account.Username].Value; await Load(); }
            else operationMessage = L["Deletion not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            operationFailed = true;
            operationMessage = ex.Message;
        }
        finally { mutating = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Session.Connected) await Load();
    }
    private async Task Load()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        try
        {
            var result = await Accounts.ListAsync();
            if (result.Status != 200 || result.Accounts is null)
                throw new InvalidOperationException(L["Backend HTTP {0}.", result.Status].Value);
            accounts = result.Accounts.ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or UnauthorizedAccessException or FormatException)
        {
            error = ex.Message;
            accounts = null;
        }
        finally { loading = false; }
    }
}
