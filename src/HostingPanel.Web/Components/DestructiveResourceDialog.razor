@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <strong>@Warning</strong>
            <MudText Typo="Typo.body2">@Description</MudText>
        </MudAlert>
        <MudTextField T="string" @bind-Value="confirmation" Immediate="true"
                      Label="@Prompt" Variant="Variant.Outlined" AutoComplete="off" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled"
                   Disabled="@(!string.Equals(confirmation, ResourceName, StringComparison.Ordinal))"
                   OnClick="Confirm">@L["Permanently delete"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string ResourceName { get; set; } = "";
    [Parameter, EditorRequired] public string Warning { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter, EditorRequired] public string Prompt { get; set; } = "";
    private string confirmation = "";
    private void Cancel() => Dialog.Cancel();
    private void Confirm()
    {
        if (string.Equals(confirmation, ResourceName, StringComparison.Ordinal))
            Dialog.Close(DialogResult.Ok(true));
    }
}
