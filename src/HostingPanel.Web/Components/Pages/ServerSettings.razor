@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/server-settings"
@using System.Text.Json
@inject DirectAdminSession Session
<PageTitle>@L["Server settings — HostingPanel"]</PageTitle>
<div class="page-header"><div><div class="eyebrow">@L["Server management"]</div><h1>@L["Server settings"]</h1><p>@L["DirectAdmin configuration and server settings through the official API."]</p></div><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></div>
@if (!Session.Connected) { <section class="card">Verbind eerst via het <a href="/">dashboard</a>.</section> }
else
{
    <section class="card">
        <h2>@L["Configuration source"]</h2>
        <MudSelect T="string" @bind-Value="endpoint" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value='@("api/server-settings/directadmin-conf/active")'>@L["Active DirectAdmin configuration"]</MudSelectItem>
            <MudSelectItem T="string" Value='@("api/server-settings/directadmin-conf/default")'>@L["Default configuration"]</MudSelectItem>
            <MudSelectItem T="string" Value='@("api/server-settings/directadmin-conf/local")'>@L["Local overrides"]</MudSelectItem>
            <MudSelectItem T="string" Value='@("api/server-settings/db-config")'>@L["Database connection"]</MudSelectItem>
            <MudSelectItem T="string" Value='@("api/server-settings/email/config")'>@L["Email server configuration"]</MudSelectItem>
            <MudSelectItem T="string" Value='@("api/server-settings/email/outbound-filter")'>@L["Outbound mail filter"]</MudSelectItem>
            <MudSelectItem T="string" Value='@("api/server-settings/timezone/current")'>@L["Time zone"]</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Retrieve configuration"]</MudButton>
        <p>@message</p>
        <JsonOverview Json="@result" />
    </section>
    <section class="card">
        <h2>@L["Modify local DirectAdmin overrides"]</h2>
        <p>@L["This PATCH uses only"] <code>/api/server-settings/directadmin-conf/local</code>@L[". Specify only fields you want to change."]</p>
        <MudTextField T="string" @bind-Value="patch" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="{}" Lines="10" spellcheck="false" />
        <label>@L["Enter PATCH to confirm"]</label><MudTextField T="string" @bind-Value="confirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button class="primary" disabled="@(busy || confirmation != "PATCH")" @onclick="Apply">@L["Apply patch"]</button>
        @if (mutation is not null) { <p role="status">@mutation</p> }
    </section>
    <section class="card">
        <h2>@L["Test or change database connection"]</h2>
        <p>@L["Complete the official DirectAdmin database configuration contract. A test does not save settings."]</p>
        <MudTextField T="string" @bind-Value="dbConfigJson" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Lines="10" spellcheck="false" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="TestDatabaseConfig">@L["Test connection"]</MudButton>
        <label>@L["Enter SAVE DB to replace database configuration"]</label>
        <MudTextField T="string" @bind-Value="dbConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button disabled="@(busy || dbConfirmation != "SAVE DB")" @onclick="SaveDatabaseConfig">@L["Save database configuration"]</button>
    </section>
    <section class="card">
        <h2>@L["Change server hostname"]</h2>
        <label>@L["New hostname"]</label><MudTextField T="string" @bind-Value="hostname" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="server.example.com" />
        <label>@L["Enter HOSTNAME to confirm"]</label><MudTextField T="string" @bind-Value="hostnameConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button disabled="@(busy || string.IsNullOrWhiteSpace(hostname) || hostnameConfirmation != "HOSTNAME")" @onclick="ChangeHostname">@L["Change hostname"]</button>
    </section>
    <section class="card">
        <h2>@L["Change time zone"]</h2>
        <label>@L["Time zone (IANA)"]</label><MudTextField T="string" @bind-Value="timezone" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="Europe/Amsterdam" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="ListTimezones">@L["Retrieve available time zones"]</MudButton>
        <JsonOverview Json="@timezones" />
        <label>@L["Enter TIMEZONE to confirm"]</label><MudTextField T="string" @bind-Value="timezoneConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button disabled="@(busy || string.IsNullOrWhiteSpace(timezone) || timezoneConfirmation != "TIMEZONE")" @onclick="ChangeTimezone">@L["Change time zone"]</button>
    </section>
}
@code {
    private string endpoint = "api/server-settings/directadmin-conf/active";
    private string patch = "{}", confirmation = "", result = "";
    private string hostname = "", hostnameConfirmation = "", timezone = "", timezoneConfirmation = "", timezones = "";
    private string dbConfigJson = "", dbConfirmation = "";
    private string? message, mutation;
    private bool busy;
    protected override async Task OnInitializedAsync() { if (Session.Connected) await Load(); }
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true; message = null;
        try
        {
            var (status, body) = await Session.GetRawAsync(endpoint);
            message = $"HTTP {status}";
            result = body;
            if (endpoint == "api/server-settings/db-config" && status == 200) dbConfigJson = body;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { message = ex.Message; result = ""; }
        finally { busy = false; }
    }
    private bool ValidDatabaseConfig()
    {
        using var json = JsonDocument.Parse(dbConfigJson);
        var root = json.RootElement;
        return root.ValueKind == JsonValueKind.Object &&
            new[] { "address", "password", "tls", "tlsVerify", "unixSocket", "user" }
                .All(key => root.TryGetProperty(key, out _));
    }

    private async Task TestDatabaseConfig()
    {
        if (busy || !Session.Connected) return;
        busy = true; mutation = null;
        try
        {
            if (!ValidDatabaseConfig())
            { mutation = L["The database configuration contract is incomplete."].Value; return; }
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Post,
                "api/server-settings/db-config-test", dbConfigJson);
            mutation = $"Test: backend HTTP {status}. {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        { mutation = ex.Message; }
        finally { busy = false; }
    }

    private async Task SaveDatabaseConfig()
    {
        if (busy || !Session.Connected || dbConfirmation != "SAVE DB") return;
        busy = true; mutation = null;
        try
        {
            if (!ValidDatabaseConfig())
            { mutation = L["The database configuration contract is incomplete."].Value; return; }
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Put,
                "api/server-settings/db-config", dbConfigJson);
            mutation = L["Save: backend HTTP {0}. {1}", status, body].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        { mutation = ex.Message; }
        finally { busy = false; dbConfirmation = ""; }
    }

    private async Task ListTimezones()
    {
        if (busy || !Session.Connected) return;
        busy = true; mutation = null;
        try
        {
            var (status, body) = await Session.GetRawAsync("api/server-settings/timezone/list");
            timezones = $"HTTP {status}\n{body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { mutation = ex.Message; }
        finally { busy = false; }
    }
    private async Task ChangeHostname()
    {
        if (busy || hostnameConfirmation != "HOSTNAME" || string.IsNullOrWhiteSpace(hostname)) return;
        busy = true; mutation = null;
        try
        {
            var json = JsonSerializer.Serialize(new { hostname });
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Post,
                "api/server-settings/change-hostname", json);
            mutation = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { mutation = ex.Message; }
        finally { busy = false; hostnameConfirmation = ""; }
    }
    private async Task ChangeTimezone()
    {
        if (busy || timezoneConfirmation != "TIMEZONE" || string.IsNullOrWhiteSpace(timezone)) return;
        busy = true; mutation = null;
        try
        {
            var json = JsonSerializer.Serialize(new { tz = timezone });
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Post,
                "api/server-settings/timezone/set", json);
            mutation = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { mutation = ex.Message; }
        finally { busy = false; timezoneConfirmation = ""; }
    }
    private async Task Apply()
    {
        if (busy || confirmation != "PATCH") return;
        busy = true; mutation = null;
        try
        {
            using var json = JsonDocument.Parse(patch);
            if (json.RootElement.ValueKind != JsonValueKind.Object)
            { mutation = L["The patch must be a JSON object."].Value; return; }
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Patch,
                "api/server-settings/directadmin-conf/local", patch);
            mutation = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        { mutation = ex.Message; }
        finally { busy = false; confirmation = ""; }
    }
}
