@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/change-password"
@using System.Text.Json
@inject DirectAdminSession Session
<PageTitle>@L["Change password — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Account management"]</Breadcrumb>
    <TitleContent>@L["Change password"]</TitleContent>
    <Description>@L["DirectAdmin determines which password changes are permitted."]</Description>
</PanelPageHeader>
@if (!Session.Connected) { <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper> }
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <MudForm @ref="form">
        <MudTextField T="string" Label="@L["Current password"].Value" Required="true" @bind-Value="currentPassword" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="current-password" InputType="InputType.Password" />
        <MudTextField T="string" Label="@L["New password"].Value" Required="true" @bind-Value="newPassword" Validation="@(new Func<string, string?>(ValidateNewPassword))" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="new-password" InputType="InputType.Password" />
        <MudTextField T="string" Label="@L["Repeat new password"].Value" Required="true" @bind-Value="confirmation" Validation="@(new Func<string, string?>(ValidateConfirmation))" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="new-password" InputType="InputType.Password" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrEmpty(currentPassword) || newPassword.Length < 3 || newPassword != confirmation)" OnClick="Save">@L["Change password"]</MudButton>
        @if (feedback is not null) { <p role="status">@feedback</p> }
        </MudForm>
    </MudPaper>
}
@code {
    private MudForm form = default!;
    private string currentPassword = "", newPassword = "", confirmation = "";
    private string? feedback;
    private bool busy;
    private string? ValidateNewPassword(string value) => string.IsNullOrEmpty(value) || value.Length < 3 ? L["Password must contain at least 3 characters."].Value : null;
    private string? ValidateConfirmation(string value) => value != newPassword ? L["Passwords do not match."].Value : null;
    private async Task Save()
    {
        if (busy || !Session.Connected || string.IsNullOrEmpty(currentPassword) || newPassword != confirmation || newPassword.Length < 3) return;
        await form.ValidateAsync();
        if (!form.IsValid || busy || !Session.Connected || string.IsNullOrEmpty(currentPassword) || newPassword != confirmation || newPassword.Length < 3) return;
        busy = true; feedback = null;
        try
        {
            var json = JsonSerializer.Serialize(new { currentPassword, newPassword });
            var (status, _) = await Session.RequestApiAsync(HttpMethod.Post, "api/change-password", json);
            feedback = status == 204 ? L["DirectAdmin confirmed the password change."].Value
                : L["The backend did not confirm the change (HTTP {0}).", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException)
        { feedback = ex.Message; }
        finally
        {
            busy = false;
            currentPassword = "";
            newPassword = "";
            confirmation = "";
        }
    }
}
