@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/change-password"
@using System.Text.Json
@inject DirectAdminSession Session
<PageTitle>@L["Change password — HostingPanel"]</PageTitle>
<div class="page-header"><div><div class="eyebrow">@L["Account management"]</div><h1>@L["Change password"]</h1><p>@L["DirectAdmin determines which password changes are permitted."]</p></div></div>
@if (!Session.Connected) { <section class="card">Verbind eerst via het <a href="/">dashboard</a>.</section> }
else
{
    <section class="card">
        <label>@L["Current password"]</label><MudTextField T="string" @bind-Value="currentPassword" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="current-password" InputType="InputType.Password" />
        <label>@L["New password"]</label><MudTextField T="string" @bind-Value="newPassword" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="new-password" InputType="InputType.Password" />
        <label>@L["Repeat new password"]</label><MudTextField T="string" @bind-Value="confirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="new-password" InputType="InputType.Password" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrEmpty(currentPassword) || newPassword.Length < 3 || newPassword != confirmation)" OnClick="Save">@L["Change password"]</MudButton>
        @if (feedback is not null) { <p role="status">@feedback</p> }
    </section>
}
@code {
    private string currentPassword = "", newPassword = "", confirmation = "";
    private string? feedback;
    private bool busy;
    private async Task Save()
    {
        if (busy || !Session.Connected || newPassword != confirmation || newPassword.Length < 3) return;
        busy = true; feedback = null;
        try
        {
            var json = JsonSerializer.Serialize(new { currentPassword, newPassword });
            var (status, _) = await Session.RequestApiAsync(HttpMethod.Post, "api/change-password", json);
            feedback = status == 204 ? L["DirectAdmin confirmed the password change."].Value
                : L["The backend did not confirm the change (HTTP {0}).", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException)
        { feedback = ex.Message; }
        finally
        {
            busy = false;
            currentPassword = "";
            newPassword = "";
            confirmation = "";
        }
    }
}
