@page "/change-password"
@using System.Text.Json
@inject DirectAdminSession Session
<PageTitle>Wachtwoord wijzigen — HostingPanel</PageTitle>
<div class="page-header"><div><div class="eyebrow">Accountbeheer</div><h1>Wachtwoord wijzigen</h1><p>DirectAdmin bepaalt welke wachtwoordwijzigingen zijn toegestaan.</p></div></div>
@if (!Session.Connected) { <section class="card">Verbind eerst via het <a href="/">dashboard</a>.</section> }
else
{
    <section class="card">
        <label>Huidig wachtwoord</label><input type="password" autocomplete="current-password" @bind="currentPassword" />
        <label>Nieuw wachtwoord</label><input type="password" autocomplete="new-password" @bind="newPassword" />
        <label>Herhaal nieuw wachtwoord</label><input type="password" autocomplete="new-password" @bind="confirmation" />
        <button class="primary" disabled="@(busy || string.IsNullOrEmpty(currentPassword) || newPassword.Length < 3 || newPassword != confirmation)" @onclick="Save">Wachtwoord wijzigen</button>
        @if (feedback is not null) { <p role="status">@feedback</p> }
    </section>
}
@code {
    private string currentPassword = "", newPassword = "", confirmation = "";
    private string? feedback;
    private bool busy;
    private async Task Save()
    {
        if (busy || !Session.Connected || newPassword != confirmation || newPassword.Length < 3) return;
        busy = true; feedback = null;
        try
        {
            var json = JsonSerializer.Serialize(new { currentPassword, newPassword });
            var (status, _) = await Session.RequestApiAsync(HttpMethod.Post, "api/change-password", json);
            feedback = status == 204 ? "DirectAdmin heeft de wachtwoordwijziging bevestigd."
                : $"De backend heeft de wijziging niet bevestigd (HTTP {status}).";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException)
        { feedback = ex.Message; }
        finally
        {
            busy = false;
            currentPassword = "";
            newPassword = "";
            confirmation = "";
        }
    }
}
