@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/system-services"
@using System.Text.Json
@inject DirectAdminSession Session
<PageTitle>@L["System services — HostingPanel"]</PageTitle>
<div class="page-header"><div><div class="eyebrow">@L["Server management"]</div><h1>System Services</h1><p>@L["Live service list, details and management actions; the backend determines which operations are permitted."]</p></div><button disabled="@busy" @onclick="Load">@L["Refresh"]</button></div>
@if (!Session.Connected) { <section class="card">Verbind eerst via het <a href="/">dashboard</a>.</section> }
else
{
    <section class="card">
        <h2>Services</h2>
        @if (busy) { <p role="status">@L["Retrieving…"]</p> }
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        <JsonOverview Json="@services" />
    </section>
    <section class="card">
        <h2>@L["Inspect service"]</h2>
        <label>@L["Service name"]</label>
        <input @bind="service" placeholder="@L["for example nginx"]" />
        <button disabled="@busy" @onclick="Details">@L["Retrieve details and log"]</button>
        <h3>@L["Service details"]</h3><JsonOverview Json="@details" /><h3>@L["Service log"]</h3><JsonOverview Json="@serviceLog" />
    </section>
    <section class="card">
        <h2>@L["Manage service"]</h2>
        <p>@L["Select a service and an exact management action. No actions are hidden based on a local user role."]</p>
        <select @bind="action"><option value="restart">Restart</option><option value="reload">Reload</option><option value="start">Start</option><option value="stop">Stop</option></select>
        <label>@L["Enter the service name to confirm the action"]</label><input @bind="confirmation" />
        <button class="primary" disabled="@(busy || string.IsNullOrWhiteSpace(service) || confirmation != service)" @onclick="Execute">@L["Execute action"]</button>
        @if (outcome is not null) { <p role="status">@outcome</p> }
    </section>
    <section class="card">
        <h2>@L["Service watchdog"]</h2>
        <p>@L["Configure whether DirectAdmin monitors the selected service."]</p>
        <label>Watchdog</label>
        <select @bind="watchdog"><option value="true">@L["Enable"]</option><option value="false">@L["Disable"]</option></select>
        <label>@L["Enter the service name to confirm"]</label><input @bind="watchdogConfirmation" />
        <button disabled="@(busy || !ValidService(service) || watchdogConfirmation != service)" @onclick="SetWatchdog">@L["Update watchdog"]</button>
    </section>
}
@code {
    private string service = "", action = "restart", confirmation = "";
    private string watchdog = "true", watchdogConfirmation = "";
    private string services = "", details = "", serviceLog = "";
    private string? error, outcome;
    private bool busy;
    protected override async Task OnInitializedAsync() { if (Session.Connected) await Load(); }
    private static bool ValidService(string value) =>
        !string.IsNullOrWhiteSpace(value) && value.Length <= 128 &&
        value.All(c => char.IsAsciiLetterOrDigit(c) || c is '_' or '-' or '.' or '@');
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true; error = null;
        try
        {
            var (status, body) = await Session.GetRawAsync("api/system-services/list");
            services = $"HTTP {status}\n{body}";
            if (status is < 200 or >= 300) error = L["Backend did not return the overview (HTTP {0}).", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task Details()
    {
        if (busy || !ValidService(service)) { error = L["Invalid service name."].Value; return; }
        busy = true; error = null;
        try
        {
            var p = Uri.EscapeDataString(service);
            var (s, b) = await Session.GetRawAsync($"api/system-services/service/{p}");
            var (ls, lb) = await Session.GetRawAsync($"api/system-services/service/{p}/log");
            details = $"HTTP {s}\n{b}";
            serviceLog = $"HTTP {ls}\n{lb}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task SetWatchdog()
    {
        if (busy || !ValidService(service) || watchdogConfirmation != service) return;
        busy = true; outcome = null;
        try
        {
            var payload = watchdog == "true" ? """{"enable":true}""" : """{"enable":false}""";
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Put,
                $"api/system-services-actions/service/{Uri.EscapeDataString(service)}/watchdog", payload);
            outcome = status == 204 ? L["DirectAdmin confirmed the watchdog change."].Value
                : L["Watchdog operation: backend HTTP {0}. {1}", status, body].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { outcome = ex.Message; }
        finally { busy = false; watchdogConfirmation = ""; }
    }
    private async Task Execute()
    {
        if (busy || !ValidService(service) || confirmation != service || action is not ("restart" or "reload" or "start" or "stop")) return;
        busy = true; outcome = null;
        try
        {
            var (s, b) = await Session.RequestApiAsync(HttpMethod.Post,
                $"api/system-services-actions/service/{Uri.EscapeDataString(service)}/{action}");
            outcome = L["Action {0}: HTTP {1}. {2}", action, s, b].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { outcome = ex.Message; }
        finally { busy = false; confirmation = ""; }
    }
}
