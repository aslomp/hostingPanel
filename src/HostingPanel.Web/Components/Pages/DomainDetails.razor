@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/domains/{Domain}"
@using System.Text.Json
@inject DirectAdminSession Session
@inject HostingPanel.Api.HostingOperationNotifications Operations
@implements IDisposable

<PageTitle>@Domain — @L["Domain management"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb><a href="/domains">@L["Domain management"]</a> / Details</Breadcrumb>
    <TitleContent>@Domain</TitleContent>
    <Description>@L["Domain configuration and settings."] <a href="@($"/domains/{Uri.EscapeDataString(Domain)}/dns")">@L["Manage DNS records"]</a></Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Refresh" Disabled="@loading">@(loading ? L["Loading…"].Value : L["Refresh"].Value)</MudButton></Actions>
</PanelPageHeader>

@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else if (loading)
{
    <MudPaper Class="pa-4 my-3" Elevation="1" role="status">@L["Retrieving domain information…"]</MudPaper>
}
else
{
    @if (error is not null)
    {
        <MudPaper Class="pa-4 my-3" Elevation="1">
            <h2>@L["Data unavailable"]</h2>
            <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert>
            <p>@L["The backend evaluates read and write operations separately."]</p>
        </MudPaper>
    }
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6"><MudPaper Class="pa-4 my-3" Elevation="1">
            <h2>@L["General"]</h2>
            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><tbody>
                @foreach (var item in new (string Label, string Key)[] {
                    ("Domain", "domain"), ("User", "username"), ("IP address", "ip"),
                    ("Default domain", "defaultdomain"), ("Suspended", "suspended"),
                    ("Subdomains", "subdomain"), ("Document root", "private_html"),
                    ("PHP version", "php1_ver"), ("PHP handler", "php1_info"), ("Provisioning", "provisioning") })
                {
                    @if (fields is not null && fields.TryGetValue(item.Key, out var value))
                    {
                        <tr><th>@L[item.Label]</th><td>@(item.Key == "provisioning" ? L[value].Value : value)</td></tr>
                    }
                }
            </tbody></MudSimpleTable>
        </MudPaper></MudItem>
        <MudItem xs="12" md="6"><MudPaper Class="pa-4 my-3" Elevation="1">
            <h2>@L["Change domain settings"]</h2>
            <p>@L["Each setting is saved separately."]</p>
            <label for="domainPhp">PHP</label>
            <MudSelect T="string" @bind-Value="php" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="domainPhp"><MudSelectItem T="string" Value='@("ON")'>@L["Enabled"]</MudSelectItem><MudSelectItem T="string" Value='@("OFF")'>@L["Disabled"]</MudSelectItem></MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@saving" OnClick="SavePhp">@L["Save PHP"]</MudButton>
            <label for="domainSsl">SSL / HTTPS</label>
            <MudSelect T="string" @bind-Value="ssl" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="domainSsl"><MudSelectItem T="string" Value='@("ON")'>@L["Enabled"]</MudSelectItem><MudSelectItem T="string" Value='@("OFF")'>@L["Disabled"]</MudSelectItem></MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@saving" OnClick="SaveSsl">@L["Save SSL"]</MudButton>
            <label for="domainCgi">CGI</label>
            <MudSelect T="string" @bind-Value="cgi" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="domainCgi"><MudSelectItem T="string" Value='@("ON")'>@L["Enabled"]</MudSelectItem><MudSelectItem T="string" Value='@("OFF")'>@L["Disabled"]</MudSelectItem></MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@saving" OnClick="SaveCgi">@L["Save CGI"]</MudButton>
            <label for="domainBandwidth">@L["Bandwidth (MiB or unlimited)"]</label>
            <MudTextField T="string" @bind-Value="bandwidth" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="domainBandwidth" />
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@saving" OnClick="SaveBandwidth">@L["Save bandwidth"]</MudButton>
            <label for="domainQuota">@L["Disk space (MiB or unlimited)"]</label>
            <MudTextField T="string" @bind-Value="quota" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="domainQuota" />
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@saving" OnClick="SaveQuota">@L["Save quota"]</MudButton>
            @if (saving) { <p role="status">@L["Saving change…"]</p> }
            @if (saveMessage is not null) { <p role="status">@saveMessage</p> }
        </MudPaper></MudItem>
    </MudGrid>
    <DomainAcmeSettings @key="Domain" Domain="@Domain" />
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Additional domain settings"]</h2>
        <p>@L["Additional settings reported by the backend."]</p>
        <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><thead><tr><th>@L["Setting"]</th><th>@L["Value"]</th></tr></thead><tbody>
            @foreach (var item in (fields ?? new Dictionary<string,string>()).OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
            {
                <tr><th>@item.Key</th><td>@item.Value</td></tr>
            }
        </tbody></MudSimpleTable>
    </MudPaper>
}
@code {
    [Parameter] public string Domain { get; set; } = "";
    private Dictionary<string, string>? fields;
    private string? error;
    private string? saveMessage;
    private bool loading;
    private bool saving;
    private string php = "OFF", ssl = "OFF", cgi = "OFF";
    private string bandwidth = "", quota = "";

    private bool disposed;
    protected override void OnInitialized() => Operations.Changed += OperationChanged;
    private void OperationChanged() { if (!disposed) _ = InvokeAsync(RefreshOperationState); }
    public void Dispose() { disposed = true; Operations.Changed -= OperationChanged; }

    protected override async Task OnParametersSetAsync()
    {
        if (Session.Connected) await Refresh();
    }

    private async Task RefreshOperationState()
    {
        if (disposed || !Session.Connected || fields is null) return;
        var domain = Domain;
        try
        {
            var state = await Session.GetProvisioningStatusAsync(domain);
            if (!disposed && domain == Domain && fields is not null && state is not null)
            {
                fields["provisioning"] = state;
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException) { }
    }

    private async Task Refresh()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        fields = null;
        try
        {
            var (status, body) = await Session.GetDomainDetailsAsync(Domain);
            if (status != 200)
            {
                error = status switch
                {
                    403 => L["You do not have access to these domain settings."].Value,
                    404 => L["Domain not found."].Value,
                    _ => L["Domain information unavailable (HTTP {0}).", status].Value
                };
                return;
            }
            using var doc = JsonDocument.Parse(body);
            var settings = doc.RootElement.GetProperty("settings");
            if (settings.ValueKind != JsonValueKind.Object) throw new FormatException("Invalid domain settings.");
            fields = settings.EnumerateObject().ToDictionary(p => p.Name, p => p.Value.ToString(),
                StringComparer.OrdinalIgnoreCase);
            php = Get("php");
            ssl = Get("ssl");
            cgi = Get("cgi");
            bandwidth = Get("bandwidth");
            quota = Get("quota");
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or ArgumentException or FormatException or JsonException)
        {
            error = ex.Message;
        }
        finally { loading = false; }
    }

    private string Get(string key) => fields is not null && fields.TryGetValue(key, out var value)
        ? (key is "php" or "ssl" or "cgi"
            ? (value.Equals("ON", StringComparison.OrdinalIgnoreCase) || value == "1" || value.Equals("true", StringComparison.OrdinalIgnoreCase) ? "ON" : "OFF")
            : value) : "";

    private Task SavePhp() => SaveSetting("php", php);
    private Task SaveSsl() => SaveSetting("ssl", ssl);
    private Task SaveCgi() => SaveSetting("cgi", cgi);
    private Task SaveBandwidth() => SaveSetting("bandwidth", bandwidth);
    private Task SaveQuota() => SaveSetting("quota", quota);

    private async Task SaveSetting(string setting, string value)
    {
        if (saving || !Session.Connected) return;
        saving = true;
        saveMessage = null;
        try
        {
            var (status, _) = await Session.SaveDomainSettingAsync(Domain, setting, value);
            if (status is >= 200 and < 300)
            {
                saveMessage = status == 202 ? L["Domain operation accepted. Provisioning is pending."].Value : L["{0} saved.", setting].Value;
                await Refresh();
            }
            else
                saveMessage = status == 409
                    ? L["The backend reported a conflict for this domain operation."].Value
                    : L["Save failed: HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or ArgumentException)
        {
            saveMessage = ex.Message;
        }
        finally { saving = false; }
    }
}
