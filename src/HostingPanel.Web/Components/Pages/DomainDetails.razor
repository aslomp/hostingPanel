@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/domains/{Domain}"
@using System.Text.Json
@inject DirectAdminSession Session

<PageTitle>@Domain — Domeinbeheer</PageTitle>
<div class="page-header">
    <div>
        <div class="eyebrow"><a href="/domains">@L["Domain management"]</a> / Details</div>
        <h1>@Domain</h1>
        <p>@L["Domain configuration and settings from DirectAdmin."] <a href="@($"/domains/{Uri.EscapeDataString(Domain)}/dns")">@L["Manage DNS records"]</a></p>
    </div>
    <button @onclick="Refresh" disabled="@loading">@(loading ? L["Loading…"].Value : L["Refresh"].Value)</button>
</div>

@if (!Session.Connected)
{
    <div class="card">Verbind eerst met DirectAdmin via het <a href="/">dashboard</a>.</div>
}
else if (loading)
{
    <div class="card" role="status">@L["Retrieving domain information…"]</div>
}
else
{
    @if (error is not null)
    {
        <div class="card">
            <h2>@L["Data unavailable"]</h2>
            <p class="error" role="alert">@error</p>
            <p>@L["DirectAdmin evaluates read and write operations separately."]</p>
        </div>
    }
    <div class="tiles">
        <section class="card">
            <h2>@L["General"]</h2>
            <table><tbody>
                @foreach (var item in new (string Label, string Key)[] {
                    ("Domein", "domain"), ("Gebruiker", "username"), ("IP-adres", "ip"),
                    ("Standaarddomein", "defaultdomain"), ("Opgeschort", "suspended"),
                    ("Subdomeinen", "subdomain"), ("Documentroot", "private_html"),
                    ("PHP-versie", "php1_ver"), ("PHP-handler", "php1_info") })
                {
                    @if (fields is not null && fields.TryGetValue(item.Key, out var value))
                    {
                        <tr><th>@item.Label</th><td>@value</td></tr>
                    }
                }
            </tbody></table>
        </section>
        <section class="card">
            <h2>@L["Change domain settings"]</h2>
            <p>@L["Settings are saved separately without changing other DirectAdmin checkboxes."]</p>
            <label for="domainPhp">PHP</label>
            <select id="domainPhp" @bind="php"><option value="ON">@L["Enabled"]</option><option value="OFF">@L["Disabled"]</option></select>
            <button disabled="@saving" @onclick="SavePhp">@L["Save PHP"]</button>
            <label for="domainSsl">SSL / HTTPS</label>
            <select id="domainSsl" @bind="ssl"><option value="ON">@L["Enabled"]</option><option value="OFF">@L["Disabled"]</option></select>
            <button disabled="@saving" @onclick="SaveSsl">@L["Save SSL"]</button>
            <label for="domainCgi">CGI</label>
            <select id="domainCgi" @bind="cgi"><option value="ON">@L["Enabled"]</option><option value="OFF">@L["Disabled"]</option></select>
            <button disabled="@saving" @onclick="SaveCgi">@L["Save CGI"]</button>
            <label for="domainBandwidth">@L["Bandwidth (MiB or unlimited)"]</label>
            <input id="domainBandwidth" @bind="bandwidth" />
            <button disabled="@saving" @onclick="SaveBandwidth">@L["Save bandwidth"]</button>
            <label for="domainQuota">@L["Disk space (MiB or unlimited)"]</label>
            <input id="domainQuota" @bind="quota" />
            <button disabled="@saving" @onclick="SaveQuota">@L["Save quota"]</button>
            @if (saving) { <p role="status">@L["Saving change…"]</p> }
            @if (saveMessage is not null) { <p role="status">@saveMessage</p> }
        </section>
    </div>
    <section class="card">
        <h2>@L["Other DirectAdmin settings"]</h2>
        <p>@L["All available fields from legacy domain configuration, without fabricated values."]</p>
        <table><thead><tr><th>@L["Setting"]</th><th>@L["Value"]</th></tr></thead><tbody>
            @foreach (var item in (fields ?? new Dictionary<string,string>()).OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
            {
                <tr><th>@item.Key</th><td>@item.Value</td></tr>
            }
        </tbody></table>
    </section>
}
@code {
    [Parameter] public string Domain { get; set; } = "";
    private Dictionary<string, string>? fields;
    private string? error;
    private string? saveMessage;
    private bool loading;
    private bool saving;
    private string php = "OFF", ssl = "OFF", cgi = "OFF";
    private string bandwidth = "", quota = "";

    protected override async Task OnParametersSetAsync()
    {
        if (Session.Connected) await Refresh();
    }

    private async Task Refresh()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        fields = null;
        try
        {
            var (status, body) = await Session.GetDomainDetailsAsync(Domain);
            if (status != 200)
            {
                error = status switch
                {
                    403 => L["You do not have access to these domain settings."].Value,
                    404 => L["DirectAdmin could not find the domain."].Value,
                    _ => L["DirectAdmin could not retrieve domain information (HTTP {0}).", status].Value
                };
                return;
            }
            using var doc = JsonDocument.Parse(body);
            var settings = doc.RootElement.GetProperty("settings");
            if (settings.ValueKind != JsonValueKind.Object) throw new FormatException("Invalid domain settings.");
            fields = settings.EnumerateObject().ToDictionary(p => p.Name, p => p.Value.ToString(),
                StringComparer.OrdinalIgnoreCase);
            php = Get("php");
            ssl = Get("ssl");
            cgi = Get("cgi");
            bandwidth = Get("bandwidth");
            quota = Get("quota");
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or ArgumentException or FormatException or JsonException)
        {
            error = ex.Message;
        }
        finally { loading = false; }
    }

    private string Get(string key) => fields is not null && fields.TryGetValue(key, out var value)
        ? (key is "php" or "ssl" or "cgi"
            ? (value.Equals("ON", StringComparison.OrdinalIgnoreCase) || value == "1" ? "ON" : "OFF")
            : value) : "";

    private Task SavePhp() => SaveSetting("php", php);
    private Task SaveSsl() => SaveSetting("ssl", ssl);
    private Task SaveCgi() => SaveSetting("cgi", cgi);
    private Task SaveBandwidth() => SaveSetting("bandwidth", bandwidth);
    private Task SaveQuota() => SaveSetting("quota", quota);

    private async Task SaveSetting(string setting, string value)
    {
        if (saving || !Session.Connected) return;
        saving = true;
        saveMessage = null;
        try
        {
            var (status, _) = await Session.SaveDomainSettingAsync(Domain, setting, value);
            if (status == 200)
            {
                saveMessage = L["{0} saved in DirectAdmin.", setting].Value;
                await Refresh();
            }
            else
                saveMessage = status == 409
                    ? L["Mutations are disabled or the setting is unavailable."].Value
                    : L["Save failed: HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or ArgumentException)
        {
            saveMessage = ex.Message;
        }
        finally { saving = false; }
    }
}
