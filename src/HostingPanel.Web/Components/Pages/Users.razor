@page "/users"
@inject DirectAdminSession Session

<PageTitle>Gebruikers — HostingPanel</PageTitle>
<div class="page-header">
    <div><div class="eyebrow">Accountbeheer</div><h1>Toon alle gebruikers</h1>
        <p>Gegevens van <code>GET /api/search/users</code>, opgehaald via HostingPanel.Api.</p></div>
    <button @onclick="Load" disabled="@loading">@(loading ? "Laden…" : "Vernieuwen")</button>
</div>
@if (!Session.Connected)
{
    <div class="card">Verbind eerst via het <a href="/">dashboard</a> met DirectAdmin.</div>
}
else if (error is not null)
{
    <div class="card error" role="alert">@error <button @onclick="Load">Opnieuw proberen</button></div>
}
else if (loading)
{
    <div class="card" role="status">Gebruikers laden…</div>
}
else if (users is not null)
{
    <div class="card">
        <label for="userFilter">Gebruikers filteren (@users.Count totaal)</label>
        <input id="userFilter" @bind="search" @bind:event="oninput" placeholder="Zoek op gebruikersnaam" />
        <table><thead><tr><th>Gebruikersnaam</th><th>Bron</th></tr></thead>
        <tbody>
        @foreach (var user in users.Where(x => x.Contains(search, StringComparison.OrdinalIgnoreCase)))
        {
            <tr><td>@user</td><td>DirectAdmin</td></tr>
        }
        </tbody></table>
        @if (users.Count == 0) { <p>Geen gebruikers gevonden.</p> }
    </div>
}
@code {
    private IReadOnlyList<string>? users;
    private string search = "";
    private string? error;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Connected) await Load();
    }
    private async Task Load()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        try { users = await Session.GetUsersAsync(); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or UnauthorizedAccessException or FormatException)
        {
            error = ex.Message;
            users = null;
        }
        finally { loading = false; }
    }
}
