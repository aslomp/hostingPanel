@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/api-browser"
@inject DirectAdminSession Session
@inject IConfiguration Configuration

<PageTitle>API — HostingPanel</PageTitle>
<div class="page-header"><div><div class="eyebrow">@L["Integration"]</div><h1>DirectAdmin API</h1><p>@L["View modern DirectAdmin-compatible HostingPanel API responses."]</p></div></div>
<div class="card"><p><a href="@SwaggerUrl" target="_blank" rel="noopener noreferrer">@L["Complete Swagger documentation (274 API paths)"]</a></p><p>@L["The complete pinned DirectAdmin specification; not every operation is implemented in HostingPanel yet."]</p></div>
@if (!Session.Connected) { <div class="card">Verbind eerst via het <a href="/">dashboard</a>.</div> }
else
{
    <div class="card">
        <label>Endpoint<input @bind="endpoint" /></label>
        <button class="primary" @onclick="Fetch">@L["Retrieve"]</button>
        <p>@status</p>
        <JsonOverview Json="@body" />
    </div>
}
@code {
    private string SwaggerUrl => new Uri(
        new Uri(Configuration["HostingPanel:ApiBaseUrl"] ?? "https://localhost:7101/"),
        "swagger/index.html").AbsoluteUri;
    private string endpoint = "api/search/users?limit=1000";
    private string status = "";
    private string body = "";
    private async Task Fetch()
    {
        try { var result = await Session.GetRawAsync(endpoint); status = $"HTTP {result.Status}"; body = result.Body; }
        catch (Exception ex) { status = ex.Message; body = ""; }
    }
}
