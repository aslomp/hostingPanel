@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/domains"
@using System.Text.Json
@inject DirectAdminSession Session
@inject NavigationManager Navigation

<PageTitle>@L["Domain management — HostingPanel"]</PageTitle>
<div class="page-header">
    <div>
        <div class="eyebrow">@L["Account management / Domains"]</div>
        <h1>@L["Domain management"]</h1>
        <p>@L["Live domain list through the HostingPanel adapter to DirectAdmin. Automated tests use fictitious .xyz1 domains; real domains are also permitted when mutations are enabled."]</p>
    </div>
    <button @onclick="Refresh" disabled="@loading">@(loading ? "Laden…" : L["Refresh"].Value)</button>
</div>

@if (!Session.Connected)
{
    <div class="card"><p>Verbind eerst via het <a href="/">dashboard</a>.</p></div>
}
else
{
    <div class="card">
        <h2>@L["Domains of an account"]</h2>
        <p>@L["Leave blank for all domains accessible through DirectAdmin (admin: server-wide; reseller: own accounts; user: own domains). Enter an account to filter."]</p>
        <label for="owner">@L["Username (optional)"]</label>
        <input id="owner" @bind="owner" placeholder="@L["For example, an existing user"]" />
        <button class="primary" @onclick="Refresh" disabled="@loading">@L["Retrieve"]</button>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        @if (warning is not null) { <p role="status">Niet alle accountgegevens zijn beschikbaar: @warning</p> }
        else if (loading) { <p role="status">@L["Retrieving domains…"]</p> }
        else if (domains is not null)
        {
            <p>@domains.Count domein(en) gevonden.</p>
            <label for="domainFilter">@L["Filter domains"]</label>
            <input id="domainFilter" @bind="filter" @bind:event="oninput" placeholder="@L["Search domain name"]" />
            <table>
                <thead><tr><th>@L["Domain"]</th><th>Account</th><th>@L["Source"]</th></tr></thead>
                <tbody>
                @foreach (var domain in domains.Where(d => d.Contains(filter, StringComparison.OrdinalIgnoreCase)))
                {
                    <tr><td><a href="@($"/domains/{Uri.EscapeDataString(domain)}")">@domain</a> — <a href="@($"/domains/{Uri.EscapeDataString(domain)}/dns")">DNS</a></td><td>@(ownership.TryGetValue(domain, out var domainOwner) ? domainOwner : (string.IsNullOrWhiteSpace(owner) ? "—" : owner))</td><td>DirectAdmin</td></tr>
                }
                </tbody>
            </table>
            @if (domains.Count == 0) { <p>@L["No domains found for this account."]</p> }
        }
    </div>

    <div class="card">
        <h2>@L["Prepare domain operation"]</h2>
        <p>Deze actie genereert uitsluitend een voorbeeld van de legacy-aanroep.
            Er wordt <strong>@L["no domain created or modified"]</strong> op de DirectAdmin-server.</p>
        <label for="testDomain">@L["Domain name"]</label>
        <input id="testDomain" @bind="testDomain" placeholder="hosting-test.xyz1" />
        <div class="domain-options">
            <label><input type="checkbox" @bind="php" /> PHP</label>
            <label><input type="checkbox" @bind="ssl" /> SSL</label>
            <label><input type="checkbox" @bind="cgi" /> CGI</label>
        </div>
        <button class="primary" disabled="@previewBusy" @onclick="Preview">
            @(previewBusy ? "Controleren…" : L["View test request"].Value)
        </button>
        @if (previewError is not null) { <p class="error" role="alert">@previewError</p> }
        @if (previewBody is not null)
        {
            <p><strong>Dry-run:</strong> alleen ter controle, niet uitgevoerd.</p>
            <pre>@previewBody</pre>
        }
        <div class="card" style="margin-top:24px">
            <h2>@L["Execute domain operation"]</h2>
            <p>Gebruik eerst de preview hierboven. Deze actie wijzigt de echte DirectAdmin-server
               uitsluitend wanneer de beheerder expliciet de algemene server-side mutatieschakelaar aanzet.
               Verwijderen kan ook bestanden en mailgegevens verwijderen.</p>
            <label for="domainAction">@L["Action"]</label>
            <select id="domainAction" @bind="mutationAction">
                <option value="create">@L["Create"]</option>
                <option value="modify">@L["Modify (PHP / SSL / CGI)"]</option>
                <option value="delete">@L["Delete"]</option>
            </select>
            <label for="confirmDomain">Typ de exacte domeinnaam ter bevestiging: @testDomain</label>
            <input id="confirmDomain" @bind="confirmation" autocomplete="off" />
            <button disabled="@(mutationBusy || confirmation != testDomain || string.IsNullOrWhiteSpace(testDomain))"
                    @onclick="ExecuteMutation">
                @(mutationBusy ? "Uitvoeren…" : L["Confirm domain operation"].Value)
            </button>
            @if (mutationStatus is not null)
            {
                <p role="status">@mutationStatus</p>
            }
        </div>
    </div>
}
@code {
    [SupplyParameterFromQuery(Name = "user")]
    [Parameter] public string? User { get; set; }
    private string owner = "";
    private string filter = "";
    private IReadOnlyList<string>? domains;
    private Dictionary<string,string> ownership = new(StringComparer.OrdinalIgnoreCase);
    private string? warning;
    private string? error;
    private bool loading;
    private string testDomain = "hosting-test.xyz1";
    private bool php = true;
    private bool ssl = true;
    private bool cgi;
    private string mutationAction = "create";
    private string confirmation = "";
    private bool mutationBusy;
    private string? mutationStatus;
    private bool previewBusy;
    private string? previewError;
    private string? previewBody;

    protected override async Task OnParametersSetAsync()
    {
        owner = User ?? "";
        if (Session.Connected) await Refresh();
    }

    private async Task Refresh()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        domains = null;
        try
        {
            var allAccounts = string.IsNullOrWhiteSpace(owner);
            var (status, body) = allAccounts
                ? await Session.GetAccessibleDomainsAsync()
                : await Session.GetDomainsAsync(owner.Trim());
            if (status != 200)
            {
                error = L["Domain list unavailable: HTTP {0}. Check DirectAdmin account permissions.", status].Value;
                return;
            }
            using var json = JsonDocument.Parse(body);
            if (!json.RootElement.TryGetProperty("domains", out var array) ||
                array.ValueKind != JsonValueKind.Array)
                throw new FormatException(L["Unexpected domain list."].Value);
            domains = array.EnumerateArray().Select(e => e.GetString() ?? "").ToArray();
            ownership.Clear();
            warning = null;
            if (allAccounts)
            {
                if (json.RootElement.TryGetProperty("warning", out var w) &&
                    w.ValueKind == JsonValueKind.String) warning = w.GetString();
                if (json.RootElement.TryGetProperty("items", out var items))
                    foreach (var item in items.EnumerateArray())
                    {
                        var domain = item.GetProperty("domain").GetString() ?? "";
                        var user = item.GetProperty("owner").GetString() ?? "";
                        if (domain.Length > 0 && user.Length > 0) ownership[domain] = user;
                    }
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or FormatException
            or InvalidOperationException or ArgumentException or JsonException)
        {
            error = exception.Message;
        }
        finally { loading = false; }
    }

    private async Task Preview()
    {
        if (previewBusy || !Session.Connected) return;
        previewBusy = true;
        previewError = null;
        previewBody = null;
        try
        {
            var (status, body) = await Session.PreviewDomainAsync(testDomain.Trim(), php, ssl, cgi);
            if (status != 200)
            {
                previewError = L["Test domain rejected (HTTP {0}). Use a valid domain name.", status].Value;
                return;
            }
            using var doc = JsonDocument.Parse(body);
            previewBody = JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException
            or ArgumentException or JsonException)
        {
            previewError = exception.Message;
        }
        finally { previewBusy = false; }
    }
    private async Task ExecuteMutation()
    {
        if (mutationBusy || !Session.Connected || confirmation != testDomain) return;
        mutationBusy = true;
        mutationStatus = null;
        try
        {
            var (status, body) = await Session.ExecuteTestDomainAsync(
                testDomain, mutationAction, confirmation, php, ssl, cgi);
            mutationStatus = status switch
            {
                200 => L["DirectAdmin confirmed the domain operation. Refresh the domain overview."].Value,
                409 => L["DirectAdmin reported a conflict for this domain operation."].Value,
                404 => L["DirectAdmin could not find the specified domain."].Value,
                400 => L["Invalid domain name or confirmation."].Value,
                _ => L["Domain operation not confirmed: HTTP {0}.", status].Value
            };
            if (status == 200) { confirmation = ""; await Refresh(); }
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException
            or ArgumentException)
        {
            mutationStatus = exception.Message;
        }
        finally { mutationBusy = false; }
    }

}
