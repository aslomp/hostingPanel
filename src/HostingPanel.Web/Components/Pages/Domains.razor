@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/domains"
@using System.Text.Json
@inject DirectAdminSession Session
@inject NavigationManager Navigation

<PageTitle>@L["Domain management — HostingPanel"]</PageTitle>
<div class="page-header">
    <div>
        <div class="eyebrow">@L["Account management / Domains"]</div>
        <h1>@L["Domain management"]</h1>
        <p>@L["Manage domains and website configuration through the selected hosting backend."]</p>
    </div>
    <button @onclick="Refresh" disabled="@loading">@(loading ? "Laden…" : L["Refresh"].Value)</button>
</div>

@if (!Session.Connected)
{
    <div class="card"><p>Verbind eerst via het <a href="/">dashboard</a>.</p></div>
}
else
{
    <div class="card">
        <h2>@L["Domains of an account"]</h2>
        <p>@L["Leave blank to list all accessible domains, or enter an account to filter."]</p>
        <label for="owner">@L["Username (optional)"]</label>
        <input id="owner" @bind="owner" placeholder="@L["For example, an existing user"]" />
        <button class="primary" @onclick="Refresh" disabled="@loading">@L["Retrieve"]</button>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        @if (warning is not null) { <p role="status">Niet alle accountgegevens zijn beschikbaar: @warning</p> }
        else if (loading) { <p role="status">@L["Retrieving domains…"]</p> }
        else if (domains is not null)
        {
            <p>@domains.Count domein(en) gevonden.</p>
            <label for="domainFilter">@L["Filter domains"]</label>
            <input id="domainFilter" @bind="filter" @bind:event="oninput" placeholder="@L["Search domain name"]" />
            <table>
                <thead><tr><th>@L["Domain"]</th><th>Account</th><th>@L["Actions"]</th></tr></thead>
                <tbody>
                @foreach (var domain in domains.Where(d => d.Contains(filter, StringComparison.OrdinalIgnoreCase)))
                {
                    <tr><td><a href="@($"/domains/{Uri.EscapeDataString(domain)}")">@domain</a> — <a href="@($"/domains/{Uri.EscapeDataString(domain)}/dns")">DNS</a></td><td>@(ownership.TryGetValue(domain, out var domainOwner) ? domainOwner : (string.IsNullOrWhiteSpace(owner) ? "—" : owner))</td><td><button @onclick="() => SelectDelete(domain)" disabled="@mutationBusy">@L["Delete"]</button></td></tr>
                }
                </tbody>
            </table>
            @if (domains.Count == 0) { <p>@L["No domains found for this account."]</p> }
        }
    </div>

    <section class="card">
        <h2>@L["Add domain"]</h2>
        <p>@L["Create a website for the signed-in account."]</p>
        <label for="newDomain">@L["Domain name"]</label>
        <input id="newDomain" @bind="testDomain" placeholder="example.com" />
        <div class="domain-options">
            <label><input type="checkbox" @bind="php" /> PHP</label>
            <label><input type="checkbox" @bind="ssl" /> SSL</label>
            <label><input type="checkbox" @bind="cgi" /> CGI</label>
        </div>
        <button class="primary" disabled="@(mutationBusy || string.IsNullOrWhiteSpace(testDomain))" @onclick="CreateDomain">@L["Add domain"]</button>
        @if (mutationStatus is not null)
        {
            <p role="status">@mutationStatus</p>
        }
    </section>
    @if (deleteDomain is not null)
    {
        <section class="card">
            <h2>@L["Delete domain"]: @deleteDomain</h2>
            <p>@L["Deleting a domain may remove website files and associated resources."]</p>
            <label for="confirmDomain">@L["Enter the exact domain name to confirm."]</label>
            <input id="confirmDomain" @bind="confirmation" autocomplete="off" />
            <button disabled="@(mutationBusy || confirmation != deleteDomain)" @onclick="DeleteDomain">@L["Delete"]</button>
            <button disabled="@mutationBusy" @onclick="CancelDelete">@L["Cancel"]</button>
        </section>
    }
}
@code {
    [SupplyParameterFromQuery(Name = "user")]
    [Parameter] public string? User { get; set; }
    private string owner = "";
    private string filter = "";
    private IReadOnlyList<string>? domains;
    private Dictionary<string,string> ownership = new(StringComparer.OrdinalIgnoreCase);
    private string? warning;
    private string? error;
    private bool loading;
    private string testDomain = "";
    private bool php = true;
    private bool ssl = true;
    private bool cgi;
    private string? deleteDomain;
    private string confirmation = "";
    private bool mutationBusy;
    private string? mutationStatus;

    protected override async Task OnParametersSetAsync()
    {
        owner = User ?? "";
        if (Session.Connected) await Refresh();
    }

    private async Task Refresh()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        domains = null;
        try
        {
            var allAccounts = string.IsNullOrWhiteSpace(owner);
            var (status, body) = allAccounts
                ? await Session.GetAccessibleDomainsAsync()
                : await Session.GetDomainsAsync(owner.Trim());
            if (status != 200)
            {
                error = L["Domain list unavailable: HTTP {0}.", status].Value;
                return;
            }
            using var json = JsonDocument.Parse(body);
            if (!json.RootElement.TryGetProperty("domains", out var array) ||
                array.ValueKind != JsonValueKind.Array)
                throw new FormatException(L["Unexpected domain list."].Value);
            domains = array.EnumerateArray().Select(e => e.GetString() ?? "").ToArray();
            ownership.Clear();
            warning = null;
            if (allAccounts)
            {
                if (json.RootElement.TryGetProperty("warning", out var w) &&
                    w.ValueKind == JsonValueKind.String) warning = w.GetString();
                if (json.RootElement.TryGetProperty("items", out var items))
                    foreach (var item in items.EnumerateArray())
                    {
                        var domain = item.GetProperty("domain").GetString() ?? "";
                        var user = item.GetProperty("owner").GetString() ?? "";
                        if (domain.Length > 0 && user.Length > 0) ownership[domain] = user;
                    }
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or FormatException
            or InvalidOperationException or ArgumentException or JsonException)
        {
            error = exception.Message;
        }
        finally { loading = false; }
    }

    private void SelectDelete(string domain) { deleteDomain = domain; confirmation = ""; mutationStatus = null; }
    private void CancelDelete() { deleteDomain = null; confirmation = ""; }
    private Task CreateDomain() => ExecuteMutation(testDomain.Trim().ToLowerInvariant(), "create");
    private Task DeleteDomain() => deleteDomain is null || confirmation != deleteDomain
        ? Task.CompletedTask : ExecuteMutation(deleteDomain, "delete");

    private async Task ExecuteMutation(string domain, string action)
    {
        if (mutationBusy || !Session.Connected || string.IsNullOrWhiteSpace(domain)) return;
        mutationBusy = true;
        mutationStatus = null;
        try
        {
            var (status, _) = await Session.ExecuteTestDomainAsync(domain, action, domain, php, ssl, cgi);
            mutationStatus = status switch
            {
                200 or 201 or 204 => L["Domain operation completed."].Value,
                202 => L["Domain operation accepted. Provisioning is pending."].Value,
                409 => L["The backend reported a conflict for this domain operation."].Value,
                404 => L["Domain not found."].Value,
                400 => L["Invalid domain or settings."].Value,
                _ => L["Domain operation failed: HTTP {0}.", status].Value
            };
            if (status is >= 200 and < 300)
            {
                if (action == "create") { testDomain = ""; owner = ""; }
                CancelDelete();
                await Refresh();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            mutationStatus = exception.Message;
        }
        finally { mutationBusy = false; }
    }
}
