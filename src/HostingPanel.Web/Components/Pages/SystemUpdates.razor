@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/system-updates"
@using System.Text.Json
@inject DirectAdminSession Session
<PageTitle>@L["System updates — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management"]</Breadcrumb>
    <TitleContent>@L["System packages"]</TitleContent>
    <Description>@L["Available updates and update history directly from the backend."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected) { <section class="card">Verbind eerst via het <a href="/">dashboard</a>.</section> }
else
{
    <section class="card"><h2>@L["Available upgrades"]</h2><JsonOverview Json="@updates" /></section>
    <section class="card"><h2>@L["Update history"]</h2><JsonOverview Json="@history" /></section>
    <section class="card">
        <h2>@L["Check updates"]</h2><p>@L["Run the DirectAdmin update check without installing packages."]</p>
        <label>@L["Packages (comma-separated, blank means all updates)"]</label>
        <MudTextField T="string" @bind-Value="selectedPackages" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="openssl, nginx" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Check">@L["Start update test"]</MudButton>
        <h2>@L["Run update"]</h2>
        <p>@L["This can change system software. Explicit confirmation is required."]</p>
        <label>@L["Enter UPDATE to confirm"]</label><MudTextField T="string" @bind-Value="confirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button class="primary" disabled="@(busy || confirmation != "UPDATE")" @onclick="Run">@L["Start updates"]</button>
        @if (feedback is not null) { <p role="status">@feedback</p> }
    </section>
    <section class="card">
        <h2>@L["Update transaction log"]</h2>
        <label>@L["Transaction ID from update history"]</label><MudTextField T="string" @bind-Value="transactionId" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy || string.IsNullOrWhiteSpace(transactionId))" OnClick="FetchLog">@L["Retrieve log"]</MudButton>
        <JsonOverview Json="@transactionLog" />
    </section>
    @if (busy) { <PanelLoading>@L["Processing…"]</PanelLoading> }
}
@code {
    private string updates = "", history = "", confirmation = "";
    private string selectedPackages = "", transactionId = "", transactionLog = "";
    private string? feedback;
    private bool busy;
    protected override async Task OnInitializedAsync() { if (Session.Connected) await Load(); }
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true;
        try
        {
            var (us, ub) = await Session.GetRawAsync("api/system-packages/updates");
            updates = $"HTTP {us}\n{ub}";
            var (hs, hb) = await Session.GetRawAsync("api/system-packages/history");
            history = $"HTTP {hs}\n{hb}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { feedback = ex.Message; }
        finally { busy = false; }
    }
    private async Task FetchLog()
    {
        if (busy || !Session.Connected || string.IsNullOrWhiteSpace(transactionId) ||
            transactionId.Length > 128 ||
            transactionId.Any(c => !(char.IsAsciiLetterOrDigit(c) || c is '-' or '_')))
        { feedback = L["Invalid transaction ID."].Value; return; }
        busy = true; feedback = null;
        try
        {
            var (status, body) = await Session.GetRawAsync(
                "api/system-packages/history/" + Uri.EscapeDataString(transactionId) + "/log");
            transactionLog = $"HTTP {status}\n{body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { feedback = ex.Message; }
        finally { busy = false; }
    }
    private Task Check() => Action("api/system-packages/update-test");
    private Task Run() => confirmation == "UPDATE" ? Action("api/system-packages/update-run") : Task.CompletedTask;
    private async Task Action(string endpoint)
    {
        if (busy || !Session.Connected) return;
        busy = true; feedback = null;
        try
        {
            var packages = selectedPackages.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (packages.Any(p => p.Length is < 1 or > 128 ||
                p.Any(c => !(char.IsAsciiLetterOrDigit(c) || c is '-' or '_' or '.' or '+'))))
            { feedback = L["Invalid package name."].Value; return; }
            var payload = JsonSerializer.Serialize(new { packages });
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Post, endpoint, payload);
            feedback = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { feedback = ex.Message; }
        finally { busy = false; confirmation = ""; }
    }
}
