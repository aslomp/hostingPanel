@page "/navigation/{Key}"
@using System.Text.Json
@inject DirectAdminSession Session

<PageTitle>@Title — HostingPanel</PageTitle>
<div class="page-header">
    <div>
        <div class="eyebrow">@Category</div>
        <h1>@Title</h1>
        <p>@Description</p>
    </div>
    <button disabled="@busy" @onclick="Load">Vernieuwen</button>
</div>

@if (!Session.Connected)
{
    <section class="card">Meld je eerst aan via het <a href="/">dashboard</a>.</section>
}
else
{
    <section class="card">
        <h2>Gegevens uit DirectAdmin</h2>
        @if (Sources.Count == 0)
        {
            <p>Voor deze functie biedt de huidige API-specificatie geen passende leesoperatie. Er worden geen gegevens verzonnen.</p>
            <p>De backend kan aanvullende legacy-functionaliteit aanbieden; hiervoor is een afzonderlijke adapter nodig.</p>
        }
        else
        {
            <label for="data-source">Informatie</label>
            <select id="data-source" @bind="selected">
                @foreach (var source in Sources)
                {
                    <option value="@source.Path">@source.Label</option>
                }
            </select>
            @if (selected.Contains("{domain}", StringComparison.Ordinal) ||
                 selected.Contains("{username}", StringComparison.Ordinal) ||
                 selected.Contains("{skin}", StringComparison.Ordinal) ||
                 selected.Contains("{id}", StringComparison.Ordinal))
            {
                <label for="resource-name">@(selected.Contains("{domain}") ? "Domeinnaam" :
                    selected.Contains("{username}") ? "Gebruikersnaam" :
                    selected.Contains("{skin}") ? "Skinnaam" : "Identificatie")</label>
                <input id="resource-name" @bind="resource" placeholder="Vul de benodigde waarde in" />
            }
            @if (Key == "file-manager")
            {
                <label for="file-path">Directory</label>
                <input id="file-path" @bind="directory" placeholder="." />
            }
            <button class="primary" disabled="@busy" @onclick="Load">Ophalen</button>
            @if (!string.IsNullOrEmpty(statusText))
            {
                <p role="status">@statusText</p>
            }
            @if (!string.IsNullOrWhiteSpace(response))
            {
                <JsonOverview Json="@response" />
            }
        }
    </section>
}

@code {
    [Parameter] public string Key { get; set; } = "";
    private sealed record DataSource(string Label, string Path);
    private sealed record PageDefinition(string Title, string Category, string Description, DataSource[] Sources);
    private string selected = "", resource = "", directory = ".";
    private string? response, statusText;
    private bool busy;
    private string Title => Definition.Title;
    private string Category => Definition.Category;
    private string Description => Definition.Description;
    private IReadOnlyList<DataSource> Sources => Definition.Sources;
    private PageDefinition Definition => Pages.TryGetValue(Key, out var page) ? page
        : new("Onbekende pagina", "HostingPanel", "Deze navigatiepagina bestaat niet.", []);

    protected override async Task OnParametersSetAsync()
    {
        selected = Sources.FirstOrDefault()?.Path ?? "";
        response = null;
        statusText = null;
        if (Session.Connected && selected.Length != 0 && !selected.Contains('{'))
            await Load();
    }

    private async Task Load()
    {
        if (busy || !Session.Connected || string.IsNullOrWhiteSpace(selected)) return;
        var path = selected;
        foreach (var placeholder in new[] { "{domain}", "{username}", "{skin}", "{id}" })
        {
            if (!path.Contains(placeholder, StringComparison.Ordinal)) continue;
            if (string.IsNullOrWhiteSpace(resource))
            {
                statusText = "Vul eerst de benodigde identificatie in.";
                return;
            }
            path = path.Replace(placeholder, Uri.EscapeDataString(resource.Trim()),
                StringComparison.Ordinal);
        }
        if (Key == "file-manager" && (path == "api/filemanager/list" || path == "api/filemanager/tree"))
            path += "?path=" + Uri.EscapeDataString(directory);
        if (path is "api/email-logs" or "api/email-logs-summary")
            path += "?from=" + Uri.EscapeDataString(DateTimeOffset.UtcNow.AddDays(-1).ToString("O"));
        if (!DirectAdminSession.IsAllowedEndpoint(path))
        {
            statusText = "Ongeldig API-pad.";
            return;
        }
        busy = true;
        try
        {
            var (status, body) = await Session.GetRawAsync(path);
            statusText = status is >= 200 and < 300
                ? "Gegevens ontvangen van DirectAdmin (HTTP " + status + ")."
                : "DirectAdmin retourneerde HTTP " + status + ".";
            response = body;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            statusText = ex.Message;
            response = null;
        }
        finally { busy = false; }
    }

    private static PageDefinition P(string title, string category, string description,
        params DataSource[] sources) => new(title, category, description, sources);
    private static DataSource S(string label, string path) => new(label, path);

    // Only actual paths in the pinned DirectAdmin Swagger are used here.
    // An empty mapping means the public contract has no matching read operation.
