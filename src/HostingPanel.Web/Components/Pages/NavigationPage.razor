                S("Metadata", "api/skin-customization/{skin}/metadata"),
                S("Opties", "api/skin-options/{skin}"),
                S("Globale opties", "api/skin-global-options/{skin}")),
            ["evolution-theme"] = P("Evolution aanpassen", "Admin gereedschap",
                "Skinbestanden en presentatieopties.",
