                S("CustomBuild-opties", "api/custombuild/options-v2")),
            ["ip-management"] = P("IP-beheer", "Serverbeheer",
                "De huidige Swagger bevat geen IP-adresbeheer. Serverinformatie is alleen ter inzage.",
                S("Systeeminformatie", "api/info"),
                S("Bestandssystemen", "api/system-info/fs")),
            ["name-servers"] = P("Nameservers", "Serverbeheer",
                "DNS-instellingen zijn beschikbaar via het afzonderlijke DNS-beheer.",
                S("DirectAdmin-configuratie", "api/server-settings/directadmin-conf/active")),
            ["multi-server"] = P("Multi-server", "Serverbeheer",
                "Multi-serverconfiguratie heeft geen afzonderlijk modern Swagger-contract.",
                S("DirectAdmin-configuratie", "api/server-settings/directadmin-conf/active")),
            ["php-settings"] = P("PHP-instellingen", "Serverbeheer",
                "PHP-versies, opties en beschikbare software uit CustomBuild.",
                S("CustomBuild-opties", "api/custombuild/options-v2"),
                S("Software", "api/custombuild/software"),
                S("Versies", "api/custombuild/versions")),
            ["custombuild"] = P("CustomBuild", "Serverbeheer",
                "Configuratie, versies, updates en uitvoeringsstatus.",
                S("Opties", "api/custombuild/options-v2"),
                S("Updates", "api/custombuild/updates"),
                S("Software", "api/custombuild/software"),
                S("Versies", "api/custombuild/versions"),
                S("Status", "api/custombuild/state"),
