@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/sessions"
@inject DirectAdminSession Session
<PageTitle>@L["Sessions — HostingPanel"]</PageTitle>
<div class="page-header"><div><div class="eyebrow">@L["Account management"]</div><h1>@L["Sessions"]</h1><p>@L["Current session, active sessions and session management from DirectAdmin."]</p></div><button disabled="@busy" @onclick="Load">@L["Refresh"]</button></div>
@if (!Session.Connected) { <section class="card">Verbind eerst via het <a href="/">dashboard</a>.</section> }
else
{
    <section class="card"><h2>@L["Current session"]</h2><JsonOverview Json="@current" /></section>
    <section class="card"><h2>@L["Active sessions"]</h2><JsonOverview Json="@all" /></section>
    <section class="card">
        <h2>@L["Terminate other sessions"]</h2>
        <p>@L["The backend determines which sessions may be terminated. This operation preserves the current session."]</p>
        <label>@L["Enter DESTROY to confirm"]</label><input @bind="confirmation" />
        <button class="primary" disabled="@(busy || confirmation != "DESTROY")" @onclick="DestroyOthers">@L["Terminate all other sessions"]</button>
        @if (feedback is not null) { <p role="status">@feedback</p> }
    </section>
    <section class="card">
        <h2>@L["Terminate one session"]</h2>
        <label>Public session ID</label><input @bind="publicId" />
        <label>@L["Enter the same ID to confirm"]</label><input @bind="sessionConfirmation" />
        <button disabled="@(busy || string.IsNullOrWhiteSpace(publicId) || sessionConfirmation != publicId)" @onclick="DestroySession">@L["Terminate session"]</button>
    </section>
    @if (busy) { <p role="status">@L["Processing…"]</p> }
}
@code {
    private string current = "", all = "", confirmation = "", publicId = "", sessionConfirmation = "";
    private string? feedback;
    private bool busy;
    protected override async Task OnInitializedAsync() { if (Session.Connected) await Load(); }
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true;
        try
        {
            var (cs, cb) = await Session.GetRawAsync("api/session");
            current = $"HTTP {cs}\n{cb}";
            var (ls, lb) = await Session.GetRawAsync("api/sessions");
            all = $"HTTP {ls}\n{lb}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { feedback = ex.Message; }
        finally { busy = false; }
    }
    private async Task DestroySession()
    {
        if (busy || !Session.Connected || string.IsNullOrWhiteSpace(publicId)
            || publicId.Length > 128 || publicId.Any(c => !(char.IsAsciiLetterOrDigit(c) || c is '-' or '_'))
            || sessionConfirmation != publicId) return;
        busy = true; feedback = null;
        try
        {
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Post,
                "api/sessions/destroy/" + Uri.EscapeDataString(publicId));
            feedback = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { feedback = ex.Message; }
        finally { busy = false; publicId = ""; sessionConfirmation = ""; }
        await Load();
    }
    private async Task DestroyOthers()
    {
        if (busy || confirmation != "DESTROY") return;
        busy = true; feedback = null;
        try
        {
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Post, "api/sessions/destroy-all-other");
            feedback = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { feedback = ex.Message; }
        finally { busy = false; confirmation = ""; }
        if (feedback is not null) await Load();
    }
}
