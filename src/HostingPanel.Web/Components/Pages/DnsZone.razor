@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/domains/{Domain}/dns"
@using System.Text.Json
@inject DirectAdminSession Session
@inject IDialogService Dialogs

<PageTitle>DNS — @Domain</PageTitle>
<div class="page-header">
    <div>
        <div class="eyebrow"><a href="/domains">@L["Domains"]</a> / <a href="@($"/domains/{Uri.EscapeDataString(Domain)}")">@Domain</a> / DNS</div>
        <h1>@L["DNS management"]</h1>
        <p>Zone: <strong>@Domain</strong> — rechtstreeks uit DirectAdmin.</p>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Load" Disabled="@busy">@L["Refresh"]</MudButton>
</div>
@if (!Session.Connected)
{
    <div class="card">Verbind eerst via het <a href="/">dashboard</a>.</div>
}
else
{
    <section class="card">
        <h2>DNS-records</h2>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        @if (busy) { <p role="status">@L["Loading DNS zone…"]</p> }
        @if (records is not null)
        {
            <p>@records.Count records gevonden.</p>
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead><tr><th>Type</th><th>@L["Name"]</th><th>@L["Value"]</th><th>TTL</th><th>@L["Management"]</th></tr></thead>
                <tbody>
                @foreach (var record in records)
                {
                    <tr>
                        <td>@record.Type</td><td>@record.Name</td><td>@record.Value</td><td>@record.Ttl</td>
                        <td>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="() => Edit(record)">@L["Edit"]</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@busy" OnClick="() => Remove(record)">@L["Delete"]</MudButton>
                        </td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        }
    </section>
    <section class="card">
        <h2>@(action == "add" ? L["Add DNS record"].Value : L["Edit DNS record"].Value)</h2>
        <p>@L["DirectAdmin determines whether the change is permitted."]</p>
        <label for="dnsType">Type</label>
        <MudSelect T="string" @bind-Value="type" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="dnsType" Disabled="@(action == "delete")">
            @foreach (var item in new [] {"A","AAAA","CNAME","MX","TXT","SRV","CAA","NS","PTR","DS","TLSA"})
            { <MudSelectItem T="string" Value='@item'>@item</MudSelectItem> }
        </MudSelect>
        <label for="dnsName">@L["Name"]</label>
        <MudTextField T="string" @bind-Value="name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dnsName" Placeholder="www" Disabled="@(action == "delete")" />
        <label for="dnsValue">@L["Value"]</label>
        <MudTextField T="string" @bind-Value="value" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dnsValue" Disabled="@(action == "delete")" Lines="3" />
        <label for="dnsTtl">@L["TTL (optional, 60–604800 seconds)"]</label>
        <MudTextField T="string" @bind-Value="ttl" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dnsTtl" Disabled="@(action == "delete")" />
        <div class="domain-options">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || deleteDialogOpen || action == "delete")" OnClick="Save">
                @(busy ? "Bezig…" : action == "add" ? "Toevoegen" : L["Save change"].Value)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Reset">@L["New record"]</MudButton>
        </div>
        @if (message is not null) { <p role="status">@message</p> }
    </section>
}
@code {
    [Parameter] public string Domain { get; set; } = "";
    private sealed record ZoneRecord(string Type, string Name, string Value, string? Ttl);
    private List<ZoneRecord>? records;
    private string? error, message;
    private string action = "add", type = "A", name = "", value = "", ttl = "", confirmation = "";
    private ZoneRecord? original;
    private bool busy;
    protected override async Task OnParametersSetAsync()
    {
        if (Session.Connected) await Load();
    }
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true;
        error = null;
        try
        {
            var (status, body) = await Session.GetDnsZoneAsync(Domain);
            if (status != 200)
            {
                error = L["DNS zone unavailable: HTTP {0}.", status].Value;
                try
                {
                    using var failure = JsonDocument.Parse(body);
                    if (failure.RootElement.ValueKind == JsonValueKind.Object &&
                        failure.RootElement.TryGetProperty("type", out var code) &&
                        code.ValueKind == JsonValueKind.String)
                    {
                        var reason = code.GetString();
                        if (!string.IsNullOrWhiteSpace(reason) &&
                            reason.Length <= 80 && reason.All(c => char.IsAsciiLetterOrDigit(c) || c == '_'))
                            error += $" ({reason})";
                    }
                }
                catch (JsonException) { }
                records = null;
                return;
            }
            using var doc = JsonDocument.Parse(body);
            var array = doc.RootElement.GetProperty("records");
            records = array.EnumerateArray().Select(x => new ZoneRecord(
                x.GetProperty("type").GetString() ?? "",
                x.GetProperty("name").GetString() ?? "",
                x.GetProperty("value").GetString() ?? "",
                x.TryGetProperty("ttl", out var t) && t.ValueKind != JsonValueKind.Null ? t.ToString() : null)).ToList();
        }
        catch (Exception e) when (e is HttpRequestException or JsonException or InvalidOperationException or ArgumentException)
        { error = e.Message; }
        finally { busy = false; }
    }
    private void Edit(ZoneRecord r)
    {
        original = r; action = "edit"; type = r.Type; name = r.Name; value = r.Value;
        ttl = r.Ttl ?? ""; confirmation = ""; message = null;
    }
    private bool deleteDialogOpen;
    private async Task Remove(ZoneRecord r)
    {
        if (busy || deleteDialogOpen || !Session.Connected || records?.Contains(r) != true) return;
        var domain = Domain;
        var identity = Session.Username;
        deleteDialogOpen = true;
        try
        {
            var confirmed = await Dialogs.ConfirmResourceDeletionAsync(
                $"{L["Delete DNS record"]}: {r.Name}", r.Name,
                L["Permanently delete this DNS record?"].Value,
                L["Exact record name"].Value,
                $"{domain} — {r.Type} {r.Name} {r.Value}");
            if (!confirmed || busy || !Session.Connected ||
                !string.Equals(identity, Session.Username, StringComparison.Ordinal) ||
                !string.Equals(domain, Domain, StringComparison.Ordinal) ||
                records?.Contains(r) != true) return;
            original = r; action = "delete"; type = r.Type; name = r.Name;
            value = r.Value; ttl = r.Ttl ?? ""; confirmation = r.Name;
            try { await Save(); }
            finally
            {
                confirmation = "";
                if (action == "delete") { action = "edit"; }
            }
        }
        finally { deleteDialogOpen = false; }
    }
    private void Reset()
    {
        original = null; action = "add"; type = "A"; name = ""; value = "";
        ttl = ""; confirmation = ""; message = null;
    }
    private async Task Save()
    {
        if (busy || !Session.Connected || (action == "delete" && (original is null || confirmation != original.Name))) return;
        busy = true;
        message = null;
        try
        {
            var (status, body) = await Session.ChangeDnsRecordAsync(Domain, action,
                type, name, value, string.IsNullOrWhiteSpace(ttl) ? null : ttl,
                original?.Type, original?.Name, original?.Value);
            message = status switch {
                200 => L["DirectAdmin confirmed the DNS change."].Value,
                409 => L["DirectAdmin reported a conflict for this DNS change."].Value,
                400 => L["Invalid DNS record data."].Value,
                403 => L["Permission to modify the DNS zone denied."].Value,
                _ => L["DNS change not confirmed (HTTP {0}).", status].Value
            };
            if (status == 200)
            {
                Reset();
                message = L["DirectAdmin confirmed the DNS change."].Value;
            }
        }
        catch (Exception e) when (e is HttpRequestException or JsonException or InvalidOperationException or ArgumentException)
        { message = e.Message; }
        finally { busy = false; }
        if (message?.StartsWith(L["DirectAdmin confirmed the DNS change"].Value, StringComparison.Ordinal) == true)
            await Load();
    }
}
