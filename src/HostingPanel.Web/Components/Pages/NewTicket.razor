@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/tickets/new"
@using System.Text.Json
@inject DirectAdminSession Session
@inject NavigationManager Navigation
<PageTitle>@L["Create ticket — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb><a href="/tickets">Tickets</a> / @L["New ticket"]</Breadcrumb>
    <TitleContent>@L["Create ticket"]</TitleContent>
    <Description>@L["Send a new request to the DirectAdmin backend."]</Description>
</PanelPageHeader>
@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <MudForm @ref="form">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6"><label for="ticketRecipient">@L["Recipient"]</label>
                <MudTextField T="string" @bind-Value="recipient" Required="true" RequiredError="@L["Recipient"].Value" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="ticketRecipient" Placeholder="creator" />
                <p>@L["Use creator or a username accepted by DirectAdmin."]</p>
            </MudItem>
            <MudItem xs="12" sm="6"><label for="ticketPriority">@L["Priority"]</label>
                <MudSelect T="string" @bind-Value="priority" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="ticketPriority">
                    <MudSelectItem T="string" Value='@("10")'>@L["Low"]</MudSelectItem><MudSelectItem T="string" Value='@("20")'>@L["Normal"]</MudSelectItem><MudSelectItem T="string" Value='@("30")'>@L["High"]</MudSelectItem>
                </MudSelect></MudItem>
        </MudGrid>
        <label for="ticketSubject">@L["Subject"]</label>
        <MudTextField T="string" @bind-Value="subject" Required="true" RequiredError="@L["Subject"].Value" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="ticketSubject" Placeholder="@L["Briefly describe the request"].Value" MaxLength="200" />
        <label for="ticketBody">@L["Message"]</label>
        <MudTextField T="string" @bind-Value="body" Required="true" RequiredError="@L["Message"].Value" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="ticketBody" Placeholder="@L["Write the message…"].Value" Lines="10" MaxLength="65536" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(sending || string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(body) || string.IsNullOrWhiteSpace(recipient))" OnClick="Send">@(sending ? L["Sending…"].Value : L["Send ticket"].Value)</MudButton>
            <a href="/tickets">@L["Cancel"]</a>
        </MudStack>
        @if (feedback is not null) { <p role="status">@feedback</p> }
        </MudForm>
    </MudPaper>
}
@code {
    private MudForm form = default!;
    private string recipient = "creator", subject = "", body = "", priority = "20";
    private string? feedback;
    private bool sending;
    private async Task Send()
    {
        if (sending || !Session.Connected || string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(body) || string.IsNullOrWhiteSpace(recipient)) return;
        await form.ValidateAsync();
        if (!form.IsValid || sending || !Session.Connected || string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(body) || string.IsNullOrWhiteSpace(recipient)) return;
        sending = true; feedback = null;
        try
        {
            var payload = JsonSerializer.Serialize(new {
                subject, message = body, recipient, priority = int.Parse(priority)
            });
            var (status, result) = await Session.RequestApiAsync(HttpMethod.Post, "hosting/tickets", payload);
            if (status is >= 200 and < 300)
            {
                Navigation.NavigateTo("/tickets");
                return;
            }
            feedback = L["Ticket not confirmed by DirectAdmin (HTTP {0}): {1}", status, result].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException or ArgumentException)
        { feedback = ex.Message; }
        finally { sending = false; }
    }
}
