@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/"
@inject PanelSession Session
@inject NavigationContextState NavContext
@implements IDisposable

<PageTitle>@L["Dashboard"] — HostingPanel</PageTitle>
<div class="workspace-home">
    <header class="workspace-welcome">
        <div>
            <p class="workspace-eyebrow">@L["Dashboard"]</p>
            <h1>@L["Welcome to HostingPanel"]</h1>
            <p>@Session.Username</p>
        </div>
        @if (Session.Connected)
        {
            <span class="workspace-status"><span aria-hidden="true"></span>@L["Connected"]</span>
        }
    </header>
    <div class="workspace-feature">
        <div>
            <h2>@L["Domain management"]</h2>
            <p>@L["Manage domains, users, DNS, databases and server services from one dashboard."]</p>
            <MudButton Href="/domains" Variant="Variant.Filled" Color="Color.Primary">@L["Domains"]</MudButton>
        </div>
        <div class="workspace-art" aria-hidden="true"><div></div><div></div><div></div></div>
    </div>
    <div class="workspace-sections">
    @if (NavContext.Mode == "user")
    {
        <section class="workspace-section">
            <h2>@L["My hosting"]</h2>
            <a class="workspace-link" href="/dns-zones"><span>@L["DNS management"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/databases"><span>@L["Databases"]</span><span aria-hidden="true">→</span></a>
        </section>
        <section class="workspace-section">
            <h2>@L["Support and messages"]</h2>
            <a class="workspace-link" href="/tickets"><span>@L["My tickets"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/tickets/new"><span>@L["Create ticket"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/messages"><span>@L["Messages"]</span><span aria-hidden="true">→</span></a>
        </section>
        <section class="workspace-section">
            <h2>@L["Account"]</h2>
            <a class="workspace-link" href="/change-password"><span>@L["Change password"]</span><span aria-hidden="true">→</span></a>
        </section>
    }
    else
    {
        <section class="workspace-section">
            <h2>@L["Account management"]</h2>
            <a class="workspace-link" href="/users"><span>@L["All users"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/resellers"><span>@L["Resellers"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/change-password"><span>@L["Change password"]</span><span aria-hidden="true">→</span></a>
        </section>
        <section class="workspace-section">
            <h2>@L["Website and resource management"]</h2>
            <a class="workspace-link" href="/dns-zones"><span>@L["DNS management"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/databases"><span>@L["Databases"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/server-tls"><span>@L["Server TLS"]</span><span aria-hidden="true">→</span></a>
        </section>
        <section class="workspace-section">
            <h2>@L["Server management"]</h2>
            <a class="workspace-link" href="/server-settings"><span>@L["Settings"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/system-services"><span>@L["System services"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/system-info"><span>@L["System information"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/system-updates"><span>@L["Updates"]</span><span aria-hidden="true">→</span></a>
        </section>
        <section class="workspace-section">
            <h2>@L["Admin tools"]</h2>
            <a class="workspace-link" href="/security"><span>@L["ModSecurity and ClamAV"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/sessions"><span>@L["Sessions"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/api-browser"><span>@L["DirectAdmin API"]</span><span aria-hidden="true">→</span></a>
            <a class="workspace-link" href="/navigation/backup-restore"><span>@L["Backup and restore"]</span><span aria-hidden="true">→</span></a>
        </section>
    }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        NavContext.Changed += OnChanged;
        Session.Changed += OnChanged;
    }
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        NavContext.Changed -= OnChanged;
        Session.Changed -= OnChanged;
    }
}
