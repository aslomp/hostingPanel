@page "/"
@inject DirectAdminSession Session

<PageTitle>Controle Paneel — HostingPanel</PageTitle>
<div class="page-header">
  <div>
    <div class="eyebrow">Hosting administratiesysteem / Dashboard</div>
    <h1>Controle Paneel</h1>
    <p>Beheer domeinen, gebruikers, DNS, databases en serverdiensten vanuit één overzicht.</p>
  </div>
  @if (Session.Connected)
  {
    <span class="status-pill good">● Verbonden</span>
  }
</div>

<div class="banner">
  <h2>Welkom bij HostingPanel</h2>
  <p>DirectAdmin Evolution-geïnspireerd beheer, met live gegevens uit de aangesloten backend.</p>
</div>

@if (!Session.Connected)
{
  <div class="dashboard-layout">
    <section class="card">
      <h2>DirectAdmin-verbinding</h2>
      <p>Maak verbinding met jouw DirectAdmin-server. De opgegeven gegevens blijven binnen de interactieve Blazor-sessie.</p>
      <form @onsubmit="Connect" @onsubmit:preventDefault>
        <div class="form-grid">
          <div><label for="daUser">Gebruikersnaam</label>
            <input id="daUser" @bind="username" autocomplete="username" required /></div>
          <div><label for="daKey">Wachtwoord of login key</label>
            <input id="daKey" type="password" @bind="key" autocomplete="off" required /></div>
        </div>
        <div class="form-actions">
          <button type="submit" class="primary" disabled="@connecting">
            @(connecting ? "Verbinding controleren…" : "Verbinden")
          </button>
        </div>
      </form>
      @if (error is not null) { <p class="error" role="alert">@error</p> }
    </section>
    <aside class="dashboard-aside">
      <section class="card">
        <h2>Over het controlepaneel</h2>
        <p>HostingPanel gebruikt dezelfde beheergroepen als de DirectAdmin Evolution-interface. De rechten en beschikbare resources komen volledig van de backend.</p>
        <p>De navigatie blijft voor iedere identiteit gelijk; beschikbare backendoperaties bepalen het resultaat.</p>
      </section>
    </aside>
  </div>
}
else
{
  <div class="dashboard-layout">
    <div>
      <section class="card">
        <div class="dashboard-section-heading"><h2>Accountbeheer</h2><small>Gebruikers en pakketten</small></div>
        <div class="dashboard-links">
          <a href="/users"><span class="glyph">♙</span>Alle gebruikers</a>
          <a href="/resellers"><span class="glyph">♙</span>Resellers</a>
          <a href="/change-password"><span class="glyph">⚿</span>Wachtwoorden</a>
          <a href="/domains"><span class="glyph">◎</span>Domeinen</a>
        </div>
      </section>
      <section class="card">
        <div class="dashboard-section-heading"><h2>Website- en resourcebeheer</h2><small>Live resources</small></div>
        <div class="dashboard-links">
          <a href="/domains"><span class="glyph">◎</span>Domeinbeheer</a>
          <a href="/dns-zones"><span class="glyph">◇</span>DNS Beheer</a>
          <a href="/databases"><span class="glyph">▦</span>Databases</a>
          <a href="/server-tls"><span class="glyph">♢</span>Server TLS</a>
        </div>
      </section>
      <section class="card">
        <div class="dashboard-section-heading"><h2>Server Beheer</h2><small>Instellingen en services</small></div>
        <div class="dashboard-links">
          <a href="/server-settings"><span class="glyph">⚙</span>Instellingen</a>
          <a href="/system-services"><span class="glyph">▣</span>Systeem Services</a>
          <a href="/system-info"><span class="glyph">◴</span>Systeeminformatie</a>
          <a href="/system-updates"><span class="glyph">↻</span>Updates</a>
        </div>
      </section>
      <section class="card">
        <div class="dashboard-section-heading"><h2>Admin Gereedschap</h2><small>Beveiliging en API</small></div>
        <div class="dashboard-links">
          <a href="/security"><span class="glyph">♢</span>ModSecurity en ClamAV</a>
          <a href="/sessions"><span class="glyph">◷</span>Sessies</a>
          <a href="/api-browser"><span class="glyph">⌘</span>DirectAdmin API</a>
          <a href="/navigation/backup-restore"><span class="glyph">▣</span>Back-up en herstel</a>
        </div>
      </section>
    </div>
    <aside class="dashboard-aside">
      <section class="card">
        <div class="dashboard-section-heading"><h2>Verbonden account</h2></div>
        <div class="state-row"><span class="state-dot connected"></span><span>DirectAdmin-verbinding actief</span></div>
        <h3>@Session.Username</h3>
        <p>De backend bepaalt de beschikbare gegevens en acties. Er worden geen accountrollen aangenomen.</p>
        <div class="form-actions"><button @onclick="Disconnect">Verbinding verbreken</button></div>
      </section>
      <section class="card">
        <div class="dashboard-section-heading"><h2>Snelle toegang</h2></div>
        <a class="dashboard-link-row" href="/databases"><span class="glyph">▦</span>Databasebeheer</a>
        <a class="dashboard-link-row" href="/dns-zones"><span class="glyph">◎</span>DNS beheren</a>
        <a class="dashboard-link-row" href="/system-services"><span class="glyph">⚙</span>Services bekijken</a>
        <a class="dashboard-link-row" href="/resellers"><span class="glyph">♙</span>Accounts beheren</a>
      </section>
      <section class="card">
        <div class="dashboard-section-heading"><h2>Integratie</h2></div>
        <p>Alle getoonde resources zijn verbonden met de bestaande HostingPanel API. Niet-geïmplementeerde onderdelen in de navigatie zijn expliciet gemarkeerd.</p>
        <a href="/api-browser">API-documentatie en responses bekijken</a>
      </section>
    </aside>
  </div>
}

@code {
    private string username = "";
    private string key = "";
    private string? error;
    private bool connecting;

    private async Task Connect()
    {
        if (connecting) return;
        connecting = true;
        error = null;
        try
        {
            Session.SetCredentials(username, key);
            // Authenticate using the session endpoint, not permission to list users.
            var (status, _) = await Session.GetRawAsync("api/session");
            if (status is 401 or 403)
                throw new UnauthorizedAccessException("DirectAdmin heeft de aanmelding geweigerd.");
            if (status is < 200 or >= 300)
                throw new HttpRequestException($"DirectAdmin sessiecontrole: HTTP {status}.");
            key = "";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or UnauthorizedAccessException or FormatException or ArgumentException)
        {
            Session.Disconnect();
            error = ex.Message;
        }
        finally { connecting = false; }
    }
    private void Disconnect() { Session.Disconnect(); key = ""; }
}
