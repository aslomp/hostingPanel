@page "/backend-settings"
@using System.Text.Json
@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using System.Text.Json.Nodes
@inject DirectAdminSession Session

<PageTitle>@L[NameserversOnly ? "Name servers" : IpOnly ? "IP management" : "Backend settings"] — HostingPanel</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management"]</Breadcrumb>
    <TitleContent>@L[NameserversOnly ? "Name servers" : IpOnly ? "IP management" : "Backend settings"]</TitleContent>
    <Description>@L[NameserversOnly ? "Default nameservers assigned to new users." : IpOnly ? "Manage hosting IP addresses." : "Configuration contract of the active backend."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy || !Session.Connected)" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
    <section class="card"><a href="/">@L["Connect first via the dashboard."]</a></section>
}
else
{
    @if (message is not null) { <p role="status">@message</p> }
    @if (view is not null)
    {
        <section class="card">
            @if (IpOnly && view.Fields.Any(f => f.Name == "IpAddresses"))
            {
                <div class="form-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddIp" Disabled="@busy">+ @L["Add IP"]</MudButton></div>
                <h2>@L["IP addresses"]</h2>
                <div class="form-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick='() => SetSelectedStatus("shared")'>@L["Share"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick='() => SetSelectedStatus("available")'>@L["Available"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="ClearSelectedNs">@L["Clear NS"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="ToggleGlobal">@L["Toggle global"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@busy" OnClick="DeleteSelected">@L["Delete"]</MudButton>
                </div>
                <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true">
                    <thead><tr><th></th><th>IP</th><th>@L["Status"]</th><th>@L["Device"]</th><th>@L["Resellers"]</th><th>@L["Users"]</th><th>@L["Global"]</th><th>@L["Name server"]</th><th>@L["Netmask"]</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var ip in addresses)
                    {
                        <tr><td><MudCheckBox T="bool" @bind-Value="ip.Selected" /></td><td><MudTextField T="string" @bind-Value="ip.Address" Margin="Margin.Dense" Immediate="true" /></td>
                        <td><MudSelect T="string" @bind-Value="ip.Status" Margin="Margin.Dense"><MudSelectItem T="string" Value='@("server")'>server</MudSelectItem><MudSelectItem T="string" Value='@("shared")'>shared</MudSelectItem><MudSelectItem T="string" Value='@("available")'>available</MudSelectItem><MudSelectItem T="string" Value='@("owned")'>dedicated</MudSelectItem></MudSelect></td>
                        <td><MudTextField T="string" @bind-Value="ip.Device" Margin="Margin.Dense" Immediate="true" /></td>
                        <td>@foreach (var reseller in inventory?.Resellers ?? [])
                        { <MudCheckBox T="bool" Value="@ip.Resellers.Contains(reseller)" ValueChanged="@(v => Assign(ip, reseller, v))" Label="@reseller" /> }</td>
                        <td>@(inventory?.Users.GetValueOrDefault(ip.Address) ?? 0)
                        @foreach (var user in inventory?.AccountNames ?? [])
                        { <MudCheckBox T="bool" Value="@ip.AssignedUsers.Contains(user)" ValueChanged="@(v => AssignUser(ip, user, v))" Label="@user" /> }
                        </td>
                        <td><MudCheckBox T="bool" @bind-Value="ip.Global" /></td><td><MudTextField T="string" @bind-Value="ip.NameServer" Margin="Margin.Dense" Immediate="true" /></td>
                        <td><MudNumericField T="int" Min="0" Max="128" @bind-Value="ip.PrefixLength" Margin="Margin.Dense" /></td>
                        <td><MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@busy" OnClick="() => RemoveIp(ip)">@L["Delete"]</MudButton></td></tr>
                    }
                    </tbody>
                </MudSimpleTable>
                <h2>@L["Devices"]</h2>
                @if (inventory?.Warning is { } warning) { <p>@warning</p> }
                <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><thead><tr><th>IP</th><th>@L["Device"]</th><th></th></tr></thead><tbody>
                @foreach (var device in inventory?.Devices ?? [])
                { <tr><td>@device.Address</td><td>@device.Device</td><td><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy || addresses.Any(x => x.Address == device.Address))" OnClick="() => ImportDevice(device)">@L["Add IP"]</MudButton></td></tr> }
                </tbody></MudSimpleTable>
                <p>@L["Select the default public web IP for new domains."]</p>
                <MudSelect T="string" @bind-Value="draftWebIp" Margin="Margin.Dense"><MudSelectItem T="string" Value='@("")'>@L["Not set"]</MudSelectItem>
                    @foreach (var ip in addresses.Where(x => x.Status is "server" or "shared"))
                    { <MudSelectItem T="string" Value='@ip.Address'>@ip.Address</MudSelectItem> }
                </MudSelect>
                <div class="form-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">@L["Save settings"]</MudButton></div>
            }
            @if (NameserversOnly && view.Fields.Any(f => f.Name == "IpAddresses"))
            {
                <div class="form-actions"><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="() => editingNs = !editingNs">+ @L["Create nameservers"]</MudButton></div>
                @if (editingNs)
                {
                    <MudSelect T="string" @bind-Value="nsAddress" Margin="Margin.Dense"><MudSelectItem T="string" Value='@("")'>@L["Select IP"]</MudSelectItem>@foreach (var ip in addresses) { <MudSelectItem T="string" Value='@ip.Address'>@ip.Address</MudSelectItem> }</MudSelect>
                    <MudTextField T="string" @bind-Value="nsName" Placeholder="ns1.example.com" Margin="Margin.Dense" Immediate="true" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="SetNs">@L["Assign"]</MudButton>
                }
                <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><thead><tr><th>IP</th><th>@L["Status"]</th><th>@L["Users"]</th><th>@L["Name server"]</th><th></th></tr></thead>
                <tbody>@foreach (var ip in addresses.Where(x => x.NameServer.Length > 0))
                { <tr><td>@ip.Address</td><td>@ip.Status</td><td>@(inventory?.Users.GetValueOrDefault(ip.Address) ?? 0)</td><td>@ip.NameServer</td><td><MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@busy" OnClick="() => ip.NameServer = string.Empty">@L["Delete"]</MudButton></td></tr> }</tbody></MudSimpleTable>
                <h2>@L["Default nameservers assigned to new users"]</h2>
            }
            @if (!VisibleFields.Any() && !IpOnly)
            {
                <p>@L["This backend has no public settings."]</p>
            }
            else if (VisibleFields.Any())
            {
                <div class="form-grid">
                    @foreach (var field in VisibleFields)
                    {
                        var id = "setting-" + field.Name;
                        <div @key="field.Name">
                            <label for="@id">@field.Label</label>
                            @if (field.Description is not null) { <p>@field.Description</p> }
                            @if (field.Type == "enum")
                            {
                                <MudSelect T="string" InputId="@id" Value="@draft[field.Name]" ValueChanged="@(v => Set(field.Name, v))" Disabled="@busy" Margin="Margin.Dense">
                                    @if (field.Nullable) { <MudSelectItem T="string" Value='@("")'>@L["Not set"]</MudSelectItem> }
                                    @foreach (var option in field.Options)
                                    {
                                        <MudSelectItem T="string" Value='@option.Value'>@option.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (field.Type == "boolean" && !field.Nullable)
                            {
                                <MudCheckBox T="bool" Value='@(draft[field.Name] == "true")' ValueChanged='@(v => Set(field.Name, v ? "true" : "false"))' Disabled="@busy" />
                            }
                            else if (field.Type == "boolean")
                            {
                                <MudSelect T="string" InputId="@id" Value="@draft[field.Name]" ValueChanged="@(v => Set(field.Name, v))" Disabled="@busy" Margin="Margin.Dense">
                                    <MudSelectItem T="string" Value='@("")'>@L["Not set"]</MudSelectItem><MudSelectItem T="string" Value='@("true")'>@L["Yes"]</MudSelectItem><MudSelectItem T="string" Value='@("false")'>@L["No"]</MudSelectItem>
                                </MudSelect>
                            }
                            else if (field.Type == "json")
                            {
                                <MudTextField T="string" InputId="@id" Lines="4" Value="@draft[field.Name]" ValueChanged="@(v => Set(field.Name, v))" Disabled="@busy" Immediate="true" />
                            }
                            else
                            {
                                <MudTextField T="string" InputId="@id" Value="@draft[field.Name]" ValueChanged="@(v => Set(field.Name, v))" Disabled="@busy" Immediate="true" />
                            }
                            @if (field.Nullable && field.Type == "string")
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="() => Set(field.Name, null)">@L["Not set"]</MudButton>
                            }
                            @if (errors.TryGetValue(field.Name, out var fieldErrors))
                            {
                                @foreach (var error in fieldErrors) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
                            }
                        </div>
                    }
                </div>
                <div class="form-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">@L["Save settings"]</MudButton></div>
            }
        </section>
    }
}

@code {
    [Parameter] public bool IpOnly { get; set; }
    [Parameter] public bool NameserversOnly { get; set; }
    private IEnumerable<SettingField> VisibleFields => (view?.Fields ?? []).Where(f =>
        NameserversOnly ? f.Name is "DnsNs1" or "DnsNs2" :
        IpOnly ? false : f.Name is not ("DnsWebIp" or "DnsNs1" or "DnsNs2" or "IpAddresses"));
    private sealed class IpRow
    {
        public string Address { get; set; } = "";
        public int PrefixLength { get; set; } = 32;
        public string Status { get; set; } = "shared";
        public string Device { get; set; } = "";
        public string NameServer { get; set; } = "";
        public bool Global { get; set; }
        public string[] Resellers { get; set; } = [];
        public string[] AssignedUsers { get; set; } = [];
        [System.Text.Json.Serialization.JsonIgnore] public bool Selected { get; set; }
    }
    private sealed record DeviceRow(string Address, string Device, int PrefixLength);
    private sealed record NetworkInventory(Dictionary<string,int> Users, string[] Resellers, DeviceRow[] Devices, string? Warning, string[] AccountNames);
    private NetworkInventory? inventory;
    private bool editingNs;
    private string nsAddress = "", nsName = "";
    private void SetNs() { var ip = addresses.FirstOrDefault(x => x.Address == nsAddress); if (ip is not null) { ip.NameServer = nsName.Trim(); editingNs = false; } }
    private void Assign(IpRow ip, string reseller, bool selected) => ip.Resellers = selected ? ip.Resellers.Append(reseller).Distinct().ToArray() : ip.Resellers.Where(x => x != reseller).ToArray();
    private void AssignUser(IpRow ip, string user, bool selected) => ip.AssignedUsers = selected ? (ip.Status == "owned" ? new[] { user } : ip.AssignedUsers.Append(user).Distinct().ToArray()) : ip.AssignedUsers.Where(x => x != user).ToArray();
    private void SetSelectedStatus(string status) { foreach (var ip in addresses.Where(x => x.Selected)) ip.Status = status; }
    private void ClearSelectedNs() { foreach (var ip in addresses.Where(x => x.Selected)) ip.NameServer = ""; }
    private void ToggleGlobal() { foreach (var ip in addresses.Where(x => x.Selected)) ip.Global = !ip.Global; }
    private void DeleteSelected() { foreach (var ip in addresses.Where(x => x.Selected).ToArray()) RemoveIp(ip); }
    private void ImportDevice(DeviceRow device) => addresses.Add(new() { Address = device.Address, Device = device.Device, PrefixLength = device.PrefixLength, Status = "server" });
    private List<IpRow> addresses = [];
    private string draftWebIp = "";
    private void AddIp() => addresses.Add(new());
    private void RemoveIp(IpRow ip) { addresses.Remove(ip); if (draftWebIp == ip.Address) draftWebIp = ""; }
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private SettingsView? view;
    private readonly Dictionary<string, string?> draft = new(StringComparer.Ordinal);
    private Dictionary<string, string[]> errors = new();
    private string? message;
    private bool busy;

    protected override Task OnInitializedAsync() => Load();
    private void Set(string key, string? value) { draft[key] = value; errors.Remove(key); }

    private void Accept(string body)
    {
        var next = JsonSerializer.Deserialize<SettingsView>(body, JsonOptions)
            ?? throw new JsonException("Settings response is empty.");
        draft.Clear();
        foreach (var field in next.Fields)
        {
            var value = next.Values.GetProperty(field.Name);
            draft[field.Name] = value.ValueKind == JsonValueKind.Null ? null :
                value.ValueKind == JsonValueKind.String ? value.GetString() : value.GetRawText();
        }
        view = next;
        if (next.Values.TryGetProperty("IpAddresses", out var ips))
        {
            addresses = ips.Deserialize<List<IpRow>>() ?? [];
            foreach (var ip in addresses) { ip.Resellers ??= []; ip.AssignedUsers ??= []; }
            draftWebIp = draft.GetValueOrDefault("DnsWebIp") ?? "";
            if (draftWebIp.Length > 0 && !addresses.Any(x => x.Address == draftWebIp))
                addresses.Add(new() { Address = draftWebIp, Status = "server", PrefixLength = draftWebIp.Contains(':') ? 128 : 32 });
        }
    }

    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true; view = null; message = null; errors.Clear();
        try
        {
            var (status, body) = await Session.GetBackendSettingsAsync();
            if (status == 200)
            {
                Accept(body);
                if (IpOnly || NameserversOnly)
                {
                    var (networkStatus, networkBody) = await Session.GetNetworkInventoryAsync();
                    inventory = networkStatus == 200 ? JsonSerializer.Deserialize<NetworkInventory>(networkBody, JsonOptions) : null;
                }
            }
            else message = status switch {
                501 => L["This backend does not offer a settings contract."].Value,
                401 or 403 => L["The backend denies access to these settings."].Value,
                _ => L["Backend HTTP {0}.", status].Value
            };
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        { message = ex.Message; }
        finally { busy = false; }
    }

    private async Task Save()
    {
        if (busy || view is null || !Session.Connected) return;
        busy = true; message = null; errors.Clear();
        try
        {
            if ((IpOnly || NameserversOnly) && draft.ContainsKey("IpAddresses"))
            {
                draft["IpAddresses"] = JsonSerializer.Serialize(addresses);
                if (IpOnly) draft["DnsWebIp"] = draftWebIp;
            }
            var values = new JsonObject();
            foreach (var field in view.Fields)
            {
                var raw = draft[field.Name];
                try
                {
                    values[field.Name] = raw is null || (field.Nullable && raw == "" && field.Type != "string") ? null :
                        field.Type is "enum" or "string" ? JsonValue.Create(raw) : JsonNode.Parse(raw);
                }
                catch (JsonException) { errors[field.Name] = [L["Invalid value."].Value]; }
            }
            if (errors.Count > 0) return;
            var (status, body) = await Session.SaveBackendSettingsAsync(
                JsonSerializer.Serialize(new { revision = view.Revision, values }, JsonOptions));
            if (status == 200)
            {
                var (readStatus, savedBody) = await Session.GetBackendSettingsAsync();
                if (readStatus != 200) { message = $"Save returned success but readback failed: HTTP {readStatus}."; return; }
                var saved = JsonSerializer.Deserialize<SettingsView>(savedBody, JsonOptions) ?? throw new JsonException("Settings response is empty.");
                var expected = JsonSerializer.Deserialize<SettingsView>(body, JsonOptions) ?? throw new JsonException("Save response is empty.");
                if (saved.Revision != expected.Revision) { message = "Saved settings could not be verified."; return; }
                Accept(savedBody); message = L["Settings saved."].Value;
            }
            else if (status == 409) message = L["Settings conflict."].Value + " " + body;
            else if (status == 400)
            {
                using var problem = JsonDocument.Parse(body);
                if (problem.RootElement.TryGetProperty("errors", out var validation))
                    errors = validation.Deserialize<Dictionary<string, string[]>>(JsonOptions) ?? new();
                message = L["The backend rejected the settings."].Value + " " + string.Join("; ", errors.Select(x => x.Key + ": " + string.Join(", ", x.Value)));
            }
            else message = L["Backend HTTP {0}. Settings not saved.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        { message = ex.Message; }
        finally { busy = false; }
    }

    private sealed record SettingsView(string Backend, string Revision, SettingField[] Fields, JsonElement Values);
    private sealed record SettingField(string Name, string Label, string? Description, string Type, bool Nullable, SettingOption[] Options);
    private sealed record SettingOption(string Value, string Label);
}
