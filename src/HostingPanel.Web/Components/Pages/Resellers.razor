@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/resellers"
@using System.Text.Json
@inject DirectAdminSession Session
@inject IDialogService Dialogs

<PageTitle>@L["Resellers — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Account management"]</Breadcrumb>
    <TitleContent>@L["Reseller management"]</TitleContent>
    <Description>@L["The overview includes accounts exposed by DirectAdmin to the current identity."]</Description>
    <Actions>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <CrudAddButton OnClick="OpenCreateDialog" Disabled="@(!Session.Connected || loading || mutating)">@L["Create reseller"]</CrudAddButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Load" Disabled="@loading">@(loading ? L["Loading…"].Value : L["Refresh"].Value)</MudButton>
        </MudStack>
    </Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-2">@error <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Load">@L["Try again"]</MudButton></MudAlert>
}
else if (loading)
{
    <PanelLoading>@L["Loading account tree…"]</PanelLoading>
}
else if (accounts is not null)
{
    @if (operationMessage is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@operationMessage</MudAlert> }
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <div class="dashboard-section-heading"><h2>@L["All accessible accounts"]</h2><MudChip T="string" Size="Size.Small" Color="Color.Success">@accounts.Count accounts</MudChip></div>
        <label for="userFilter">@L["Search username or owner…"]</label>
        <MudTextField T="string" @bind-Value="search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="userFilter" Placeholder="@L["Search username or owner…"].Value" />
        <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><thead><tr><th>Account</th><th>@L["Role"]</th><th>@L["Created by"]</th><th>@L["Domains"]</th><th>@L["Actions"]</th></tr></thead>
        <tbody>
        @foreach (var item in Visible)
        {
            <tr>
                <td><span style="@($"padding-left:{item.Depth * 18}px")">@(item.Depth > 0 ? "↳ " : "")<a href="@($"/resellers/{Uri.EscapeDataString(item.Account.Username)}")">@item.Account.Username</a></span></td>
                <td><MudChip T="string" Size="Size.Small" Color="Color.Default">@item.Account.Role</MudChip></td>
                <td>@(item.Account.Creator ?? "—")</td>
                <td><a href="@($"/domains?user={Uri.EscapeDataString(item.Account.Username)}")">@L["View domains"]</a></td>
                <td>
                    @if (!item.Account.Role.Equals("admin", StringComparison.OrdinalIgnoreCase) &&
                        !item.Account.Username.Equals(Session.Username, StringComparison.OrdinalIgnoreCase))
                    {
                        <CrudDeleteButton Label="@L["Delete reseller"].Value" Disabled="@mutating" OnClick="@(() => ConfirmDelete(item.Account))" />
                    }
                </td>
            </tr>
        }
        </tbody></MudSimpleTable>
        @if (accounts.Count == 0) { <PanelEmptyState>@L["No accounts returned by DirectAdmin."]</PanelEmptyState> }
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Reseller packages"]</h2>
        <JsonOverview Json="@packages" />
    </MudPaper>
}
@code {
    private sealed record Account(string Username, string Role, string? Creator);
    private sealed record TreeItem(Account Account, int Depth);
    private List<Account>? accounts;
    private string search = "";
    private string? error;
    private bool loading;
    private bool mutating;
    private string? operationMessage;
    private string? packages;

    private IEnumerable<TreeItem> Visible => Ordered().Where(item =>
        item.Account.Role.Equals("reseller", StringComparison.OrdinalIgnoreCase)).Where(item =>
        item.Account.Username.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        (item.Account.Creator?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<TreeItem> Ordered()
    {
        if (accounts is null) yield break;
        var byName = accounts.ToDictionary(x => x.Username, StringComparer.OrdinalIgnoreCase);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var roots = accounts.Where(x => x.Creator is null ||
            !byName.ContainsKey(x.Creator) ||
            x.Creator.Equals(x.Username, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Role == "admin" ? 0 : x.Role == "reseller" ? 1 : 2)
            .ThenBy(x => x.Username, StringComparer.OrdinalIgnoreCase);
        foreach (var root in roots)
            foreach (var item in Descendants(root, 0)) yield return item;
        foreach (var remaining in accounts)
            foreach (var item in Descendants(remaining, 0)) yield return item;

        IEnumerable<TreeItem> Descendants(Account parent, int depth)
        {
            if (!visited.Add(parent.Username)) yield break;
            yield return new(parent, depth);
            foreach (var child in accounts.Where(x => x.Creator is not null &&
                x.Creator.Equals(parent.Username, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Username, StringComparer.OrdinalIgnoreCase))
                foreach (var item in Descendants(child, depth + 1))
                    yield return item;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (mutating || !Session.Connected) return;
        operationMessage = null;
        var dialog = await Dialogs.ShowAsync<UserCreateDialog>(
            L["Create reseller"].Value,
            new DialogParameters<UserCreateDialog> { { x => x.Kind, "reseller" } },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task ConfirmDelete(Account account)
    {
        if (mutating || !Session.Connected) return;
        var kind = account.Role.Equals("reseller", StringComparison.OrdinalIgnoreCase) ? "reseller" : "user";
        if (account.Role.Equals("admin", StringComparison.OrdinalIgnoreCase) ||
            account.Username.Equals(Session.Username, StringComparison.OrdinalIgnoreCase)) return;
        var identity = Session.Username;
        var confirmed = await Dialogs.ConfirmResourceDeletionAsync(
            $"{L["Delete account"]}: {account.Username}", account.Username,
            L["Deleting this account is irreversible. All associated data will be removed."].Value,
            L["Confirm account name"].Value);
        if (!confirmed || !Session.Connected || !string.Equals(identity, Session.Username, StringComparison.Ordinal))
            return;
        mutating = true;
        operationMessage = null;
        try
        {
            var (status, _) = await Session.DeleteHostingAccountAsync(kind, account.Username, account.Username);
            if (status is >= 200 and < 300) await Load();
            else operationMessage = L["Deletion not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            operationMessage = ex.Message;
        }
        finally { mutating = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Session.Connected) await Load();
    }
    private async Task Load()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        try
        {
            var (status, body) = await Session.GetAccessibleAccountsAsync();
            if (status != 200)
                throw new HttpRequestException(L["DirectAdmin responded with HTTP {0}.", status].Value);
            using var json = JsonDocument.Parse(body);
            accounts = json.RootElement.GetProperty("accounts").EnumerateArray()
                .Select(x => new Account(
                    x.GetProperty("username").GetString() ?? "",
                    x.GetProperty("role").GetString() ?? "user",
                    x.TryGetProperty("creator", out var creator) &&
                        creator.ValueKind == JsonValueKind.String ? creator.GetString() : null))
                .ToList();
            var (p, q) = await Session.GetRawAsync("api/reseller-packages");
            packages = $"HTTP {p}\n{q}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
            or UnauthorizedAccessException or FormatException or JsonException)
        {
            error = ex.Message;
            accounts = null;
        }
        finally { loading = false; }
    }
}
