@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/resellers"
@using System.Text.Json
@inject DirectAdminSession Session
<PageTitle>Resellers — HostingPanel</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Account management"]</Breadcrumb>
    <TitleContent>@L["Reseller management"]</TitleContent>
    <Description>@L["Backend-accessible accounts and reseller configuration, without UI role filtering."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected) { <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper> }
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Account overview"]</h2>
        <p>@L["The overview includes accounts exposed by DirectAdmin to the current identity."]</p>
        <JsonOverview Json="@accounts" />
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Reseller details"]</h2>
        <label>@L["Username"]</label><MudTextField T="string" @bind-Value="username" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="reseller" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="LoadDetails">@L["Retrieve configuration and usage"]</MudButton>
        <h3>@L["Configuration"]</h3><JsonOverview Json="@details" /><h3>@L["Usage"]</h3><JsonOverview Json="@usage" />
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Reseller packages"]</h2>
        <JsonOverview Json="@packages" />
    </MudPaper>
    @if (error is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
    <AccountActions Kind="reseller" />
}
@code {
    private string accounts = "", details = "", usage = "", packages = "", username = "";
    private string? error;
    private bool busy;
    protected override async Task OnInitializedAsync() { if (Session.Connected) await Load(); }
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true; error = null;
        try
        {
            var (a, b) = await Session.GetAccessibleResellerAccountsAsync();
            accounts = $"HTTP {a}\n{b}";
            var (p, q) = await Session.GetRawAsync("api/reseller-packages");
            packages = $"HTTP {p}\n{q}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException)
        { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task LoadDetails()
    {
        if (busy || username.Length is < 1 or > 64 ||
            !username.All(c => char.IsAsciiLetterOrDigit(c) || c is '_' or '-'))
        { error = L["Invalid username."].Value; return; }
        busy = true; error = null;
        try
        {
            var path = Uri.EscapeDataString(username);
            var (c, d) = await Session.GetRawAsync($"api/resellers/{path}/config");
            var (u, v) = await Session.GetRawAsync($"api/resellers/{path}/usage");
            details = $"HTTP {c}\n{d}";
            usage = $"HTTP {u}\n{v}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { error = ex.Message; }
        finally { busy = false; }
    }
}
