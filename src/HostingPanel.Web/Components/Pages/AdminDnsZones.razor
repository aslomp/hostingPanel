@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/dns-zones"
@using System.Text.Json
@inject DirectAdminSession Session
@inject IDialogService Dialogs

<PageTitle>@L["DNS management — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management / DNS"]</Breadcrumb>
    <TitleContent>@L["DNS management"]</TitleContent>
    <Description>@L["All DNS zones exposed by the backend through DirectAdmin, including independently managed zones."]</Description>
    <Actions><div class="form-actions">
      <MudButton Href="#dns-create" Variant="Variant.Filled" Color="Color.Primary">@L["＋ Add DNS zone"]</MudButton>
      <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Reload" Disabled="@loading">@(loading ? "Laden…" : L["↻ Refresh"].Value)</MudButton>
    </div></Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">Maak eerst verbinding via het <a href="/">dashboard</a>.</MudPaper>
}
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <div class="dashboard-section-heading">
          <h2>DNS-zones</h2>
          @if (zones is not null) { <MudChip T="string" Size="Size.Small" Color="Color.Success">@zones.Count zones</MudChip> }
        </div>
        <label for="dnsSearch">@L["Search DNS zones"]</label>
        <MudTextField T="string" @bind-Value="search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dnsSearch" Placeholder="@L["Search domain name…"].Value" />
        <div class="domain-options">
            <label for="localData">@L["Local data"]</label>
            <MudSelect T="string" @bind-Value="localDataFilter" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="localData">
                <MudSelectItem T="string" Value='@("all")'>@L["Both"]</MudSelectItem><MudSelectItem T="string" Value='@("yes")'>@L["Enabled"]</MudSelectItem>
                <MudSelectItem T="string" Value='@("no")'>@L["Disabled"]</MudSelectItem>
            </MudSelect>
            <label for="localMail">@L["Local mail"]</label>
            <MudSelect T="string" @bind-Value="localMailFilter" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="localMail">
                <MudSelectItem T="string" Value='@("all")'>@L["Both"]</MudSelectItem><MudSelectItem T="string" Value='@("yes")'>@L["Enabled"]</MudSelectItem>
                <MudSelectItem T="string" Value='@("no")'>@L["Disabled"]</MudSelectItem>
            </MudSelect>
        </div>
        @if (error is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
        @if (loading) { <PanelLoading>@L["Retrieving DNS zones…"]</PanelLoading> }
        @if (zones is not null)
        {
            <p>@Visible.Count DNS-zone(s) gevonden. @(warning is null ? "" : "Inventarisatie mogelijk onvolledig: " + warning)</p>
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead><tr><th>@L["Domain"]</th><th>@L["Owner"]</th><th>@L["Local data"]</th><th>@L["Local mail"]</th></tr></thead>
                <tbody>
                @foreach (var zone in Visible.Skip((currentPage - 1) * PageSize).Take(PageSize))
                {
                    <tr>
                        <td><a href="@($"/domains/{Uri.EscapeDataString(zone.Domain)}/dns")">@zone.Domain</a></td>
                        <td>@(string.IsNullOrWhiteSpace(zone.Owner) ? "—" : zone.Owner)</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@(zone.LocalData is true ? Color.Success : Color.Default)">@Display(zone.LocalData)</MudChip></td>
                        <td><MudChip T="string" Size="Size.Small" Color="@(zone.LocalMail is true ? Color.Success : Color.Default)">@Display(zone.LocalMail)</MudChip></td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
            <div class="domain-options">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(loading || currentPage == 1)" OnClick="Previous">@L["Previous page"]</MudButton>
                <span>Pagina @currentPage</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(loading || currentPage * PageSize >= Visible.Count)" OnClick="Next">@L["Next page"]</MudButton>
            </div>
        }
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1" id="dns-create">
        <h2>@L["Create standalone DNS zone"]</h2>
        <p>@L["Use the documented DirectAdmin DNS admin API. The backend checks permissions."]</p>
        <div class="form-grid">
          <div><label>@L["Domain"]</label><MudTextField T="string" @bind-Value="zoneDomain" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="example.com" /></div>
          <div><label>@L["IPv4 address"]</label><MudTextField T="string" @bind-Value="zoneIp" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="192.0.2.1" /></div>
          <div><label>Nameserver 1</label><MudTextField T="string" @bind-Value="zoneNs1" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="ns1.example.com" /></div>
          <div><label>Nameserver 2</label><MudTextField T="string" @bind-Value="zoneNs2" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="ns2.example.com" /></div>
        </div>
        <div class="form-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(changing || string.IsNullOrWhiteSpace(zoneDomain))" OnClick="CreateZone">@L["Create DNS zone"]</MudButton></div>
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Delete standalone DNS zone"]</h2>
        <p>@L["Delete only the specified DNS zone; this is not the same as deleting a hosting domain."]</p>
        <label>@L["Domain"]</label><MudTextField T="string" @bind-Value="deleteDomain" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(changing || string.IsNullOrWhiteSpace(deleteDomain))" OnClick="ConfirmDeletion">@L["Delete DNS zone"]</MudButton>
    </MudPaper>
    @if (zoneMessage is not null) { <p role="status">@zoneMessage</p> }
}
@code {
    private sealed record Zone(string Domain, string? Owner, bool? LocalData, bool? LocalMail);
    private const int PageSize = 50;
    private List<Zone>? zones;
    private string search = "", localDataFilter = "all", localMailFilter = "all";
    private string? error, warning;
    private int currentPage = 1;
    private bool loading, changing;
    private string zoneDomain = "", zoneIp = "", zoneNs1 = "", zoneNs2 = "";
    private string deleteDomain = "", zoneConfirmation = "";
    private string? zoneMessage;

    private IReadOnlyList<Zone> Visible => (zones ?? [])
        .Where(z => z.Domain.Contains(search, StringComparison.OrdinalIgnoreCase) &&
            Matches(z.LocalData, localDataFilter) && Matches(z.LocalMail, localMailFilter))
        .ToArray();

    private static bool Matches(bool? value, string filter) =>
        filter == "all" || (value is not null && (filter == "yes") == value.Value);

    private string Display(bool? value) =>
        value switch { true => "Ja", false => "Nee", null => L["Unavailable"].Value };

    protected override async Task OnInitializedAsync()
    {
        if (Session.Connected) await Reload();
    }
    private void Previous() { if (currentPage > 1) currentPage--; }
    private void Next() { if (currentPage * PageSize < Visible.Count) currentPage++; }

    private async Task Reload()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        try
        {
            var (status, body) = await Session.GetAccessibleDnsZonesAsync();
            if (status != 200)
            {
                error = status == 403 ? L["DirectAdmin denied the server-wide DNS zone overview."].Value
                    : L["DNS zones unavailable (HTTP {0}).", status].Value;
                zones = null;
                return;
            }
            using var doc = JsonDocument.Parse(body);
            zones = doc.RootElement.GetProperty("zones").EnumerateArray()
                .Select(x => new Zone(x.GetProperty("domain").GetString() ?? "",
                    x.TryGetProperty("owner", out var o) && o.ValueKind == JsonValueKind.String ? o.GetString() : null,
                    ReadFlag(x, "localData"), ReadFlag(x, "localMail"))).ToList();
            warning = doc.RootElement.TryGetProperty("warning", out var w)
                && w.ValueKind == JsonValueKind.String ? w.GetString() : null;
            currentPage = 1;
        }
        catch (Exception e) when (e is HttpRequestException or JsonException or InvalidOperationException)
        { error = e.Message; zones = null; }
        finally { loading = false; }
    }
    private async Task CreateZone()
    {
        if (changing || !Session.Connected || string.IsNullOrWhiteSpace(zoneDomain)) return;
        changing = true; zoneMessage = null;
        try
        {
            var (status, _) = await Session.CreateDnsZoneAsync(
                zoneDomain.Trim(), zoneIp.Trim(), zoneNs1.Trim(), zoneNs2.Trim());
            zoneMessage = status is >= 200 and < 300
                ? L["DirectAdmin created the DNS zone."].Value
                : L["Creation not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { zoneMessage = ex.Message; }
        finally { changing = false; }
        if (zoneMessage == L["DirectAdmin created the DNS zone."].Value) await Reload();
    }

    private bool deleteDialogOpen;
  private async Task ConfirmDeletion()
  {
      if (changing || !Session.Connected || deleteDialogOpen || string.IsNullOrWhiteSpace(deleteDomain)) return;
      var target = deleteDomain;
      var identity = Session.Username;
      
      deleteDialogOpen = true;
      try
      {
          var confirmed = await Dialogs.ConfirmResourceDeletionAsync(
              $"{L["Delete standalone DNS zone"]}: {target}", target,
              L["Delete only the specified DNS zone; this is not the same as deleting a hosting domain."].Value,
              L["Enter the exact domain name to confirm"].Value);
          if (confirmed && Session.Connected &&
              string.Equals(identity, Session.Username, StringComparison.Ordinal) &&
              string.Equals(target, deleteDomain, StringComparison.Ordinal))
          {
              zoneConfirmation = target;
              try { await DeleteZone(); }
              finally { zoneConfirmation = ""; }
          }
      }
      finally { deleteDialogOpen = false; }
  }

  private async Task DeleteZone()
    {
        if (changing || !Session.Connected || deleteDomain != zoneConfirmation) return;
        changing = true; zoneMessage = null;
        try
        {
            var (status, _) = await Session.DeleteDnsZoneAsync(deleteDomain, zoneConfirmation);
            zoneMessage = status is >= 200 and < 300
                ? L["DirectAdmin deleted the DNS zone."].Value
                : L["Deletion not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { zoneMessage = ex.Message; }
        finally { changing = false; zoneConfirmation = ""; }
        if (zoneMessage == L["DirectAdmin deleted the DNS zone."].Value) await Reload();
    }
    private static bool? ReadFlag(JsonElement element, string key)
    {
        if (!element.TryGetProperty(key, out var prop)) return null;
        return prop.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            _ => null
        };
    }
}
