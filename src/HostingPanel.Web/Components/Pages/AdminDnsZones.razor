@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/dns-zones"
@using System.Text.Json
@inject DirectAdminSession Session

<PageTitle>@L["DNS management — HostingPanel"]</PageTitle>
<div class="page-header">
    <div>
        <div class="eyebrow">@L["Server management / DNS"]</div>
        <h1>@L["DNS management"]</h1>
        <p>@L["All DNS zones exposed by the backend through DirectAdmin, including independently managed zones."]</p>
    </div>
    <div class="form-actions">
      <a href="#dns-create" class="btn">@L["＋ Add DNS zone"]</a>
      <button @onclick="Reload" disabled="@loading">@(loading ? "Laden…" : L["↻ Refresh"].Value)</button>
    </div>
</div>
@if (!Session.Connected)
{
    <section class="card">Maak eerst verbinding via het <a href="/">dashboard</a>.</section>
}
else
{
    <section class="card">
        <div class="dashboard-section-heading">
          <h2>DNS-zones</h2>
          @if (zones is not null) { <span class="status-pill good">@zones.Count zones</span> }
        </div>
        <label for="dnsSearch">@L["Search DNS zones"]</label>
        <input id="dnsSearch" type="search" @bind="search" @bind:event="oninput" placeholder="@L["Search domain name…"]" />
        <div class="domain-options">
            <label for="localData">@L["Local data"]</label>
            <select id="localData" @bind="localDataFilter">
                <option value="all">@L["Both"]</option><option value="yes">@L["Enabled"]</option>
                <option value="no">@L["Disabled"]</option>
            </select>
            <label for="localMail">@L["Local mail"]</label>
            <select id="localMail" @bind="localMailFilter">
                <option value="all">@L["Both"]</option><option value="yes">@L["Enabled"]</option>
                <option value="no">@L["Disabled"]</option>
            </select>
        </div>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        @if (loading) { <p role="status">@L["Retrieving DNS zones…"]</p> }
        @if (zones is not null)
        {
            <p>@Visible.Count DNS-zone(s) gevonden. @(warning is null ? "" : "Inventarisatie mogelijk onvolledig: " + warning)</p>
            <table>
                <thead><tr><th>@L["Domain"]</th><th>@L["Owner"]</th><th>@L["Local data"]</th><th>@L["Local mail"]</th></tr></thead>
                <tbody>
                @foreach (var zone in Visible.Skip((currentPage - 1) * PageSize).Take(PageSize))
                {
                    <tr>
                        <td><a href="@($"/domains/{Uri.EscapeDataString(zone.Domain)}/dns")">@zone.Domain</a></td>
                        <td>@(string.IsNullOrWhiteSpace(zone.Owner) ? "—" : zone.Owner)</td>
                        <td><span class="status-pill @(zone.LocalData is true ? "good" : "muted")">@Display(zone.LocalData)</span></td>
                        <td><span class="status-pill @(zone.LocalMail is true ? "good" : "muted")">@Display(zone.LocalMail)</span></td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="domain-options">
                <button disabled="@(loading || currentPage == 1)" @onclick="Previous">@L["Previous page"]</button>
                <span>Pagina @currentPage</span>
                <button disabled="@(loading || currentPage * PageSize >= Visible.Count)" @onclick="Next">@L["Next page"]</button>
            </div>
        }
    </section>
    <section class="card" id="dns-create">
        <h2>@L["Create standalone DNS zone"]</h2>
        <p>@L["Use the documented DirectAdmin DNS admin API. The backend checks permissions."]</p>
        <div class="form-grid">
          <div><label>@L["Domain"]</label><input @bind="zoneDomain" placeholder="example.com" /></div>
          <div><label>@L["IPv4 address"]</label><input @bind="zoneIp" placeholder="192.0.2.1" /></div>
          <div><label>Nameserver 1</label><input @bind="zoneNs1" placeholder="ns1.example.com" /></div>
          <div><label>Nameserver 2</label><input @bind="zoneNs2" placeholder="ns2.example.com" /></div>
        </div>
        <div class="form-actions"><button class="primary" disabled="@(changing || string.IsNullOrWhiteSpace(zoneDomain))" @onclick="CreateZone">@L["Create DNS zone"]</button></div>
    </section>
    <section class="card">
        <h2>@L["Delete standalone DNS zone"]</h2>
        <p>@L["Delete only the specified DNS zone; this is not the same as deleting a hosting domain."]</p>
        <label>@L["Domain"]</label><input @bind="deleteDomain" />
        <label>@L["Enter the exact domain name to confirm"]</label><input @bind="zoneConfirmation" />
        <button disabled="@(changing || string.IsNullOrWhiteSpace(deleteDomain) || deleteDomain != zoneConfirmation)"
            @onclick="DeleteZone">@L["Delete DNS zone"]</button>
    </section>
    @if (zoneMessage is not null) { <p role="status">@zoneMessage</p> }
}
@code {
    private sealed record Zone(string Domain, string? Owner, bool? LocalData, bool? LocalMail);
    private const int PageSize = 50;
    private List<Zone>? zones;
    private string search = "", localDataFilter = "all", localMailFilter = "all";
    private string? error, warning;
    private int currentPage = 1;
    private bool loading, changing;
    private string zoneDomain = "", zoneIp = "", zoneNs1 = "", zoneNs2 = "";
    private string deleteDomain = "", zoneConfirmation = "";
    private string? zoneMessage;

    private IReadOnlyList<Zone> Visible => (zones ?? [])
        .Where(z => z.Domain.Contains(search, StringComparison.OrdinalIgnoreCase) &&
            Matches(z.LocalData, localDataFilter) && Matches(z.LocalMail, localMailFilter))
        .ToArray();

    private static bool Matches(bool? value, string filter) =>
        filter == "all" || (value is not null && (filter == "yes") == value.Value);

    private static string Display(bool? value) =>
        value switch { true => "Ja", false => "Nee", null => L["Unavailable"].Value };

    protected override async Task OnInitializedAsync()
    {
        if (Session.Connected) await Reload();
    }
    private void Previous() { if (currentPage > 1) currentPage--; }
    private void Next() { if (currentPage * PageSize < Visible.Count) currentPage++; }

    private async Task Reload()
    {
        if (loading || !Session.Connected) return;
        loading = true;
        error = null;
        try
        {
            var (status, body) = await Session.GetAccessibleDnsZonesAsync();
            if (status != 200)
            {
                error = status == 403 ? L["DirectAdmin denied the server-wide DNS zone overview."].Value
                    : L["DNS zones unavailable (HTTP {0}).", status].Value;
                zones = null;
                return;
            }
            using var doc = JsonDocument.Parse(body);
            zones = doc.RootElement.GetProperty("zones").EnumerateArray()
                .Select(x => new Zone(x.GetProperty("domain").GetString() ?? "",
                    x.TryGetProperty("owner", out var o) && o.ValueKind == JsonValueKind.String ? o.GetString() : null,
                    ReadFlag(x, "localData"), ReadFlag(x, "localMail"))).ToList();
            warning = doc.RootElement.TryGetProperty("warning", out var w)
                && w.ValueKind == JsonValueKind.String ? w.GetString() : null;
            currentPage = 1;
        }
        catch (Exception e) when (e is HttpRequestException or JsonException or InvalidOperationException)
        { error = e.Message; zones = null; }
        finally { loading = false; }
    }
    private async Task CreateZone()
    {
        if (changing || !Session.Connected || string.IsNullOrWhiteSpace(zoneDomain)) return;
        changing = true; zoneMessage = null;
        try
        {
            var (status, _) = await Session.CreateDnsZoneAsync(
                zoneDomain.Trim(), zoneIp.Trim(), zoneNs1.Trim(), zoneNs2.Trim());
            zoneMessage = status is >= 200 and < 300
                ? L["DirectAdmin created the DNS zone."].Value
                : L["Creation not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { zoneMessage = ex.Message; }
        finally { changing = false; }
        if (zoneMessage == L["DirectAdmin created the DNS zone."].Value) await Reload();
    }

    private async Task DeleteZone()
    {
        if (changing || !Session.Connected || deleteDomain != zoneConfirmation) return;
        changing = true; zoneMessage = null;
        try
        {
            var (status, _) = await Session.DeleteDnsZoneAsync(deleteDomain, zoneConfirmation);
            zoneMessage = status is >= 200 and < 300
                ? L["DirectAdmin deleted the DNS zone."].Value
                : L["Deletion not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { zoneMessage = ex.Message; }
        finally { changing = false; zoneConfirmation = ""; }
        if (zoneMessage == L["DirectAdmin deleted the DNS zone."].Value) await Reload();
    }
    private static bool? ReadFlag(JsonElement element, string key)
    {
        if (!element.TryGetProperty(key, out var prop)) return null;
        return prop.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            _ => null
        };
    }
}
