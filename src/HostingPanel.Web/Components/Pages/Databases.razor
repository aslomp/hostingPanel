@page "/databases"
@using System.Text.Json
@inject DirectAdminSession Session

<PageTitle>Databasebeheer — HostingPanel</PageTitle>
<div class="page-header">
  <div><div class="eyebrow">Accountbeheer / Databases</div>
    <h1>Databasebeheer</h1>
    <p>Databases die DirectAdmin beschikbaar stelt aan de effectieve gebruiker.</p>
  </div>
  <button disabled="@loading" @onclick="Load">Vernieuwen</button>
</div>
@if (!Session.Connected)
{
  <section class="card">Maak eerst verbinding via het <a href="/">dashboard</a>.</section>
}
else
{
  <section class="card">
    <h2>Databases</h2>
    @if (error is not null) { <p role="alert" class="error">@error</p> }
    @if (loading) { <p role="status">Databases laden…</p> }
    @if (databases is not null)
    {
      <label for="dbFilter">Zoek database (@databases.Count)</label>
      <input id="dbFilter" @bind="search" @bind:event="oninput" placeholder="Databasenaam" />
      <table><thead><tr><th>Database</th><th>Acties</th></tr></thead><tbody>
        @foreach(var database in databases.Where(x => x.Contains(search,StringComparison.OrdinalIgnoreCase)))
        {
          <tr><td><a href="@($"/databases/{Uri.EscapeDataString(database)}")">@database</a></td>
            <td><a href="@($"/databases/{Uri.EscapeDataString(database)}")">Gebruikers bekijken / verwijderen</a></td></tr>
        }
      </tbody></table>
      @if(databases.Count==0) { <p>Geen databases gevonden.</p> }
    }
  </section>
  <section class="card">
    <h2>Alle toegankelijke databases (overall)</h2>
    <p>De backend bepaalt welke gedelegeerde accounts benaderbaar zijn. Resultaten van geweigerde accounts worden niet als lege databases weergegeven.</p>
    <button disabled="@overallLoading" @onclick="LoadOverall">Alle accounts doorzoeken</button>
    @if (overallError is not null) { <p class="error" role="alert">@overallError</p> }
    @if (overall is not null)
    {
      <p>@overall.Count databases gevonden. @(overallWarnings.Count == 0 ? "Volledige inventarisatie." : $"Onvolledig: {overallWarnings.Count} accounts konden niet worden uitgelezen.")</p>
      <table><thead><tr><th>Eigenaar</th><th>Database (backend)</th></tr></thead><tbody>
        @foreach (var item in overall)
        {
          <tr><td>@item.Owner</td><td><pre style="white-space:pre-wrap;overflow-wrap:anywhere">@item.Database</pre></td></tr>
        }
      </tbody></table>
      @foreach (var warning in overallWarnings)
      {
        <p class="error">@warning</p>
      }
    }
  </section>
  <section class="card">
    <h2>Database met gebruiker aanmaken</h2>
    <p>DirectAdmin voegt waar nodig de accountprefix toe. De exacte naam wordt na aanmaken opnieuw uit de backend opgehaald.</p>
    <label for="databaseName">Databasenaam</label>
    <input id="databaseName" @bind="newDatabase" autocomplete="off" placeholder="app" />
    <label for="dbUsername">Databasegebruiker</label>
    <input id="dbUsername" @bind="newUser" autocomplete="off" placeholder="app" />
    <label for="dbPassword">Wachtwoord</label>
    <input id="dbPassword" type="password" @bind="newPassword" autocomplete="new-password" />
    <button class="primary" disabled="@creating" @onclick="Create">
      @(creating ? "Aanmaken…" : "Database aanmaken")
    </button>
    @if (createMessage is not null) { <p role="status">@createMessage</p> }
  </section>
}
@code {
  private sealed record OwnedDb(string Owner, string Database);
  private List<OwnedDb>? overall;
  private List<string> overallWarnings = [];
  private string? overallError;
  private bool overallLoading;
  private List<string>? databases;
  private string search = "";
  private string newDatabase = "app", newUser = "app", newPassword = "";
  private string? error, createMessage;
  private bool loading, creating;
  protected override async Task OnInitializedAsync()
  {
    if (Session.Connected) await Load();
  }
  private async Task Load()
  {
    if (loading || !Session.Connected) return;
    loading = true; error = null;
    try
    {
      var (status, body) = await Session.GetDatabasesAsync();
      if(status!=200)
      {
        error=$"Databaseoverzicht niet beschikbaar (HTTP {status}).";
        databases=null; return;
      }
      using var json=JsonDocument.Parse(body);
      databases=json.RootElement.GetProperty("databases").EnumerateArray()
        .Select(x=>x.GetString()??"").ToList();
    }
    catch(Exception e) when(e is HttpRequestException or JsonException or ArgumentException or InvalidOperationException)
    { error=e.Message; databases=null; }
    finally {loading=false;}
  }
  private async Task LoadOverall()
  {
    if (overallLoading || !Session.Connected) return;
    overallLoading = true; overallError = null; overall = null;
    try
    {
      var (status, body) = await Session.GetAccessibleDatabasesAsync();
      if (status != 200) { overallError = $"Overall databaseoverzicht: HTTP {status}."; return; }
      using var doc = JsonDocument.Parse(body);
      overall = doc.RootElement.GetProperty("items").EnumerateArray()
        .Select(x => new OwnedDb(
          x.GetProperty("owner").GetString() ?? "",
          x.GetProperty("database").GetRawText())).ToList();
      overallWarnings = [];
      if (doc.RootElement.TryGetProperty("warnings", out var warnings)
          && warnings.ValueKind == JsonValueKind.Array)
        overallWarnings = warnings.EnumerateArray().Select(x => x.GetRawText()).ToList();
    }
    catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
    { overallError = ex.Message; }
    finally { overallLoading = false; }
  }
  private async Task Create()
  {
    if (creating || !Session.Connected) return;
    creating=true; createMessage=null;
    try
    {
      var (status, body)=await Session.CreateDatabaseAsync(newDatabase.Trim(),newUser.Trim(),newPassword);
      createMessage=status switch
      {
        200 => "Database aangemaakt. Het overzicht is bijgewerkt.",
        409 => "Mutaties zijn uitgeschakeld of de wijziging kon niet worden bevestigd.",
        400 => "Controleer de database- en gebruikersnaam en het wachtwoord.",
        403 => "DirectAdmin weigert deze databasebewerking.",
        _ => $"DirectAdmin heeft het aanmaken niet bevestigd (HTTP {status})."
      };
      if(status==200)
      {
        newPassword="";
        await Load();
      }
    }
    catch(Exception e) when(e is HttpRequestException or ArgumentException or InvalidOperationException)
    { createMessage=e.Message; }
    finally {creating=false;}
  }
}
