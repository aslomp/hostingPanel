@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/databases"
@using System.Text.Json
@inject DirectAdminSession Session

<PageTitle>@L["Database management — HostingPanel"]</PageTitle>
<div class="page-header">
  <div><div class="eyebrow">@L["Account management / Databases"]</div>
    <h1>@L["Database management"]</h1>
    <p>@L["Databases belonging to your account and all subordinate accounts accessible through the backend."]</p>
  </div>
  <div class="form-actions">
    <a class="btn" href="#database-create">@L["＋ Create database"]</a>
    <button disabled="@(loading || overallLoading)" @onclick="RefreshAll">@L["↻ Refresh"]</button>
  </div>
</div>
@if (!Session.Connected)
{
  <section class="card">Maak eerst verbinding via het <a href="/">dashboard</a>.</section>
}
else
{
  <section class="card">
    <div class="dashboard-section-heading"><h2>@L["All accessible databases"]</h2>
      @if (overall is not null) { <span class="status-pill @(overallWarnings.Count == 0 ? "good" : "warning")">@overall.Count gevonden</span> }
    </div>
    <p>@L["Includes databases of subordinate accounts where DirectAdmin permits access."]</p>
    <button disabled="@overallLoading" @onclick="LoadOverall">@L["Refresh overview"]</button>
    @if (overallLoading) { <p role="status">@L["Retrieving databases from accessible accounts…"]</p> }
    @if (overallError is not null) { <p class="error" role="alert">@overallError</p> }
    @if (overall is not null)
    {
      <p>@overall.Count databases gevonden. @(overallWarnings.Count == 0 ? L["Complete inventory."].Value : L["Incomplete: {0} accounts could not be read.", overallWarnings.Count].Value)</p>
      <label for="overallDbFilter">@L["Search databases"]</label>
      <input id="overallDbFilter" type="search" @bind="overallSearch" @bind:event="oninput" placeholder="@L["Search database or owner…"]" />
      <table><thead><tr><th>@L["Owner"]</th><th>Database</th><th>@L["Tables"]</th><th>@L["Users"]</th><th>@L["Size (bytes)"]</th><th>Definer issues</th></tr></thead><tbody>
        @foreach (var item in overall.Where(x => x.Owner.Contains(overallSearch, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(overallSearch, StringComparison.OrdinalIgnoreCase)))
        {
          <tr>
            <td><a href="@($"/users/{Uri.EscapeDataString(item.Owner)}")">@item.Owner</a></td>
            <td><strong>@item.Name</strong></td>
            <td>@item.TableCount.ToString("N0")</td><td>@item.UserCount.ToString("N0")</td>
            <td>@FormatBytes(item.SizeBytes)</td><td><span class="status-pill @(item.DefinerIssues == 0 ? "good" : "warning")">@item.DefinerIssues</span></td>
          </tr>
        }
      </tbody></table>
      @if (overall.Count == 0) { <p>@L["The backend returned no databases for accessible accounts."]</p> }
      @foreach (var warning in overallWarnings)
      {
        <p class="error">@warning</p>
      }
    }
  </section>
  <section class="card">
    <h2>@L["Databases in the current session"]</h2>
    <p>@L["Manage databases in the current session. For other accounts, use backend-supported session switching."]</p>

    @if (error is not null) { <p role="alert" class="error">@error</p> }
    @if (loading) { <p role="status">@L["Loading databases…"]</p> }
    @if (databases is not null)
    {
      <label for="dbFilter">Zoek database (@databases.Count)</label>
      <input id="dbFilter" @bind="search" @bind:event="oninput" placeholder="@L["Database name"]" />
      <table><thead><tr><th>Database</th><th>@L["Actions"]</th></tr></thead><tbody>
        @foreach(var database in databases.Where(x => x.Contains(search,StringComparison.OrdinalIgnoreCase)))
        {
          <tr><td><a href="@($"/databases/{Uri.EscapeDataString(database)}")">@database</a></td>
            <td><a href="@($"/databases/{Uri.EscapeDataString(database)}")">@L["View users / delete"]</a></td></tr>
        }
      </tbody></table>
      @if(databases.Count==0) { <p>@L["No databases found."]</p> }
    }
  </section>
  <section class="card" id="database-create">
    <h2>@L["Create database with user"]</h2>
    <p>@L["DirectAdmin adds the account prefix where necessary. The exact name is retrieved from the backend after creation."]</p>
    <div class="form-grid">
      <div><label for="databaseName">@L["Database name"]</label>
        <input id="databaseName" @bind="newDatabase" autocomplete="off" placeholder="app" /></div>
      <div><label for="dbUsername">@L["Database user"]</label>
        <input id="dbUsername" @bind="newUser" autocomplete="off" placeholder="app" /></div>
      <div><label for="dbPassword">@L["Password"]</label>
        <input id="dbPassword" type="password" @bind="newPassword" autocomplete="new-password" /></div>
    </div>
    <div class="form-actions"><button class="primary" disabled="@creating" @onclick="Create">
      @(creating ? "Aanmaken…" : L["Create database"].Value)
    </button>
    </div>
    @if (createMessage is not null) { <p role="status">@createMessage</p> }
  </section>
}
@code {
  private sealed record OwnedDb(string Owner, string Name, long TableCount, long UserCount, long SizeBytes, long DefinerIssues);
  private List<OwnedDb>? overall;
  private List<string> overallWarnings = [];
  private string? overallError;
  private bool overallLoading;
  private List<string>? databases;
  private string search = "", overallSearch = "";
  private string newDatabase = "app", newUser = "app", newPassword = "";
  private string? error, createMessage;
  private bool loading, creating;
  protected override async Task OnInitializedAsync()
  {
    if (Session.Connected) await RefreshAll();
  }
  private async Task RefreshAll()
  {
    if (!Session.Connected) return;
    await LoadOverall();
    await Load();
  }
  private async Task Load()
  {
    if (loading || !Session.Connected) return;
    loading = true; error = null;
    try
    {
      var (status, body) = await Session.GetDatabasesAsync();
      if(status!=200)
      {
        error=L["Database overview unavailable (HTTP {0}).", status].Value;
        databases=null; return;
      }
      using var json=JsonDocument.Parse(body);
      databases=json.RootElement.GetProperty("databases").EnumerateArray()
        .Select(x=>x.GetString()??"").ToList();
    }
    catch(Exception e) when(e is HttpRequestException or JsonException or ArgumentException or InvalidOperationException)
    { error=e.Message; databases=null; }
    finally {loading=false;}
  }
  private static string FormatBytes(long value)
  {
    if (value < 1024) return value.ToString("N0") + " B";
    var units = new[] { "KB", "MB", "GB", "TB", "PB" };
    var size = (double)value;
    var index = -1;
    do { size /= 1024; index++; } while (size >= 1024 && index < units.Length - 1);
    return size.ToString("N1") + " " + units[index];
  }
  private static long Number(JsonElement item, string property) =>
    item.TryGetProperty(property, out var value) && value.TryGetInt64(out var number)
      ? number : 0;
  private async Task LoadOverall()
  {
    if (overallLoading || !Session.Connected) return;
    overallLoading = true; overallError = null; overall = null;
    try
    {
      var (status, body) = await Session.GetAccessibleDatabasesAsync();
      if (status != 200) { overallError = L["Overall database overview: HTTP {0}.", status].Value; return; }
      using var doc = JsonDocument.Parse(body);
      overall = doc.RootElement.GetProperty("items").EnumerateArray()
        .Select(x => {
          var db = x.GetProperty("database");
          return new OwnedDb(
            x.GetProperty("owner").GetString() ?? "",
            db.GetProperty("database").GetString() ?? "",
            Number(db, "tableCount"), Number(db, "userCount"),
            Number(db, "sizeBytes"), Number(db, "definerIssues"));
        }).ToList();
      overallWarnings = [];
      if (doc.RootElement.TryGetProperty("warnings", out var warnings)
          && warnings.ValueKind == JsonValueKind.Array)
        overallWarnings = warnings.EnumerateArray().Select(x => x.GetRawText()).ToList();
    }
    catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
    { overallError = ex.Message; }
    finally { overallLoading = false; }
  }
  private async Task Create()
  {
    if (creating || !Session.Connected) return;
    creating=true; createMessage=null;
    try
    {
      var (status, body)=await Session.CreateDatabaseAsync(newDatabase.Trim(),newUser.Trim(),newPassword);
      createMessage=status switch
      {
        200 => L["Database created. The overview has been refreshed."].Value,
        409 => L["Mutations are disabled or the change could not be confirmed."].Value,
        400 => L["Check the database name, username and password."].Value,
        403 => L["DirectAdmin denied this database operation."].Value,
        _ => L["DirectAdmin did not confirm creation (HTTP {0}).", status].Value
      };
      if(status==200)
      {
        newPassword="";
        await RefreshAll();
      }
    }
    catch(Exception e) when(e is HttpRequestException or ArgumentException or InvalidOperationException)
    { createMessage=e.Message; }
    finally {creating=false;}
  }
}
