@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/databases"
@using System.Text.Json
@inject DirectAdminSession Session
@inject IDialogService Dialogs

<PageTitle>@L["Database management — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Account management / Databases"]</Breadcrumb>
    <TitleContent>@L["Database management"]</TitleContent>
    <Description>@L["Databases belonging to your account and all subordinate accounts accessible through the backend."]</Description>
    <Actions><MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
    <CrudAddButton Disabled="@(!Session.Connected || creating || deleting)" OnClick="OpenCreate">@L["Create database"]</CrudAddButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(loading || overallLoading)" OnClick="RefreshAll">@L["↻ Refresh"]</MudButton>
  </MudStack></Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
  <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else
{
  <MudPaper Class="pa-4 my-3" Elevation="1">
    <div class="dashboard-section-heading"><h2>@L["All accessible databases"]</h2>
      @if (overall is not null) { <MudChip T="string" Size="Size.Small" Color="@(overallWarnings.Count == 0 ? Color.Success : Color.Warning)">@L["Found: {0}", overall.Count]</MudChip> }
    </div>
    <p>@L["Includes databases of subordinate accounts where DirectAdmin permits access."]</p>
    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@overallLoading" OnClick="LoadOverall">@L["Refresh overview"]</MudButton>
    @if (overallLoading) { <PanelLoading>@L["Retrieving databases from accessible accounts…"]</PanelLoading> }
    @if (overallError is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@overallError</MudAlert> }
    @if (overall is not null)
    {
      <p>@L["Databases found: {0}.", overall.Count] @(overallWarnings.Count == 0 ? L["Complete inventory."].Value : L["Incomplete: {0} accounts could not be read.", overallWarnings.Count].Value)</p>
      <label for="overallDbFilter">@L["Search databases"]</label>
      <MudTextField T="string" @bind-Value="overallSearch" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="overallDbFilter" Placeholder="@L["Search database or owner…"].Value" />
      <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><thead><tr><th>@L["Owner"]</th><th>Database</th><th>@L["Tables"]</th><th>@L["Users"]</th><th>@L["Size (bytes)"]</th><th>Definer issues</th></tr></thead><tbody>
        @foreach (var item in overall.Where(x => x.Owner.Contains(overallSearch, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(overallSearch, StringComparison.OrdinalIgnoreCase)))
        {
          <tr>
            <td><a href="@($"/users/{Uri.EscapeDataString(item.Owner)}")">@item.Owner</a></td>
            <td><strong>@item.Name</strong></td>
            <td>@item.TableCount.ToString("N0")</td><td>@item.UserCount.ToString("N0")</td>
            <td>@FormatBytes(item.SizeBytes)</td><td><MudChip T="string" Size="Size.Small" Color="@(item.DefinerIssues == 0 ? Color.Success : Color.Warning)">@item.DefinerIssues</MudChip></td>
          </tr>
        }
      </tbody></MudSimpleTable>
      @if (overall.Count == 0) { <PanelEmptyState>@L["The backend returned no databases for accessible accounts."]</PanelEmptyState> }
      @foreach (var warning in overallWarnings)
      {
        <p class="error">@warning</p>
      }
    }
  </MudPaper>
  <MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Databases in the current session"]</h2>
    <p>@L["Manage databases in the current session. For other accounts, use backend-supported session switching."]</p>

    @if (error is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
    @if (loading) { <PanelLoading>@L["Loading databases…"]</PanelLoading> }
    @if (databases is not null)
    {
      <label for="dbFilter">@L["Search databases"] (@databases.Count)</label>
      <MudTextField T="string" @bind-Value="search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dbFilter" Placeholder="@L["Database name"].Value" />
      <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true"><thead><tr><th>Database</th><th>@L["Actions"]</th></tr></thead><tbody>
        @foreach(var database in databases.Where(x => x.Contains(search,StringComparison.OrdinalIgnoreCase)).OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
        {
          <tr><td><a href="@($"/databases/{Uri.EscapeDataString(database)}")">@database</a></td>
            <td><CrudDeleteButton Label="@L["Delete database"].Value" Disabled="@(creating || deleting)" OnClick="() => ConfirmDelete(database)" /></td></tr>
        }
      </tbody></MudSimpleTable>
      @if(databases.Count==0) { <PanelEmptyState>@L["No databases found."]</PanelEmptyState> }
    }
  </MudPaper>
  @if (createMessage is not null) { <MudAlert Severity="@(mutationFailed ? Severity.Error : Severity.Success)" Class="my-2">@createMessage</MudAlert> }
}
@code {
  private sealed record OwnedDb(string Owner, string Name, long TableCount, long UserCount, long SizeBytes, long DefinerIssues);
  private List<OwnedDb>? overall;
  private List<string> overallWarnings = [];
  private string? overallError;
  private bool overallLoading;
  private List<string>? databases;
  private string search = "", overallSearch = "";
  private string? error, createMessage;
  private bool loading, creating, deleting, mutationFailed;
  private async Task OpenCreate()
  {
    if (creating || deleting || !Session.Connected) return;
    creating = true; createMessage = null;
    try
    {
      var dialog = await Dialogs.ShowAsync<DatabaseCreateDialog>(L["Create database with user"].Value,
        new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false, CloseOnEscapeKey = false });
      var result = await dialog.Result;
      if (result is { Canceled: false })
      {
        mutationFailed = false;
        createMessage = L["Database created. The overview has been refreshed."].Value;
        await RefreshAll();
      }
    }
    finally { creating = false; }
  }
  private async Task ConfirmDelete(string database)
  {
    if (deleting || creating || !Session.Connected) return;
    deleting = true;
    var identity = Session.Username;
    try
    {
      var confirmed = await Dialogs.ConfirmResourceDeletionAsync(
        L["Delete database"].Value, database,
        L["This deletes the database and may cause irreversible data loss. Enter the exact database name to confirm."].Value,
        L["Enter the exact database name to confirm."].Value);
      if (!confirmed || !Session.Connected || identity != Session.Username) return;
      var (status, _) = await Session.DeleteDatabaseAsync(database, database);
      mutationFailed = status is < 200 or >= 300;
      createMessage = mutationFailed ? L["Database deletion not confirmed (HTTP {0}).", status].Value : L["Database deleted."].Value;
      if (!mutationFailed) await RefreshAll();
    }
    catch (Exception ex) when (ex is HttpRequestException or ArgumentException or InvalidOperationException)
    { mutationFailed = true; createMessage = ex.Message; }
    finally { deleting = false; }
  }
  protected override async Task OnInitializedAsync()
  {
    if (Session.Connected) await RefreshAll();
  }
  private async Task RefreshAll()
  {
    if (!Session.Connected) return;
    await LoadOverall();
    await Load();
  }
  private async Task Load()
  {
    if (loading || !Session.Connected) return;
    loading = true; error = null;
    try
    {
      var (status, body) = await Session.GetDatabasesAsync();
      if(status!=200)
      {
        error=L["Database overview unavailable (HTTP {0}).", status].Value;
        databases=null; return;
      }
      using var json=JsonDocument.Parse(body);
      databases=json.RootElement.GetProperty("databases").EnumerateArray()
        .Select(x=>x.GetString()??"").ToList();
    }
    catch(Exception e) when(e is HttpRequestException or JsonException or ArgumentException or InvalidOperationException)
    { error=e.Message; databases=null; }
    finally {loading=false;}
  }
  private static string FormatBytes(long value)
  {
    if (value < 1024) return value.ToString("N0") + " B";
    var units = new[] { "KB", "MB", "GB", "TB", "PB" };
    var size = (double)value;
    var index = -1;
    do { size /= 1024; index++; } while (size >= 1024 && index < units.Length - 1);
    return size.ToString("N1") + " " + units[index];
  }
  private static long Number(JsonElement item, string property) =>
    item.TryGetProperty(property, out var value) && value.TryGetInt64(out var number)
      ? number : 0;
  private async Task LoadOverall()
  {
    if (overallLoading || !Session.Connected) return;
    overallLoading = true; overallError = null; overall = null;
    try
    {
      var (status, body) = await Session.GetAccessibleDatabasesAsync();
      if (status != 200) { overallError = L["Overall database overview: HTTP {0}.", status].Value; return; }
      using var doc = JsonDocument.Parse(body);
      overall = doc.RootElement.GetProperty("items").EnumerateArray()
        .Select(x => {
          var db = x.GetProperty("database");
          return new OwnedDb(
            x.GetProperty("owner").GetString() ?? "",
            db.GetProperty("database").GetString() ?? "",
            Number(db, "tableCount"), Number(db, "userCount"),
            Number(db, "sizeBytes"), Number(db, "definerIssues"));
        }).ToList();
      overallWarnings = [];
      if (doc.RootElement.TryGetProperty("warnings", out var warnings)
          && warnings.ValueKind == JsonValueKind.Array)
        overallWarnings = warnings.EnumerateArray().Select(x => x.GetRawText()).ToList();
    }
    catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
    { overallError = ex.Message; }
    finally { overallLoading = false; }
  }
}
