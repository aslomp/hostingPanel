@page "/security"
@inject DirectAdminSession Session
<PageTitle>Beveiliging — HostingPanel</PageTitle>
<div class="page-header"><div><div class="eyebrow">Serverbeheer</div><h1>Beveiliging</h1><p>ModSecurity en ClamAV via de officiële DirectAdmin API.</p></div><button disabled="@busy" @onclick="Load">Vernieuwen</button></div>
@if (!Session.Connected) { <section class="card">Verbind eerst via het <a href="/">dashboard</a>.</section> }
else
{
    <section class="card">
        <h2>ModSecurity</h2>
        <label>Configuratieoverzicht</label><pre style="white-space:pre-wrap;overflow-wrap:anywhere">@modsecurity</pre>
        <label>Auditlogs — samenvatting</label><pre style="white-space:pre-wrap;overflow-wrap:anywhere">@audit</pre>
    </section>
    <section class="card">
        <h2>ClamAV</h2>
        <p>Actieve scanprocessen</p><pre style="white-space:pre-wrap;overflow-wrap:anywhere">@clamav</pre>
        <h2>Scan starten</h2>
        <p>Gebruik een pad dat de DirectAdmin-backend mag scannen. De backend valideert het pad en beslist over toegang.</p>
        <label>Pad op de server</label><input @bind="scanPath" placeholder="/home/..." />
        <label>Typ SCAN om te bevestigen</label><input @bind="scanConfirmation" />
        <button class="primary" disabled="@(busy || string.IsNullOrWhiteSpace(scanPath) || scanConfirmation != "SCAN")" @onclick="Scan">ClamAV-scan starten</button>
        <h2>Scan annuleren</h2>
        <label>ClamAV-proces-ID (PID)</label><input @bind="scanPid" />
        <label>Typ dezelfde PID om te bevestigen</label><input @bind="pidConfirmation" />
        <button disabled="@(busy || string.IsNullOrWhiteSpace(scanPid) || scanPid != pidConfirmation)" @onclick="CancelScan">Scan annuleren</button>
    </section>
    @if (feedback is not null) { <p role="status">@feedback</p> }
}
@code {
    private string modsecurity = "", audit = "", clamav = "", scanPath = "", scanConfirmation = "", scanPid = "", pidConfirmation = "";
    private string? feedback;
    private bool busy;
    protected override async Task OnInitializedAsync() { if (Session.Connected) await Load(); }
    private async Task CancelScan()
    {
        if (busy || !Session.Connected || string.IsNullOrWhiteSpace(scanPid) ||
            !scanPid.All(char.IsAsciiDigit) || scanPid != pidConfirmation) return;
        busy = true; feedback = null;
        try
        {
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Delete,
                "api/clamav/" + Uri.EscapeDataString(scanPid));
            feedback = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { feedback = ex.Message; }
        finally { busy = false; scanPid = ""; pidConfirmation = ""; }
    }
    private async Task Scan()
    {
        if (busy || !Session.Connected || string.IsNullOrWhiteSpace(scanPath) || scanConfirmation != "SCAN") return;
        busy = true; feedback = null;
        try
        {
            var payload = System.Text.Json.JsonSerializer.Serialize(new { path = scanPath });
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Post, "api/clamav", payload);
            feedback = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { feedback = ex.Message; }
        finally { busy = false; scanConfirmation = ""; }
    }
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true; feedback = null;
        try
        {
            var (ms, mb) = await Session.GetRawAsync("api/modsecurity/all-configs");
            modsecurity = $"HTTP {ms}\n{mb}";
            var (asCode, ab) = await Session.GetRawAsync("api/modsecurity-audit-log/summary");
            audit = $"HTTP {asCode}\n{ab}";
            var (cs, cb) = await Session.GetRawAsync("api/clamav");
            clamav = $"HTTP {cs}\n{cb}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { feedback = ex.Message; }
        finally { busy = false; }
    }
}
