@using System.Text.Json
@using System.Text.Json.Nodes
@inject DirectAdminSession Session
@if (config is not null)
{
    <section class="card">
        <h2>SSL Certificates / ACME Settings</h2>
        <label><input type="checkbox" @bind="enabled" /> Automatic certificate renewal</label>
        <label>ACME provider</label>
        <select @bind="provider"><option value="">Default (inherited)</option>
            @foreach (var option in providers) { <option value="@option.Id">@option.Name</option> }
        </select>
        <label>Private key</label>
        <select @bind="keyType"><option>ec256</option><option>ec384</option><option>rsa2048</option><option>rsa3072</option><option>rsa4096</option><option>rsa8192</option></select>
        <label><input type="checkbox" @bind="wildcard" /> Prefer wildcard</label>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Save">Save ACME settings</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Provision">Request certificate</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="LoadStatus">Refresh certificate information</MudButton>
        @if (certificateStatus is not null) { <p role="status">@certificateStatus</p> }
        @foreach (var cert in certificates)
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true"><tbody>
                <tr><th>Status</th><td>@(cert.Error.Length == 0 ? "Issued" : cert.Error)</td></tr>
                <tr><th>Automatic renewal</th><td>@cert.AutorenewEnabled</td></tr>
                @if (cert.Certificate is not null)
                {
                    <tr><th>Subject</th><td>@cert.Certificate.Subject</td></tr>
                    <tr><th>Issuer</th><td>@cert.Certificate.Issuer</td></tr>
                    <tr><th>DNS names</th><td>@string.Join(", ", cert.Certificate.DnsNames)</td></tr>
                    <tr><th>Valid from</th><td>@cert.Certificate.NotBefore.ToLocalTime()</td></tr>
                    <tr><th>Expires</th><td>@cert.Certificate.NotAfter.ToLocalTime()</td></tr>
                    <tr><th>Key type</th><td>@cert.Certificate.PrettyType</td></tr>
                    <tr><th>Serial number</th><td>@cert.Certificate.SerialNumber</td></tr>
                }
            </tbody></MudSimpleTable>
        }
        @if (logs.Length > 0)
        {
            <h3>ACME logs</h3>
            <MudSimpleTable Dense="true" Hover="true" Striped="true"><thead><tr><th>Created</th><th>Challenge</th><th>Status</th></tr></thead><tbody>
            @foreach(var log in logs) { <tr><td>@log.CreateTime</td><td>@log.ChallengeType</td><td>@log.Status</td></tr> }
            </tbody></MudSimpleTable>
        }
        @if (message is not null) { <p role="status">@message</p> }
    </section>
}
@code {
    [Parameter] public string Domain { get; set; } = "";
    private sealed record Provider(string Id, string Name);
    private Provider[] providers = [];
    private sealed record PublicCert(string Subject,string Issuer,string[] DnsNames,DateTimeOffset NotBefore,DateTimeOffset NotAfter,string PrettyType,string SerialNumber);
    private sealed record Cert(string Error,bool AutorenewEnabled,PublicCert? Certificate);
    private sealed record CertResponse(Cert[] Certs);
    private sealed record AcmeLog(string CreateTime,string ChallengeType,string Status);
    private Cert[] certificates = [];
    private AcmeLog[] logs = [];
    private string? certificateStatus;
    private async Task LoadStatus()
    {
        certificates = []; logs = []; certificateStatus = null;
        try {
            var options = new JsonSerializerOptions(JsonSerializerDefaults.Web);
            var (status, body) = await Session.GetRawAsync(Endpoint + "/certs");
            if (status == 200) { certificates = JsonSerializer.Deserialize<CertResponse>(body,options)?.Certs ?? []; if(certificates.Length==0) certificateStatus="No certificate issued yet."; }
            else certificateStatus=$"Certificate information unavailable (HTTP {status}).";
            var (ls, lb) = await Session.GetRawAsync(Endpoint + "/acme-logs");
            if(ls==200) logs=JsonSerializer.Deserialize<AcmeLog[]>(lb,options) ?? [];
        } catch(Exception ex) when(ex is JsonException or HttpRequestException or InvalidOperationException) { certificateStatus="Certificate information unavailable."; }
    }
    private JsonObject? config;
    private string provider = "", keyType = "ec256";
    private bool enabled, wildcard, busy;
    private string? message;
    private string Endpoint => "api/domain-tls/domains/" + Uri.EscapeDataString(Domain);
    protected override async Task OnParametersSetAsync()
    {
        config = null;
        try {
            var (status, body) = await Session.GetRawAsync(Endpoint + "/acme-config");
            if (status != 200) return;
            var (ps, pb) = await Session.GetRawAsync("api/session/acme-data");
            if (ps != 200) return;
            using var doc = JsonDocument.Parse(pb);
            providers = doc.RootElement.GetProperty("certProviders").Deserialize<Provider[]>(new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? [];
            config = JsonNode.Parse(body)?.AsObject();
            if (config is null) return;
            enabled = config["enabled"]?.GetValue<bool>() ?? false;
            provider = config["provider"]?.GetValue<string>() ?? "";
            keyType = config["keyType"]?.GetValue<string>() ?? "ec256";
            wildcard = config["preferWildcard"]?.GetValue<bool>() ?? false;
            await LoadStatus();
        } catch (Exception ex) when (ex is JsonException or HttpRequestException or InvalidOperationException) { message = ex.Message; }
    }
    private async Task Save()
    {
        if (busy || config is null) return;
        busy = true;
        try {
            config["enabled"] = enabled; config["provider"] = provider; config["keyType"] = keyType; config["preferWildcard"] = wildcard;
            var (status, body) = await Session.RequestApiAsync(HttpMethod.Put, Endpoint + "/acme-config", config.ToJsonString());
            message = status == 204 ? "ACME settings saved." : $"HTTP {status}: {body}";
        } catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { message = ex.Message; }
        finally { busy = false; }
    }
    private async Task Provision()
    {
        if (busy) return;
        busy = true;
        try { var (status, body) = await Session.RequestApiAsync(HttpMethod.Post, Endpoint + "/provision-certs?nonblock=true"); message = status == 200 ? "Certificate request submitted." : $"HTTP {status}: {body}"; }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { message = ex.Message; }
        finally { busy = false; }
    }
}
