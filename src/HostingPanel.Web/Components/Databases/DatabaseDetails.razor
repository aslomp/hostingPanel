@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/databases/{Database}"
@using HostingPanel.Api.Services
@inject PanelSession Session
@inject DatabaseOperations DatabaseOps
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>@Database — Databasebeheer</PageTitle>
<PanelPageHeader>
    <Breadcrumb><a href="/databases">@L["Database management"]</a> / Details</Breadcrumb>
    <TitleContent>@Database</TitleContent>
    <Description>@L["Database users and management operations through DirectAdmin."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@loading" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if(!Session.Connected)
{
  <MudPaper Class="pa-4 my-3" Elevation="1">Maak eerst verbinding via het <a href="/">dashboard</a>.</MudPaper>
}
else
{
  <MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Database users"]</h2>
    @if(error is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
    @if(loading) { <PanelLoading>@L["Loading users…"]</PanelLoading> }
    @if(users is not null)
    {
      <MudSimpleTable Dense="true" Hover="true" Striped="true"><thead><tr><th>@L["Username"]</th></tr></thead>
      <tbody>@foreach(var username in users){<tr><td>@username</td></tr>}</tbody></MudSimpleTable>
      @if(users.Count==0) { <PanelEmptyState>@L["No users returned by DirectAdmin."]</PanelEmptyState> }
    }
  </MudPaper>
  <MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Delete database"]</h2>
    <p>@L["This deletes the database and may cause irreversible data loss. Enter the exact database name to confirm."]</p>
    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@deleting" OnClick="ConfirmDeletion">@L["Permanently delete database"]</MudButton>
    @if(deleteMessage is not null) { <p role="status">@deleteMessage</p> }
  </MudPaper>
}
@implements IDisposable
@code {
  [Parameter] public string Database { get; set; } = "";
  private List<string>? users;
  private string? error, deleteMessage;
  private string confirmation="";
  private readonly LatestRead read = new();
  private bool loading => read.Loading;
  private bool deleting;
    private bool disposed;
    protected override void OnInitialized() => Session.Changed += SessionChanged;
    protected override Task OnParametersSetAsync() => Load();
    private void SessionChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        var task = Load();
        StateHasChanged();
        await task;
        if (!disposed) StateHasChanged();
    });
    public void Dispose()
    {
        disposed = true;
        Session.Changed -= SessionChanged;
        read.Dispose();
    }

    private Task Load()
    {
        if (disposed) return Task.CompletedTask;
        users = null; error = null;
        if (!Session.Connected)
        {
            read.Cancel();
            return Task.CompletedTask;
        }
        var target = Database;
        var channel = Session.TicketChannel;
        return read.RunAsync(ct => DatabaseOps.UsersAsync(target, ct),
            () => Session.Connected && Session.TicketChannel == channel && Database == target,
            result =>
            {
                if (result.Status != 200 || result.Users is null)
                {
                    error = L["Database users unavailable (HTTP {0}).", result.Status].Value;
                    return;
                }
                users = result.Users.ToList();
            }, ex => error = ex.Message);
    }

  private bool deleteDialogOpen;
  private async Task ConfirmDeletion()
  {
      if (deleting || !Session.Connected || deleteDialogOpen || string.IsNullOrWhiteSpace(Database)) return;
      var target = Database;
      var identity = Session.Username;
      
      deleteDialogOpen = true;
      try
      {
          var confirmed = await Dialogs.ConfirmResourceDeletionAsync(
              $"{L["Delete database"]}: {target}", target,
              L["This deletes the database and may cause irreversible data loss. Enter the exact database name to confirm."].Value,
              L["Enter the exact database name to confirm."].Value);
          if (confirmed && Session.Connected &&
              string.Equals(identity, Session.Username, StringComparison.Ordinal) &&
              string.Equals(target, Database, StringComparison.Ordinal))
          {
              confirmation = target;
              try { await Delete(); }
              finally { confirmation = ""; }
          }
      }
      finally { deleteDialogOpen = false; }
  }

  private async Task Delete()
  {
    if(deleting || confirmation!=Database || !Session.Connected) return;
    deleting=true; deleteMessage=null;
    try
    {
      var (status,errorCode)=await DatabaseOps.DeleteAsync(Database,confirmation);
      if(errorCode is null && status is >= 200 and < 300)
      {
        confirmation="";
        Navigation.NavigateTo("/databases");
        return;
      }
      deleteMessage=status switch {
        409 => L["Mutations are disabled or the change could not be confirmed."].Value,
        403 => L["The backend denied deletion."].Value,
        _ => L["Database deletion not confirmed (HTTP {0}).", status].Value
      };
    }
    catch(Exception e) when(e is HttpRequestException or ArgumentException or InvalidOperationException)
    {deleteMessage=e.Message;}
    finally {deleting=false;}
  }
}
