@using System.Text.Json
@inject DirectAdminSession Session

<section class="card">
    <h2>@(Kind == "reseller" ? "Reseller aanmaken" : "Gebruiker aanmaken")</h2>
    <p>DirectAdmin controleert het pakket, het IP-adres en de bevoegdheden van de aangemelde identiteit.</p>
    <label>Accountnaam</label><input @bind="username" autocomplete="off" />
    <label>E-mailadres</label><input type="email" @bind="email" autocomplete="off" />
    <label>Hoofddomein</label><input @bind="domain" placeholder="example.com" />
    <label>Pakket</label><input @bind="package" autocomplete="off" />
    <label>IP / toewijzing</label><input @bind="ip" placeholder="shared" />
    <label>Nieuw wachtwoord</label><input type="password" @bind="password" autocomplete="new-password" />
    <label>Wachtwoord bevestigen</label><input type="password" @bind="passwordConfirmation" autocomplete="new-password" />
    <button class="primary" disabled="@(busy || string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(package) || password != passwordConfirmation || password.Length < 5)" @onclick="Create">
        @(busy ? "Verwerken…" : "Account aanmaken")
    </button>
</section>
<section class="card">
    <h2>@(Kind == "reseller" ? "Reseller verwijderen" : "Gebruiker verwijderen")</h2>
    <p>Dit verwijdert een account via DirectAdmin. Typ de accountnaam exact ter bevestiging.</p>
    <label>Accountnaam</label><input @bind="deleteUsername" />
    <label>Bevestig accountnaam</label><input @bind="deleteConfirmation" />
    <button disabled="@(busy || string.IsNullOrWhiteSpace(deleteUsername) || deleteUsername != deleteConfirmation)"
        @onclick="Delete">Account verwijderen</button>
</section>
@if (result is not null) { <p role="status">@result</p> }

@code {
    [Parameter] public string Kind { get; set; } = "user";
    private string username = "", email = "", domain = "", package = "", ip = "shared";
    private string password = "", passwordConfirmation = "";
    private string deleteUsername = "", deleteConfirmation = "";
    private bool busy;
    private string? result;

    private async Task Create()
    {
        if (busy || !Session.Connected || password != passwordConfirmation || password.Length < 5) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.CreateHostingAccountAsync(
                Kind, username, email, password, domain, package, ip);
            result = status is >= 200 and < 300
                ? $"DirectAdmin heeft het account '{username}' aangemaakt."
                : $"Account niet aangemaakt: backend HTTP {status}.";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { password = ""; passwordConfirmation = ""; busy = false; }
    }
    private async Task Delete()
    {
        if (busy || !Session.Connected || deleteUsername != deleteConfirmation) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.DeleteHostingAccountAsync(
                Kind, deleteUsername, deleteConfirmation);
            result = status is >= 200 and < 300
                ? $"DirectAdmin heeft de verwijdering van '{deleteUsername}' bevestigd."
                : $"Verwijdering niet bevestigd: backend HTTP {status}.";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { deleteConfirmation = ""; busy = false; }
    }
}
