@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using System.Text.Json
@inject DirectAdminSession Session
@inject IDialogService Dialogs

<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@(Kind == "reseller" ? L["Create reseller"].Value : L["Create user"].Value)</h2>
    <p>@L["DirectAdmin validates the package, IP address and permissions of the signed-in identity."]</p>
    <MudTextField T="string" Label="@L["Account name"].Value" @bind-Value="username" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" AutoComplete="off" />
    <MudTextField T="string" Label="@L["Email address"].Value" @bind-Value="email" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" AutoComplete="off" InputType="InputType.Email" />
    <MudTextField T="string" Label="@L["Primary domain"].Value" @bind-Value="domain" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="example.com" />
    <MudTextField T="string" Label="@L["Package"].Value" @bind-Value="package" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" AutoComplete="off" />
    <MudTextField T="string" Label="@L["IP / assignment"].Value" @bind-Value="ip" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="shared" />
    <MudTextField T="string" Label="@L["New password"].Value" @bind-Value="password" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" AutoComplete="new-password" InputType="InputType.Password" />
    <MudTextField T="string" Label="@L["Confirm password"].Value" @bind-Value="passwordConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" AutoComplete="new-password" InputType="InputType.Password" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(package) || password != passwordConfirmation || password.Length < 5)" OnClick="Create">
        @(busy ? L["Processing…"].Value : L["Create account"].Value)
    </MudButton>
</MudPaper>
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@(Kind == "reseller" ? L["Delete reseller"].Value : L["Delete user"].Value)</h2>
    <p>@L["This deletes an account through DirectAdmin. Enter the exact account name to confirm."]</p>
    <MudTextField T="string" Label="@L["Account name"].Value" @bind-Value="deleteUsername" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(busy || string.IsNullOrWhiteSpace(deleteUsername))" OnClick="ConfirmDeletion">@L["Delete account"]</MudButton>
</MudPaper>
@if (Kind == "user")
{
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Change user package"]</h2>
    <p>@L["The package must exist on the backend. The change is verified against the user configuration after saving."]</p>
    <MudTextField T="string" Label="@L["Username"].Value" @bind-Value="packageUsername" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <MudTextField T="string" Label="@L["New package"].Value" @bind-Value="newPackage" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <MudTextField T="string" Label="@L["Enter the username to confirm"].Value" @bind-Value="packageConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(packageUsername) || packageConfirmation != packageUsername)" OnClick="ChangePackage">@L["Change package"]</MudButton>
</MudPaper>
}
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Change account limit"]</h2>
    <p>@L["Changes only one limit. DirectAdmin then applies its own package and limit rules."]</p>
    <MudTextField T="string" Label="@L["Account name"].Value" @bind-Value="limitUsername" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <label>@L["Limit"]</label>
    <MudSelect T="string" @bind-Value="limitField" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="string" Value='@("bandwidth")'>@L["Bandwidth (MB)"]</MudSelectItem><MudSelectItem T="string" Value='@("quota")'>@L["Disk space (MB)"]</MudSelectItem><MudSelectItem T="string" Value='@("inode")'>Inodes</MudSelectItem></MudSelect>
    <MudTextField T="string" Label="@L["New limit (number)"].Value" @bind-Value="limitValue" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <MudTextField T="string" Label="@L["Enter the account name to confirm"].Value" @bind-Value="limitConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(limitUsername) || limitConfirmation != limitUsername)" OnClick="SetLimit">@L["Change limit"]</MudButton>
</MudPaper>
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Suspend or activate account"]</h2>
    <MudTextField T="string" Label="@L["Account name"].Value" @bind-Value="suspensionUsername" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <label>@L["Action"]</label><MudSelect T="string" @bind-Value="suspend" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="string" Value='@("true")'>@L["Suspend"]</MudSelectItem><MudSelectItem T="string" Value='@("false")'>@L["Activate"]</MudSelectItem></MudSelect>
    <MudTextField T="string" Label="@L["Enter the account name to confirm"].Value" @bind-Value="suspensionConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(suspensionUsername) || suspensionConfirmation != suspensionUsername)" OnClick="SetSuspended">@L["Change account status"]</MudButton>
</MudPaper>
@if (result is not null) { <p role="status">@result</p> }

@code {
    [Parameter] public string Kind { get; set; } = "user";
    private string username = "", email = "", domain = "", package = "", ip = "shared";
    private string password = "", passwordConfirmation = "";
    private string deleteUsername = "", deleteConfirmation = "";
    private string limitUsername = "", limitField = "bandwidth", limitValue = "", limitConfirmation = "";
    private string packageUsername = "", newPackage = "", packageConfirmation = "";
    private string suspensionUsername = "", suspensionConfirmation = "", suspend = "true";
    private bool busy;
    private string? result;

    private async Task ChangePackage()
    {
        if (busy || !Session.Connected || Kind != "user" ||
            packageUsername != packageConfirmation) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.SetUserPackageAsync(packageUsername, newPackage);
            result = status == 200
                ? L["DirectAdmin confirmed the new user package."].Value
                : L["Package change not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { busy = false; packageConfirmation = ""; }
    }

    private async Task SetLimit()
    {
        if (busy || !Session.Connected || limitUsername != limitConfirmation) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.SetAccountLimitAsync(
                Kind, limitUsername, limitField, limitValue);
            result = status == 200
                ? L["DirectAdmin confirmed the new limit."].Value
                : L["Limit not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { busy = false; limitConfirmation = ""; }
    }

    private async Task SetSuspended()
    {
        if (busy || !Session.Connected || suspensionUsername != suspensionConfirmation) return;
        busy = true; result = null;
        try
        {
            var desired = suspend == "true";
            var (status, _) = await Session.SetAccountSuspensionAsync(
                suspensionUsername, desired);
            result = status == 200
                ? (desired ? L["DirectAdmin confirms: account suspended."].Value :
                    L["DirectAdmin confirms: account activated."].Value)
                : L["Status change not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { busy = false; suspensionConfirmation = ""; }
    }

    private async Task Create()
    {
        if (busy || !Session.Connected || password != passwordConfirmation || password.Length < 5) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.CreateHostingAccountAsync(
                Kind, username, email, password, domain, package, ip);
            result = status is >= 200 and < 300
                ? L["DirectAdmin created account '{0}'.", username].Value
                : L["Account not created: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { password = ""; passwordConfirmation = ""; busy = false; }
    }
    private bool deleteDialogOpen;
  private async Task ConfirmDeletion()
  {
      if (busy || !Session.Connected || deleteDialogOpen || string.IsNullOrWhiteSpace(deleteUsername)) return;
      var target = deleteUsername;
      var identity = Session.Username;
      var kind = Kind;
      deleteDialogOpen = true;
      try
      {
          var parameters = new DialogParameters<DestructiveResourceDialog>
          {
              { x => x.ResourceName, target },
              { x => x.Warning, L["This deletes an account through DirectAdmin. Enter the exact account name to confirm."].Value },
              { x => x.Prompt, L["Confirm account name"].Value }
          };
          var reference = await Dialogs.ShowAsync<DestructiveResourceDialog>(
              $"{L["Delete account"]}: {target}", parameters,
              new DialogOptions { CloseOnEscapeKey = true, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
          var result = await reference.Result;
          if (result is { Canceled: false, Data: true } && Session.Connected &&
              string.Equals(identity, Session.Username, StringComparison.Ordinal) &&
              string.Equals(target, deleteUsername, StringComparison.Ordinal) && kind == Kind)
          {
              deleteConfirmation = target;
              try { await Delete(); }
              finally { deleteConfirmation = ""; }
          }
      }
      finally { deleteDialogOpen = false; }
  }

  private async Task Delete()
    {
        if (busy || !Session.Connected || deleteUsername != deleteConfirmation) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.DeleteHostingAccountAsync(
                Kind, deleteUsername, deleteConfirmation);
            result = status is >= 200 and < 300
                ? L["DirectAdmin confirmed deletion of '{0}'.", deleteUsername].Value
                : L["Deletion not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { deleteConfirmation = ""; busy = false; }
    }
}
