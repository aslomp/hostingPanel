@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using System.Text.Json
@inject DirectAdminSession Session

<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@(Kind == "reseller" ? L["Create reseller"].Value : L["Create user"].Value)</h2>
    <p>@L["DirectAdmin validates the package, IP address and permissions of the signed-in identity."]</p>
    <label>@L["Account name"]</label><input @bind="username" autocomplete="off" />
    <label>@L["Email address"]</label><input type="email" @bind="email" autocomplete="off" />
    <label>@L["Primary domain"]</label><input @bind="domain" placeholder="example.com" />
    <label>@L["Package"]</label><input @bind="package" autocomplete="off" />
    <label>@L["IP / assignment"]</label><input @bind="ip" placeholder="shared" />
    <label>@L["New password"]</label><input type="password" @bind="password" autocomplete="new-password" />
    <label>@L["Confirm password"]</label><input type="password" @bind="passwordConfirmation" autocomplete="new-password" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(package) || password != passwordConfirmation || password.Length < 5)" OnClick="Create">
        @(busy ? L["Processing…"].Value : L["Create account"].Value)
    </MudButton>
</MudPaper>
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@(Kind == "reseller" ? L["Delete reseller"].Value : L["Delete user"].Value)</h2>
    <p>@L["This deletes an account through DirectAdmin. Enter the exact account name to confirm."]</p>
    <label>@L["Account name"]</label><input @bind="deleteUsername" />
    <label>@L["Confirm account name"]</label><input @bind="deleteConfirmation" />
    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(busy || string.IsNullOrWhiteSpace(deleteUsername) || deleteUsername != deleteConfirmation)" OnClick="Delete">@L["Delete account"]</MudButton>
</MudPaper>
@if (Kind == "user")
{
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Change user package"]</h2>
    <p>@L["The package must exist on the backend. The change is verified against the user configuration after saving."]</p>
    <label>@L["Username"]</label><input @bind="packageUsername" />
    <label>@L["New package"]</label><input @bind="newPackage" />
    <label>@L["Enter the username to confirm"]</label><input @bind="packageConfirmation" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(packageUsername) || packageConfirmation != packageUsername)" OnClick="ChangePackage">@L["Change package"]</MudButton>
</MudPaper>
}
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Change account limit"]</h2>
    <p>@L["Changes only one limit. DirectAdmin then applies its own package and limit rules."]</p>
    <label>@L["Account name"]</label><input @bind="limitUsername" />
    <label>@L["Limit"]</label>
    <select @bind="limitField"><option value="bandwidth">@L["Bandwidth (MB)"]</option><option value="quota">@L["Disk space (MB)"]</option><option value="inode">Inodes</option></select>
    <label>@L["New limit (number)"]</label><input @bind="limitValue" />
    <label>@L["Enter the account name to confirm"]</label><input @bind="limitConfirmation" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(limitUsername) || limitConfirmation != limitUsername)" OnClick="SetLimit">@L["Change limit"]</MudButton>
</MudPaper>
<MudPaper Class="pa-4 my-3" Elevation="1">
    <h2>@L["Suspend or activate account"]</h2>
    <label>@L["Account name"]</label><input @bind="suspensionUsername" />
    <label>@L["Action"]</label><select @bind="suspend"><option value="true">@L["Suspend"]</option><option value="false">@L["Activate"]</option></select>
    <label>@L["Enter the account name to confirm"]</label><input @bind="suspensionConfirmation" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(suspensionUsername) || suspensionConfirmation != suspensionUsername)" OnClick="SetSuspended">@L["Change account status"]</MudButton>
</MudPaper>
@if (result is not null) { <p role="status">@result</p> }

@code {
    [Parameter] public string Kind { get; set; } = "user";
    private string username = "", email = "", domain = "", package = "", ip = "shared";
    private string password = "", passwordConfirmation = "";
    private string deleteUsername = "", deleteConfirmation = "";
    private string limitUsername = "", limitField = "bandwidth", limitValue = "", limitConfirmation = "";
    private string packageUsername = "", newPackage = "", packageConfirmation = "";
    private string suspensionUsername = "", suspensionConfirmation = "", suspend = "true";
    private bool busy;
    private string? result;

    private async Task ChangePackage()
    {
        if (busy || !Session.Connected || Kind != "user" ||
            packageUsername != packageConfirmation) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.SetUserPackageAsync(packageUsername, newPackage);
            result = status == 200
                ? L["DirectAdmin confirmed the new user package."].Value
                : L["Package change not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { busy = false; packageConfirmation = ""; }
    }

    private async Task SetLimit()
    {
        if (busy || !Session.Connected || limitUsername != limitConfirmation) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.SetAccountLimitAsync(
                Kind, limitUsername, limitField, limitValue);
            result = status == 200
                ? L["DirectAdmin confirmed the new limit."].Value
                : L["Limit not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { busy = false; limitConfirmation = ""; }
    }

    private async Task SetSuspended()
    {
        if (busy || !Session.Connected || suspensionUsername != suspensionConfirmation) return;
        busy = true; result = null;
        try
        {
            var desired = suspend == "true";
            var (status, _) = await Session.SetAccountSuspensionAsync(
                suspensionUsername, desired);
            result = status == 200
                ? (desired ? L["DirectAdmin confirms: account suspended."].Value :
                    L["DirectAdmin confirms: account activated."].Value)
                : L["Status change not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { busy = false; suspensionConfirmation = ""; }
    }

    private async Task Create()
    {
        if (busy || !Session.Connected || password != passwordConfirmation || password.Length < 5) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.CreateHostingAccountAsync(
                Kind, username, email, password, domain, package, ip);
            result = status is >= 200 and < 300
                ? L["DirectAdmin created account '{0}'.", username].Value
                : L["Account not created: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { password = ""; passwordConfirmation = ""; busy = false; }
    }
    private async Task Delete()
    {
        if (busy || !Session.Connected || deleteUsername != deleteConfirmation) return;
        busy = true; result = null;
        try
        {
            var (status, _) = await Session.DeleteHostingAccountAsync(
                Kind, deleteUsername, deleteConfirmation);
            result = status is >= 200 and < 300
                ? L["DirectAdmin confirmed deletion of '{0}'.", deleteUsername].Value
                : L["Deletion not confirmed: backend HTTP {0}.", status].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { result = ex.Message; }
        finally { deleteConfirmation = ""; busy = false; }
    }
}
