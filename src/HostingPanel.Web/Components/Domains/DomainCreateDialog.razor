@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using HostingPanel.Api.Services
@inject PanelSession Session
@inject DomainOperations DomainOps

<MudDialog>
    <DialogContent>
        <p>@L["Create a website for the signed-in account."]</p>
        <MudForm @ref="createForm">
        <MudTextField T="string" Disabled="@busy" @bind-Value="testDomain" Label="@L["Domain name"].Value" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="newDomain" Placeholder="example.com" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudCheckBox T="bool" Disabled="@busy" @bind-Value="php" Label="PHP" />
            <MudCheckBox T="bool" Disabled="@busy" @bind-Value="ssl" Label="SSL" />
            <MudCheckBox T="bool" Disabled="@busy" @bind-Value="cgi" Label="CGI" />
        </MudStack>

        </MudForm>
        @if (error is not null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@busy" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(testDomain))" OnClick="Create">@L["Add domain"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private MudForm createForm = default!;
    private string testDomain = "";
    private bool php = true, ssl = true, cgi, busy;
    private string? error;

    private void Cancel() { if (!busy) Dialog.Cancel(); }
    private async Task Create()
    {
        if (busy || !Session.Connected) return;
        busy = true; error = null;
        try
        {
            await createForm.ValidateAsync();
            if (!createForm.IsValid || !Session.Connected || string.IsNullOrWhiteSpace(testDomain)) return;
            var domain = testDomain.Trim().ToLowerInvariant();
            var (status, errorCode) = await DomainOps.MutateAsync(new DomainMutationRequest(domain, "create", domain, php, ssl, cgi));
            if (errorCode is null && status is >= 200 and < 300) { Dialog.Close(DialogResult.Ok(status)); return; }
            error = status switch
            {
                409 => L["The backend reported a conflict for this domain operation."].Value,
                400 => L["Invalid domain or settings."].Value,
                _ => L["Domain operation failed: HTTP {0}.", status].Value
            };
            if (errorCode is not null) error += " " + errorCode;
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException or InvalidOperationException)
        { error = ex.Message; }
        finally { busy = false; }
    }
}
