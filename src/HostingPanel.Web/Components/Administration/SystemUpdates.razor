@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/system-updates"
@inject PanelSession Session
@inject SystemUpdateOperations UpdateOps
@implements IDisposable
<PageTitle>@L["System updates — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management"]</Breadcrumb>
    <TitleContent>@L["System packages"]</TitleContent>
    <Description>@L["Available updates and update history directly from the backend."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected) { <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper> }
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1"><h2>@L["Available upgrades"]</h2><JsonOverview Json="@updates" /></MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1"><h2>@L["Update history"]</h2><JsonOverview Json="@history" /></MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Check updates"]</h2><p>@L["Run the DirectAdmin update check without installing packages."]</p>
        <label>@L["Packages (comma-separated, blank means all updates)"]</label>
        <MudTextField T="string" @bind-Value="selectedPackages" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="openssl, nginx" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Check">@L["Start update test"]</MudButton>
        <h2>@L["Run update"]</h2>
        <p>@L["This can change system software. Explicit confirmation is required."]</p>
        <label>@L["Enter UPDATE to confirm"]</label><MudTextField T="string" @bind-Value="confirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button class="primary" disabled="@(busy || confirmation != "UPDATE")" @onclick="Run">@L["Start updates"]</button>
        @if (feedback is not null) { <p role="status">@feedback</p> }
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Update transaction log"]</h2>
        <label>@L["Transaction ID from update history"]</label><MudTextField T="string" @bind-Value="transactionId" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy || string.IsNullOrWhiteSpace(transactionId))" OnClick="FetchLog">@L["Retrieve log"]</MudButton>
        <JsonOverview Json="@transactionLog" />
    </MudPaper>
    @if (busy) { <PanelLoading>@L["Processing…"]</PanelLoading> }
}
@code {
    private string updates = "", history = "", confirmation = "";
    private string selectedPackages = "", transactionId = "", transactionLog = "";
    private string? feedback;
    private readonly LatestRead inventoryRead = new();
    private readonly LatestRead logRead = new();
    private readonly DialogMutation mutation = new();
    private bool disposed;
    private bool busy => inventoryRead.Loading || logRead.Loading || mutation.Busy;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += SessionChanged;
        await Load();
    }

    private void SessionChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        logRead.Cancel();
        updates = history = transactionLog = transactionId = selectedPackages = confirmation = "";
        feedback = null;
        var task = Load();
        StateHasChanged();
        await task;
        if (!disposed) StateHasChanged();
    });

    public void Dispose()
    {
        disposed = true;
        Session.Changed -= SessionChanged;
        inventoryRead.Dispose();
        logRead.Dispose();
        mutation.Dispose();
    }

    private Task Load()
    {
        if (disposed) return Task.CompletedTask;
        updates = history = "";
        feedback = null;
        if (!Session.Connected)
        {
            inventoryRead.Cancel();
            return Task.CompletedTask;
        }
        var channel = Session.TicketChannel;
        bool Current() => !disposed && Session.Connected && Session.TicketChannel == channel;
        return inventoryRead.RunPairAsync(UpdateOps.ListUpdatesAsync, UpdateOps.HistoryAsync,
            Current, response =>
        {
            updates = OperationFeedback.FormatRead(response.First);
            history = OperationFeedback.FormatRead(response.Second);
        }, ex => feedback = ex.Message);
    }

    private Task FetchLog()
    {
        if (disposed || busy || !Session.Connected) return Task.CompletedTask;
        if (!SystemUpdateOperations.ValidTransaction(transactionId))
        {
            feedback = L["Invalid transaction ID."].Value;
            return Task.CompletedTask;
        }
        var target = transactionId;
        var channel = Session.TicketChannel;
        transactionLog = "";
        feedback = null;
        return logRead.RunAsync(ct => UpdateOps.LogAsync(target, ct),
            () => Session.Connected && Session.TicketChannel == channel && transactionId == target,
            response => transactionLog = OperationFeedback.FormatRead(response),
            ex => feedback = ex.Message);
    }

    private Task Check() => Submit(false);
    private Task Run() => confirmation == "UPDATE" ? Submit(true) : Task.CompletedTask;

    private async Task Submit(bool install)
    {
        if (disposed || busy || !Session.Connected || (install && confirmation != "UPDATE")) return;
        var channel = Session.TicketChannel;
        var packages = selectedPackages.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        feedback = null;
        await mutation.RunAsync(Session, channel, async current =>
        {
            if (!SystemUpdateOperations.ValidPackages(packages))
            {
                if (current()) feedback = L["Invalid package name."].Value;
                return;
            }
            var (status, body) = install
                ? await UpdateOps.RunAsync(packages)
                : await UpdateOps.CheckAsync(packages);
            if (current()) feedback = OperationFeedback.FormatMutation((status, body));
        });
        if (!disposed && Session.Connected && Session.TicketChannel == channel)
        {
            feedback ??= mutation.Error;
            confirmation = "";
        }
    }
}
