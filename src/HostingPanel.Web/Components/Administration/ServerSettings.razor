@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/server-settings"
@using System.Text.Json
@inject PanelSession Session
@inject ServerSettingsOperations SettingsOps
@implements IDisposable
<PageTitle>@L["Server settings — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management"]</Breadcrumb>
    <TitleContent>@L["Server settings"]</TitleContent>
    <Description>@L["DirectAdmin configuration and server settings through the official API."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected) { <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper> }
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Configuration source"]</h2>
        <MudSelect T="ServerSettingsSection" @bind-Value="section" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="ServerSettingsSection" Value="@ServerSettingsSection.Active">@L["Active DirectAdmin configuration"]</MudSelectItem>
            <MudSelectItem T="ServerSettingsSection" Value="@ServerSettingsSection.Defaults">@L["Default configuration"]</MudSelectItem>
            <MudSelectItem T="ServerSettingsSection" Value="@ServerSettingsSection.Local">@L["Local overrides"]</MudSelectItem>
            <MudSelectItem T="ServerSettingsSection" Value="@ServerSettingsSection.Database">@L["Database connection"]</MudSelectItem>
            <MudSelectItem T="ServerSettingsSection" Value="@ServerSettingsSection.Email">@L["Email server configuration"]</MudSelectItem>
            <MudSelectItem T="ServerSettingsSection" Value="@ServerSettingsSection.OutboundFilter">@L["Outbound mail filter"]</MudSelectItem>
            <MudSelectItem T="ServerSettingsSection" Value="@ServerSettingsSection.Timezone">@L["Time zone"]</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Retrieve configuration"]</MudButton>
        <p>@message</p>
        <JsonOverview Json="@result" />
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Modify local DirectAdmin overrides"]</h2>
        <p>@L["This PATCH uses only"] <code>/api/server-settings/directadmin-conf/local</code>@L[". Specify only fields you want to change."]</p>
        <MudTextField T="string" @bind-Value="patch" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="{}" Lines="10" spellcheck="false" />
        <label>@L["Enter PATCH to confirm"]</label><MudTextField T="string" @bind-Value="confirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button class="primary" disabled="@(busy || confirmation != "PATCH")" @onclick="Apply">@L["Apply patch"]</button>
        @if (mutation is not null) { <p role="status">@mutation</p> }
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Test or change database connection"]</h2>
        <p>@L["Complete the official DirectAdmin database configuration contract. A test does not save settings."]</p>
        <MudTextField T="string" @bind-Value="dbConfigJson" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Lines="10" spellcheck="false" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="TestDatabaseConfig">@L["Test connection"]</MudButton>
        <label>@L["Enter SAVE DB to replace database configuration"]</label>
        <MudTextField T="string" @bind-Value="dbConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button disabled="@(busy || dbConfirmation != "SAVE DB")" @onclick="SaveDatabaseConfig">@L["Save database configuration"]</button>
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Change server hostname"]</h2>
        <label>@L["New hostname"]</label><MudTextField T="string" @bind-Value="hostname" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="server.example.com" />
        <label>@L["Enter HOSTNAME to confirm"]</label><MudTextField T="string" @bind-Value="hostnameConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button disabled="@(busy || string.IsNullOrWhiteSpace(hostname) || hostnameConfirmation != "HOSTNAME")" @onclick="ChangeHostname">@L["Change hostname"]</button>
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Change time zone"]</h2>
        <label>@L["Time zone (IANA)"]</label><MudTextField T="string" @bind-Value="timezone" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="Europe/Amsterdam" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="ListTimezones">@L["Retrieve available time zones"]</MudButton>
        <JsonOverview Json="@timezones" />
        <label>@L["Enter TIMEZONE to confirm"]</label><MudTextField T="string" @bind-Value="timezoneConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button disabled="@(busy || string.IsNullOrWhiteSpace(timezone) || timezoneConfirmation != "TIMEZONE")" @onclick="ChangeTimezone">@L["Change time zone"]</button>
    </MudPaper>
}
@code {
    private ServerSettingsSection section = ServerSettingsSection.Active;
    private string patch = "{}", confirmation = "", result = "";
    private string hostname = "", hostnameConfirmation = "", timezone = "", timezoneConfirmation = "", timezones = "";
    private string dbConfigJson = "", dbConfirmation = "";
    private string? message, mutation;
    private readonly LatestRead read = new();
    private readonly DialogMutation write = new();
    private bool disposed;
    private bool busy => read.Loading || write.Busy;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += SessionChanged;
        await Load();
    }

    private void SessionChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        read.Cancel();
        result = dbConfigJson = timezones = hostname = timezone = "";
        confirmation = dbConfirmation = hostnameConfirmation = timezoneConfirmation = "";
        patch = "{}";
        message = mutation = null;
        var task = Load();
        StateHasChanged();
        await task;
        if (!disposed) StateHasChanged();
    });

    public void Dispose()
    {
        disposed = true;
        Session.Changed -= SessionChanged;
        read.Dispose();
        write.Dispose();
    }

    private Task Load()
    {
        if (disposed) return Task.CompletedTask;
        result = "";
        message = null;
        if (!Session.Connected)
        {
            read.Cancel();
            return Task.CompletedTask;
        }
        var channel = Session.TicketChannel;
        var target = section;
        return read.RunAsync(ct => SettingsOps.ReadAsync(target, ct),
            () => Session.Connected && Session.TicketChannel == channel && section == target,
            response =>
            {
                message = $"HTTP {response.Status}";
                result = response.Body;
                if (target == ServerSettingsSection.Database && response.Status == 200)
                    dbConfigJson = response.Body;
            }, ex => message = ex.Message);
    }

    private Task ListTimezones()
    {
        if (disposed || busy || !Session.Connected) return Task.CompletedTask;
        var channel = Session.TicketChannel;
        timezones = "";
        mutation = null;
        return read.RunAsync(ct => SettingsOps.ListTimezonesAsync(ct),
            () => Session.Connected && Session.TicketChannel == channel,
            response => timezones = $"HTTP {response.Status}\n{response.Body}",
            ex => mutation = ex.Message);
    }

    private async Task RunMutation(Func<Task<string>> operation, Action? clearConfirmation = null)
    {
        if (disposed || busy || !Session.Connected) return;
        var channel = Session.TicketChannel;
        mutation = null;
        await write.RunAsync(Session, channel, async current =>
        {
            try
            {
                var feedback = await operation();
                if (current()) mutation = feedback;
            }
            catch (JsonException ex)
            {
                if (current()) mutation = ex.Message;
            }
        });
        if (!disposed && Session.Connected && Session.TicketChannel == channel)
        {
            mutation ??= write.Error;
            clearConfirmation?.Invoke();
        }
    }

    private Task TestDatabaseConfig() => RunMutation(async () =>
    {
        if (!ServerSettingsOperations.ValidDatabaseConfig(dbConfigJson))
            return L["The database configuration contract is incomplete."].Value;
        var (status, body) = await SettingsOps.TestDatabaseAsync(dbConfigJson);
        return $"Test: backend HTTP {status}. {body}";
    });

    private Task SaveDatabaseConfig() => dbConfirmation != "SAVE DB" ? Task.CompletedTask : RunMutation(async () =>
    {
        if (!ServerSettingsOperations.ValidDatabaseConfig(dbConfigJson))
            return L["The database configuration contract is incomplete."].Value;
        var (status, body) = await SettingsOps.SaveDatabaseAsync(dbConfigJson);
        return L["Save: backend HTTP {0}. {1}", status, body].Value;
    }, () => dbConfirmation = "");

    private Task ChangeHostname() => hostnameConfirmation != "HOSTNAME" || string.IsNullOrWhiteSpace(hostname)
        ? Task.CompletedTask : RunMutation(async () =>
        {
            var (status, body) = await SettingsOps.ChangeHostnameAsync(hostname);
            return $"Backend HTTP {status}: {body}";
        }, () => hostnameConfirmation = "");

    private Task ChangeTimezone() => timezoneConfirmation != "TIMEZONE" || string.IsNullOrWhiteSpace(timezone)
        ? Task.CompletedTask : RunMutation(async () =>
        {
            var (status, body) = await SettingsOps.ChangeTimezoneAsync(timezone);
            return $"Backend HTTP {status}: {body}";
        }, () => timezoneConfirmation = "");

    private Task Apply() => confirmation != "PATCH" ? Task.CompletedTask : RunMutation(async () =>
    {
        if (!ServerSettingsOperations.ValidPatch(patch))
            return L["The patch must be a JSON object."].Value;
        var (status, body) = await SettingsOps.PatchAsync(patch);
        return $"Backend HTTP {status}: {body}";
    }, () => confirmation = "");
}
