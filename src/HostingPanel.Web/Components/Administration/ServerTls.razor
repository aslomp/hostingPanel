@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/server-tls"
@using System.Text.Json
@inject PanelSession Session
@inject CompatibilityApiClient ApiClient
<PageTitle>Server TLS — HostingPanel</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management"]</Breadcrumb>
    <TitleContent>Server TLS</TitleContent>
    <Description>@L["Certificate status and ACME configuration for the DirectAdmin server."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected) { <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper> }
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1"><h2>@L["Certificate status"]</h2><JsonOverview Json="@status" /></MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1"><h2>@L["ACME settings"]</h2><JsonOverview Json="@acme" /></MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1"><h2>@L["Certificate information"]</h2><JsonOverview Json="@certificate" /></MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Change ACME configuration"]</h2>
        <p>@L["The configuration may contain sensitive DNS provider settings. Only the backend determines whether saving is permitted."]</p>
        <MudTextField T="string" @bind-Value="acmeJson" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Lines="10" spellcheck="false" />
        <label>@L["Enter ACME to confirm changes"]</label><MudTextField T="string" @bind-Value="acmeConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button disabled="@(busy || acmeConfirmation != "ACME")" @onclick="SaveAcme">@L["Save ACME configuration"]</button>
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Obtain certificate"]</h2>
        <p>@L["Requesting a new server certificate is a backend operation and may change server configuration."]</p>
        <label>@L["Enter OBTAIN to confirm"]</label><MudTextField T="string" @bind-Value="confirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <button class="primary" disabled="@(busy || confirmation != "OBTAIN")" @onclick="Obtain">@L["Request certificate"]</button>
        @if (feedback is not null) { <p role="status">@feedback</p> }
    </MudPaper>
}
@code {
    private string status = "", acme = "", certificate = "", confirmation = "", acmeJson = "", acmeConfirmation = "";
    private string? feedback;
    private bool busy;
    protected override async Task OnInitializedAsync() { if (Session.Connected) await Load(); }
    private async Task Load()
    {
        if (busy || !Session.Connected) return;
        busy = true;
        try
        {
            var (s,b) = await ApiClient.GetRawAsync("api/server-tls/status");
            status = $"HTTP {s}\n{b}";
            var (a,c) = await ApiClient.GetRawAsync("api/server-tls/acme-config");
            acme = $"HTTP {a}\n{c}";
            var (d,e) = await ApiClient.GetRawAsync("api/server-tls/certificate");
            certificate = $"HTTP {d}\n{e}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { feedback = ex.Message; }
        finally { busy = false; }
    }
    private async Task SaveAcme()
    {
        if (busy || !Session.Connected || acmeConfirmation != "ACME") return;
        busy = true; feedback = null;
        try
        {
            using var json = JsonDocument.Parse(acmeJson);
            if (json.RootElement.ValueKind != JsonValueKind.Object ||
                !new[] { "account", "additionalDomains", "dnsEnvironment", "dnsProvider", "enabled", "keyType", "provider" }
                    .All(key => json.RootElement.TryGetProperty(key, out _)))
            { feedback = L["ACME JSON is missing one or more required contract fields."].Value; return; }
            var (status, body) = await ApiClient.RequestApiAsync(HttpMethod.Put,
                "api/server-tls/acme-config", acmeJson);
            feedback = $"Backend HTTP {status}: {body}";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        { feedback = ex.Message; }
        finally { busy = false; acmeConfirmation = ""; }
    }
    private async Task Obtain()
    {
        if (busy || confirmation != "OBTAIN") return;
        busy = true; feedback = null;
        try
        {
            var (s, b) = await ApiClient.RequestApiAsync(HttpMethod.Post, "api/server-tls/obtain");
            feedback = $"Backend HTTP {s}: {b}";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { feedback = ex.Message; }
        finally { busy = false; confirmation = ""; }
    }
}
