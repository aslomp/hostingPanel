@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/system-info"
@inject PanelSession Session
@inject SystemInformationOperations SystemInfoOps
@implements IDisposable
<PageTitle>@L["System information — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management"]</Breadcrumb>
    <TitleContent>@L["System information"]</TitleContent>
    <Description>@L["Live information from the connected backend."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Refresh">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected) { <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper> }
else
{
    @if (busy) { <PanelLoading>@L["Retrieving system information…"]</PanelLoading> }
    @if (error is not null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
    <MudGrid Spacing="3">
        @foreach (var item in checks)
        {
            <MudItem xs="12" md="6"><MudPaper Class="pa-4 my-3" Elevation="1">
                <h2>@L[item.LabelKey]</h2><p>HTTP @item.Status</p>
                <JsonOverview Json="@item.Body" />
            </MudPaper></MudItem>
        }
    </MudGrid>
}
@code {
    private IReadOnlyList<SystemInformationSection> checks = [];
    private readonly LatestRead read = new();
    private bool busy => read.Loading;
    private bool disposed;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += SessionChanged;
        await Refresh();
    }

    private void SessionChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        var task = Refresh();
        StateHasChanged();
        await task;
        if (!disposed) StateHasChanged();
    });

    public void Dispose()
    {
        disposed = true;
        Session.Changed -= SessionChanged;
        read.Dispose();
    }

    private Task Refresh()
    {
        if (disposed) return Task.CompletedTask;
        checks = [];
        error = null;
        if (!Session.Connected)
        {
            read.Cancel();
            return Task.CompletedTask;
        }
        var channel = Session.TicketChannel;
        return read.RunAsync(ct => SystemInfoOps.ReadAsync(ct),
            () => Session.Connected && Session.TicketChannel == channel,
            result => checks = result, ex => error = ex.Message);
    }
}
