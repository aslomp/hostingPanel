@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/system-services"
@inject PanelSession Session
@inject SystemServiceOperations ServiceOps
@implements IDisposable
<PageTitle>@L["System services — HostingPanel"]</PageTitle>
<PanelPageHeader>
    <Breadcrumb>@L["Server management"]</Breadcrumb>
    <TitleContent>System Services</TitleContent>
    <Description>@L["Live service list, details and management actions; the backend determines which operations are permitted."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Load">@L["Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected) { <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper> }
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>Services</h2>
        @if (busy) { <PanelLoading>@L["Retrieving…"]</PanelLoading> }
        @if (error is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
        <JsonOverview Json="@services" />
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Inspect service"]</h2>
        <label>@L["Service name"]</label>
        <MudTextField T="string" @bind-Value="service" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="@L["for example nginx"].Value" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="Details">@L["Retrieve details and log"]</MudButton>
        <h3>@L["Service details"]</h3><JsonOverview Json="@details" /><h3>@L["Service log"]</h3><JsonOverview Json="@serviceLog" />
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Manage service"]</h2>
        <p>@L["Select a service and an exact management action. No actions are hidden based on a local user role."]</p>
        <MudSelect T="string" @bind-Value="action" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="string" Value='@("restart")'>Restart</MudSelectItem><MudSelectItem T="string" Value='@("reload")'>Reload</MudSelectItem><MudSelectItem T="string" Value='@("start")'>Start</MudSelectItem><MudSelectItem T="string" Value='@("stop")'>Stop</MudSelectItem></MudSelect>
        <label>@L["Enter the service name to confirm the action"]</label><MudTextField T="string" @bind-Value="confirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(service) || confirmation != service)" OnClick="Execute">@L["Execute action"]</MudButton>
        @if (outcome is not null) { <p role="status">@outcome</p> }
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>@L["Service watchdog"]</h2>
        <p>@L["Configure whether DirectAdmin monitors the selected service."]</p>
        <label>Watchdog</label>
        <MudSelect T="string" @bind-Value="watchdog" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="string" Value='@("true")'>@L["Enable"]</MudSelectItem><MudSelectItem T="string" Value='@("false")'>@L["Disable"]</MudSelectItem></MudSelect>
        <label>@L["Enter the service name to confirm"]</label><MudTextField T="string" @bind-Value="watchdogConfirmation" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy || !ValidService(service) || watchdogConfirmation != service)" OnClick="SetWatchdog">@L["Update watchdog"]</MudButton>
    </MudPaper>
}
@code {
    private string service = "", action = "restart", confirmation = "";
    private string watchdog = "true", watchdogConfirmation = "";
    private string services = "", details = "", serviceLog = "";
    private string? error, outcome;
    private readonly LatestRead listRead = new();
    private readonly LatestRead detailRead = new();
    private readonly DialogMutation mutation = new();
    private bool disposed;
    private bool busy => listRead.Loading || detailRead.Loading || mutation.Busy;
    private static bool ValidService(string value) => SystemServiceOperations.ValidService(value);

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += SessionChanged;
        await Load();
    }

    private void SessionChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        detailRead.Cancel();
        services = details = serviceLog = service = confirmation = watchdogConfirmation = "";
        error = outcome = null;
        var task = Load();
        StateHasChanged();
        await task;
        if (!disposed) StateHasChanged();
    });

    public void Dispose()
    {
        disposed = true;
        Session.Changed -= SessionChanged;
        listRead.Dispose();
        detailRead.Dispose();
        mutation.Dispose();
    }

    private Task Load()
    {
        if (disposed) return Task.CompletedTask;
        services = "";
        error = null;
        if (!Session.Connected)
        {
            listRead.Cancel();
            return Task.CompletedTask;
        }
        var channel = Session.TicketChannel;
        return listRead.RunAsync(ct => ServiceOps.ListAsync(ct),
            () => Session.Connected && Session.TicketChannel == channel,
            result =>
            {
                services = $"HTTP {result.Status}\n{result.Body}";
                if (result.Status is < 200 or >= 300)
                    error = L["Backend did not return the overview (HTTP {0}).", result.Status].Value;
            }, ex => error = ex.Message);
    }

    private Task Details()
    {
        if (disposed || busy || !Session.Connected) return Task.CompletedTask;
        if (!ValidService(service))
        {
            error = L["Invalid service name."].Value;
            return Task.CompletedTask;
        }
        var target = service;
        var channel = Session.TicketChannel;
        details = serviceLog = "";
        error = null;
        bool Current() => !disposed && Session.Connected &&
            Session.TicketChannel == channel && service == target;
        return detailRead.RunPairAsync(ct => ServiceOps.DetailsAsync(target, ct),
            ct => ServiceOps.LogAsync(target, ct), Current, result =>
        {
            details = $"HTTP {result.First.Status}\n{result.First.Body}";
            serviceLog = $"HTTP {result.Second.Status}\n{result.Second.Body}";
        }, ex => error = ex.Message);
    }

    private async Task SetWatchdog()
    {
        if (disposed || busy || !ValidService(service) || watchdogConfirmation != service || !Session.Connected) return;
        var target = service;
        var channel = Session.TicketChannel;
        var enabled = watchdog == "true";
        outcome = null;
        await mutation.RunAsync(Session, channel, async current =>
        {
            var (status, body) = await ServiceOps.SetWatchdogAsync(target, enabled);
            if (!current() || service != target) return;
            outcome = status == 204 ? L["DirectAdmin confirmed the watchdog change."].Value
                : L["Watchdog operation: backend HTTP {0}. {1}", status, body].Value;
        });
        if (!disposed && Session.Connected && Session.TicketChannel == channel && service == target)
        {
            outcome ??= mutation.Error;
            watchdogConfirmation = "";
        }
    }

    private async Task Execute()
    {
        if (disposed || busy || !Session.Connected || !ValidService(service) || confirmation != service ||
            action is not ("restart" or "reload" or "start" or "stop")) return;
        var target = service;
        var selectedAction = action;
        var channel = Session.TicketChannel;
        outcome = null;
        await mutation.RunAsync(Session, channel, async current =>
        {
            var (status, body) = await ServiceOps.ExecuteAsync(target, selectedAction);
            if (current() && service == target)
                outcome = L["Action {0}: HTTP {1}. {2}", selectedAction, status, body].Value;
        });
        if (!disposed && Session.Connected && Session.TicketChannel == channel && service == target)
        {
            outcome ??= mutation.Error;
            confirmation = "";
        }
    }
}
