@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/domains/{Domain}/dns"
@using HostingPanel.Api.Services
@using HostingPanel.Api.Adapters
@inject PanelSession Session
@inject DnsOperations Dns
@inject IDialogService Dialogs
@implements IDisposable

<PageTitle>DNS — @Domain</PageTitle>
<PanelPageHeader>
    <Breadcrumb><a href="/domains">@L["Domains"]</a> / <a href="@($"/domains/{Uri.EscapeDataString(Domain)}")">@Domain</a> / DNS</Breadcrumb>
    <TitleContent>@L["DNS management"]</TitleContent>
    <Description>Zone: <strong>@Domain</strong> — @L["Directly from DirectAdmin."]</Description>
    <Actions><MudStack Row="true" Spacing="2"><CrudAddButton Disabled="@(busy || editorOpen || deleteDialogOpen || !Session.Connected)" OnClick="NewRecord">@L["Add DNS record"]</CrudAddButton><MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Load" Disabled="@(busy || editorOpen || deleteDialogOpen)">@L["Refresh"]</MudButton></MudStack></Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <h2>DNS-records</h2>
        @if (error is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
        @if (busy) { <PanelLoading>@L["Loading DNS zone…"]</PanelLoading> }
        @if (records is not null)
        {
            <p>@L["Records found: {0}.", records.Count]</p>
            <MudTextField T="string" @bind-Value="search" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["Search"].Value" />
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead><tr><th>Type</th><th>@L["Name"]</th><th>@L["Value"]</th><th>TTL</th><th>@L["Management"]</th></tr></thead>
                <tbody>
                @foreach (var record in records.Where(r => r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Type.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Value.Contains(search, StringComparison.OrdinalIgnoreCase)).OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Type))
                {
                    <tr>
                        <td>@record.Type</td><td><MudButton Variant="Variant.Text" Disabled="@(busy || editorOpen || deleteDialogOpen)" OnClick="() => Edit(record)">@record.Name</MudButton></td><td>@record.Value</td><td>@record.Ttl</td>
                        <td>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy || editorOpen || deleteDialogOpen)" OnClick="() => Edit(record)">@L["Edit"]</MudButton>
                            <CrudDeleteButton Label="@L["Delete DNS record"].Value" Disabled="@(busy || editorOpen || deleteDialogOpen)" OnClick="() => Remove(record)" />
                        </td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
            @if (records.Count == 0) { <PanelEmptyState>@L["No DNS records found."]</PanelEmptyState> }
        }
    </MudPaper>
    @if (message is not null) { <MudAlert Severity="@(failed ? Severity.Error : Severity.Success)" Class="my-2">@message</MudAlert> }
}
@code {
    [Parameter] public string Domain { get; set; } = "";
    private List<DnsRecord>? records;
    private string? error, message;
    private readonly LatestRead read = new();
    private bool mutating, editorOpen, failed, disposed;
    private bool busy => mutating || read.Loading;
    private string search = "";
    private Task NewRecord() => OpenEditor(null);
    private Task Edit(DnsRecord record) => OpenEditor(record);
    protected override void OnInitialized() => Session.Changed += SessionChanged;
    protected override Task OnParametersSetAsync() => Load();
    private void SessionChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        message = null;
        var task = Load();
        StateHasChanged();
        await task;
        if (!disposed) StateHasChanged();
    });
    public void Dispose()
    {
        disposed = true;
        Session.Changed -= SessionChanged;
        read.Dispose();
    }

    private Task Load()
    {
        if (disposed) return Task.CompletedTask;
        records = null;
        error = null;
        if (!Session.Connected)
        {
            read.Cancel();
            return Task.CompletedTask;
        }
        var target = Domain;
        var channel = Session.TicketChannel;
        return read.RunAsync(ct => Dns.ReadAsync(target, ct),
            () => Session.Connected && Session.TicketChannel == channel && Domain == target,
            result =>
            {
                if (result.Status != 200 || result.Records is null)
                {
                    error = L["DNS zone unavailable: HTTP {0}.", result.Status].Value;
                    if (result.Error is { Length: > 0 and <= 80 } reason && reason.All(c => char.IsAsciiLetterOrDigit(c) || c == '_'))
                        error += $" ({reason})";
                    return;
                }
                records = result.Records.ToList();
            }, ex => error = ex.Message);
    }
    private async Task OpenEditor(DnsRecord? record)
    {
        if (busy || editorOpen || deleteDialogOpen || !Session.Connected) return;
        editorOpen = true; message = null;
        var domain = Domain;
        var channel = Session.TicketChannel;
        try
        {
            var parameters = new DialogParameters<DnsRecordDialog> { { x => x.Domain, domain } };
            if (record is not null)
            {
                parameters.Add(x => x.OriginalType, record.Type);
                parameters.Add(x => x.OriginalName, record.Name);
                parameters.Add(x => x.OriginalValue, record.Value);
                parameters.Add(x => x.OriginalTtl, record.Ttl);
            }
            var dialog = await Dialogs.ShowAsync<DnsRecordDialog>(
                L[record is null ? "Add DNS record" : "Edit DNS record"].Value, parameters,
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false, CloseOnEscapeKey = false });
            var result = await dialog.Result;
            if (result is { Canceled: false } && !disposed && Session.Connected && Session.TicketChannel == channel && domain == Domain)
            {
                failed = false;
                message = L["DNS change request accepted."].Value;
                await Load();
            }
        }
        finally { editorOpen = false; }
    }
    private bool deleteDialogOpen;
    private async Task Remove(DnsRecord r)
    {
        if (busy || editorOpen || deleteDialogOpen || !Session.Connected || records?.Contains(r) != true) return;
        var domain = Domain;
        var channel = Session.TicketChannel;
        var identity = Session.Username;
        deleteDialogOpen = true;
        try
        {
            var confirmed = await Dialogs.ConfirmResourceDeletionAsync(
                $"{L["Delete DNS record"]}: {r.Name}", r.Name,
                L["Permanently delete this DNS record?"].Value,
                L["Exact record name"].Value,
                $"{domain} — {r.Type} {r.Name} {r.Value}");
            if (!confirmed || disposed || busy || !Session.Connected || Session.TicketChannel != channel ||
                !string.Equals(identity, Session.Username, StringComparison.Ordinal) ||
                !string.Equals(domain, Domain, StringComparison.Ordinal) ||
                records?.Contains(r) != true) return;
            mutating = true; message = null;
            try
            {
                var result = await Dns.ChangeAsync(domain, new DnsChange("delete", r, r));
                if (disposed || !Session.Connected || Session.TicketChannel != channel || Domain != domain) return;
                var status = result.Status;
                failed = !result.Executed && !result.ProvisioningPending;
                message = failed ? L["DNS change not confirmed (HTTP {0}).", status].Value
                    : L["DNS change request accepted."].Value;
            }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
            { if (!disposed && Session.Connected && Session.TicketChannel == channel && Domain == domain) { failed = true; message = ex.Message; } }
            finally { mutating = false; }
            if (!failed && !disposed && Session.Connected && Session.TicketChannel == channel && Domain == domain) await Load();
        }
        finally { deleteDialogOpen = false; }
    }
}
