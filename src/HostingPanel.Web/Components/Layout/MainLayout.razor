@using System.Globalization
@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inherits LayoutComponentBase
@implements IDisposable
@inject DirectAdminSession Session
@inject NavigationContextState NavContext
@inject NavigationManager Navigation

<div class="shell">
  <aside class="sidebar" aria-label="@L["Main navigation"]">
    <a class="brand" href="/">◈ <span>HostingPanel<small>CONTROL CENTER</small></span></a>
    <div class="nav-caption">@L["Navigation context"]</div>
    <div class="nav-context-switch" role="group" aria-label="@L["Navigation context"]">
      <button type="button" class="@(NavContext.Mode == "admin" ? "active" : "")"
              aria-pressed="@(NavContext.Mode == "admin")"
              @onclick='() => SetContext("admin")'>@L["Administrator"]</button>
      <button type="button" class="@(NavContext.Mode == "user" ? "active" : "")"
              aria-pressed="@(NavContext.Mode == "user")"
              @onclick='() => SetContext("user")'>@L["User"]</button>
    </div>
    <div class="nav-caption">@(NavContext.Mode == "admin" ? L["Administrator features"].Value : L["User features"].Value)</div>
    <label class="sidebar-search-label" for="hosting-nav-search">@L["Search pages"]</label>
    <input id="hosting-nav-search" class="sidebar-search" type="search"
           placeholder="Search pages..." @bind="navSearch" @bind:event="oninput" />
    <NavLink href="/" Match="NavLinkMatch.All">▦ @L["Dashboard"]</NavLink>
    <nav class="sidebar-scroll" aria-label="@L["Management sections"]">
      @foreach (var navGroup in FilteredSections)
      {
        <details class="nav-section" open>
          <summary><span class="nav-icon" aria-hidden="true">@navGroup.Icon</span>@L[navGroup.Title]</summary>
          <div class="nav-section-items">
            @foreach (var item in navGroup.Items)
            {
              <NavLink href="@item.Path" class="nav-item">
                <span class="nav-icon" aria-hidden="true">@item.Icon</span>
                <span>@L[item.Label]</span>
                @if (!item.Implemented)
                {
                  <span class="nav-pending" title="@L["Not implemented"]" aria-label="@L["Not implemented"]">○</span>
                }
              </NavLink>
            }
          </div>
        </details>
      }
    </nav>
    <p class="nav-note">@L["DirectAdmin-compatible API"]<br />@L["The backend controls access rights."]</p>
  </aside>
  <div class="workspace">
    <header class="topbar">
      <div class="crumb">
        <a href="/">HostingPanel</a><span aria-hidden="true">/</span>
        <strong>@CurrentPage</strong>
      </div>
      <div class="session-identity">
        <form method="get" action="/culture/set" class="culture-picker">
          <label for="ui-culture">@L["Language"]</label>
          <select id="ui-culture" name="culture" aria-label="@L["Language"]" onchange="this.form.submit()">
            <option value="nl-NL" selected="@(CultureInfo.CurrentUICulture.Name == "nl-NL")">Nederlands</option>
            <option value="en-US" selected="@(CultureInfo.CurrentUICulture.Name == "en-US")">English</option>
          </select>
          <input type="hidden" name="returnUrl" value="@(new Uri(Navigation.Uri).PathAndQuery)" />
        </form>
        <TicketNotifications @key="Session.TicketChannel" />
        <span>@(Session.Connected ? L["Connected account"].Value : L["Backend disconnected"].Value)
          <strong>@(Session.Connected ? Session.Username : L["Not signed in"].Value)</strong>
        </span>
        <span class="session-avatar" aria-hidden="true">@(Session.Connected ? Session.Username[..Math.Min(2,Session.Username.Length)].ToUpperInvariant() : "HP")</span>
      </div>
    </header>
    @if (Session.IsImpersonating)
    {
      <div class="impersonation-banner" role="status">
        <span><strong>@L["Impersonation active:"]</strong> @L["you are acting as"] <strong>@Session.Username</strong>
        @L["on behalf of administrator"] <strong>@Session.OriginalUsername</strong>.</span>
        <button @onclick="ReturnToAdministrator">@L["Return to administrator"]</button>
      </div>
    }
    <main class="content">@Body</main>
  </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        NavContext.Changed += OnSessionChanged;
    }
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        NavContext.Changed -= OnSessionChanged;
    }

    private string navSearch = "";
    private void SetContext(string value)
    {
        NavContext.Select(value);
        navSearch = "";
    }
    private string CurrentPage
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0].Trim('/');
            if (string.IsNullOrWhiteSpace(path)) return L["Dashboard"].Value;
            var item = AllSections.SelectMany(navSection => navSection.Items)
                .FirstOrDefault(link => link.Path.Trim('/').Equals(path, StringComparison.OrdinalIgnoreCase));
            return item is null ? path.Split('/')[0].Replace('-', ' ') : L[item.Label].Value;
        }
    }
    private IEnumerable<NavSection> CurrentSections =>
        NavContext.Mode == "user" ? UserSections : AdminSections;
    private IEnumerable<NavSection> FilteredSections => string.IsNullOrWhiteSpace(navSearch)
        ? CurrentSections
        : CurrentSections.Select(section => section with {
            Items = L[section.Title].Value.Contains(navSearch, StringComparison.OrdinalIgnoreCase)
                ? section.Items
                : section.Items.Where(item => L[item.Label].Value.Contains(navSearch,
                    StringComparison.OrdinalIgnoreCase)).ToArray()
        }).Where(section => section.Items.Length > 0);

    private sealed record NavItem(string Label, string Icon, string Path, bool Implemented = true);
    private sealed record NavSection(string Title, string Icon, NavItem[] Items);

    private static NavItem Live(string label, string icon, string path) => new(label, icon, path);
    private static NavItem Planned(string label, string icon, string key) =>
        new(label, icon, "/navigation/" + key);

    // Match the section and item order in the reference index.html.
    // All items remain visible for every account: DirectAdmin authorizes each request.
    private static readonly NavSection[] AllSections =
    [
        new("Account management", "♙",
        [
            Live("Add new user", "♙", "/users"),
            Live("Show all users", "♧", "/users"),
            Live("My users", "♙", "/users"),
            Live("Manage user packages", "▤", "/users"),
            Planned("Move users between resellers", "⇄", "move-users"),
            Planned("Message templates", "✉", "message-templates"),
            Live("Change passwords", "⚿", "/change-password"),
            Live("Create reseller", "♙", "/resellers"),
            Live("Resellers", "♙", "/resellers"),
            Live("Manage reseller packages", "▤", "/resellers"),
            Planned("Create administrator", "♙", "create-admin"),
            Live("Administrators", "♙", "/users")
        ]),
        new("Server management", "▣",
        [
            Live("Administrator settings", "⚙", "/server-settings"),
            Live("Backend settings", "⚙", "/backend-settings"),
            Planned("Custom HTTPD configurations", "▤", "httpd-config"),
            Live("DNS management", "◎", "/dns-zones"),
            Planned("IP management", "⌁", "ip-management"),
            Planned("Name servers", "◇", "name-servers"),
            Planned("Multi-server setup", "▦", "multi-server"),
            Planned("PHP settings", "⌘", "php-settings"),
            Live("Server TLS certificate", "♢", "/server-tls"),
            Planned("CustomBuild", "⚒", "custombuild")
        ]),
        new("Admin tools", "⚒",
        [
            Planned("Backup and restore", "◷", "backup-restore"),
            Planned("Brute force monitor", "♢", "brute-force-monitor"),
            Planned("Process monitor", "▥", "process-monitor"),
            Planned("Manage mail queue", "✉", "mail-queue"),
            Live("System services", "⚙", "/system-services"),
            Planned("System backup", "▣", "system-backup"),
            Planned("Import cPanel", "⇩", "cpanel-import"),
            Planned("Message all users", "✉", "broadcast"),
            Planned("Themes", "◈", "themes"),
            Planned("Customize Evolution theme", "◈", "evolution-theme"),
            Planned("Maintenance", "⚒", "maintenance")
        ]),
        new("System information & files", "▤",
        [
            Planned("All users' cron jobs", "◷", "global-cron"),
            Planned("System file editor", "▤", "system-file-editor"),
            Planned("View logs", "☷", "system-logs"),
            Live("Global statistics", "◴", "/system-info")
        ]),
        new("Extra programs", "▦",
        [
            Planned("Plugin management", "▦", "plugin-manager"),
            Planned("ConfigServer Security & Firewall", "♢", "csf")
        ]),
        new("Support", "?",
        [
            Live("Manage tickets", "☏", "/tickets"),
            Live("Create ticket", "✉", "/tickets/new"),
            Live("Updates", "↻", "/system-updates"),
            Planned("Licensing", "♧", "licensing")
        ]),
        new("Additional HostingPanel features", "⌘",
        [
            Live("Sessions", "◷", "/sessions"),
            Live("Reseller management", "♙", "/resellers"),
            Live("Database management", "▦", "/databases"),
            Live("System information", "▤", "/system-info"),
            Live("ModSecurity and ClamAV", "♢", "/security"),
            Live("DirectAdmin API", "⌘", "/api-browser")
        ])
    ];

    private static readonly NavSection[] AdminSections =
        AllSections.Where(section => section.Title != "User").ToArray();

    private static readonly NavSection[] UserSections =
    [
        new("User", "♙",
        [
            Live("Domain management", "◎", "/domains"),
            Planned("Email accounts", "✉", "email-accounts"),
            Planned("File management", "▤", "file-manager"),
            Live("Databases", "▦", "/databases"),
            Planned("SSL certificates", "♢", "domain-ssl"),
            Live("DNS management", "◎", "/dns-zones"),
            Planned("Cron jobs", "◷", "cron-jobs"),
            Planned("Backups", "◷", "user-backups")
        ]),
        new("Support", "☏",
        [
            Live("Tickets", "☏", "/tickets"),
            Live("New ticket", "✉", "/tickets/new"),
            Live("Messages", "✉", "/messages"),
            Live("Change password", "⚿", "/change-password")
        ])
    ];

    private void ReturnToAdministrator()
    {
        Session.EndImpersonation();
        Navigation.NavigateTo("/");
    }
}
