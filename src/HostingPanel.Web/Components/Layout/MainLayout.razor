@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <PanelToolbar DrawerOpen="@drawerOpen" ToggleDrawer="ToggleDrawer" />
    <MudDrawer @bind-Open="drawerOpen" Variant="DrawerVariant.Responsive" Elevation="1" Width="280px">
        <PanelSidebar />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4">
            <PanelBreadcrumb />
            <ImpersonationBanner />
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;
    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
