@inherits LayoutComponentBase
@inject DirectAdminSession Session
@inject NavigationManager Navigation

<div class="shell">
  <aside class="sidebar" aria-label="Hoofdnavigatie">
    <a class="brand" href="/">◈ <span>HostingPanel<small>CONTROL CENTER</small></span></a>
    <div class="nav-caption">Navigatie</div>
    <label class="sidebar-search-label" for="hosting-nav-search">Zoek naar pagina's</label>
    <input id="hosting-nav-search" class="sidebar-search" type="search"
           placeholder="Zoek naar pagina's..." @bind="navSearch" @bind:event="oninput" />
    <NavLink href="/" Match="NavLinkMatch.All">▦ Dashboard</NavLink>
    <nav class="sidebar-scroll" aria-label="Beheeronderdelen">
      @foreach (var section in FilteredSections)
      {
        <details class="nav-section" open>
          <summary><span class="nav-icon" aria-hidden="true">@section.Icon</span>@section.Title</summary>
          <div class="nav-section-items">
            @foreach (var item in section.Items)
            {
              <NavLink href="@item.Path" class="nav-item">
                <span class="nav-icon" aria-hidden="true">@item.Icon</span>
                <span>@item.Label</span>
                @if (!item.Implemented)
                {
                  <span class="nav-pending" title="Nog niet geïmplementeerd" aria-label="Nog niet geïmplementeerd">○</span>
                }
              </NavLink>
            }
          </div>
        </details>
      }
    </nav>
    <p class="nav-note">DirectAdmin-compatibele API<br />De backend bepaalt de toegangsrechten.</p>
  </aside>
  <div class="workspace">
    <header class="topbar">
      <span>HostingPanel / beheer</span>
      <span>@(Session.Connected ? Session.Username : "Niet verbonden")</span>
    </header>
    @if (Session.IsImpersonating)
    {
      <div class="impersonation-banner" role="status">
        <span><strong>Impersonation actief:</strong> je werkt als <strong>@Session.Username</strong>
        namens beheerder <strong>@Session.OriginalUsername</strong>.</span>
        <button @onclick="ReturnToAdministrator">Terug naar beheerder</button>
      </div>
    }
    <main class="content">@Body</main>
  </div>
</div>

@code {
    private string navSearch = "";
    private IEnumerable<NavSection> FilteredSections => string.IsNullOrWhiteSpace(navSearch)
        ? Sections
        : Sections.Select(section => section with {
            Items = section.Title.Contains(navSearch, StringComparison.OrdinalIgnoreCase)
                ? section.Items
                : section.Items.Where(item => item.Label.Contains(navSearch,
                    StringComparison.OrdinalIgnoreCase)).ToArray()
        }).Where(section => section.Items.Length > 0);

    private sealed record NavItem(string Label, string Icon, string Path, bool Implemented = true);
    private sealed record NavSection(string Title, string Icon, NavItem[] Items);

    private static NavItem Live(string label, string icon, string path) => new(label, icon, path);
    private static NavItem Planned(string label, string icon, string key) =>
        new(label, icon, "/navigation/" + key, false);

    // Match the section and item order in the reference index.html.
    // All items remain visible for every account: DirectAdmin authorizes each request.
    private static readonly NavSection[] Sections =
    [
        new("Accountbeheer", "♙",
        [
            Live("Nieuwe Gebruiker Toevoegen", "♙", "/users"),
            Live("Toon Alle Gebruikers", "♧", "/users"),
            Live("Mijn Gebruikers", "♙", "/users"),
            Live("Beheer gebruikers pakketten", "▤", "/users"),
            Planned("Verplaats Gebruikers tussen Resellers", "⇄", "move-users"),
            Planned("Berichtsjablonen", "✉", "message-templates"),
            Live("Wachtwoorden wijzigen", "⚿", "/change-password"),
            Live("Reseller Aanmaken", "♙", "/resellers"),
            Live("Resellers", "♙", "/resellers"),
            Live("Beheer Reseller Pakketten", "▤", "/resellers"),
            Planned("Admin Aanmaken", "♙", "create-admin"),
            Live("Administrators", "♙", "/users")
        ]),
        new("Server Beheer", "▣",
        [
            Live("Administrator instellingen", "⚙", "/server-settings"),
            Planned("Aangepaste HTTPD configuraties", "▤", "httpd-config"),
            Live("DNS Beheer", "◎", "/dns-zones"),
            Planned("IP Beheer", "⌁", "ip-management"),
            Planned("Naam Servers", "◇", "name-servers"),
            Planned("Multi Server Instellen", "▦", "multi-server"),
            Planned("PHP Instellingen", "⌘", "php-settings"),
            Live("Server TLS Certificaat", "♢", "/server-tls"),
            Planned("CustomBuild", "⚒", "custombuild")
        ]),
        new("Admin Gereedschap", "⚒",
        [
            Planned("Back-up en herstel", "◷", "backup-restore"),
            Planned("Brute Force Monitor", "♢", "brute-force-monitor"),
            Planned("Proces Monitor", "▥", "process-monitor"),
            Planned("Beheer van e-mail wachtrij", "✉", "mail-queue"),
            Live("Systeem Services", "⚙", "/system-services"),
            Planned("Systeem Backup", "▣", "system-backup"),
            Planned("cPanel Importeren", "⇩", "cpanel-import"),
            Planned("Bericht aan Alle Gebruikers", "✉", "broadcast"),
            Planned("Thema’s", "◈", "themes"),
            Planned("Evolution Thema Aanpassen", "◈", "evolution-theme"),
            Planned("Onderhoud", "⚒", "maintenance")
