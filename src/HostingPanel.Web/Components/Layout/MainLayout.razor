@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout Class="analytics-shell">
    <PanelToolbar DrawerOpen="@drawerOpen" ToggleDrawer="ToggleDrawer" />
    <MudDrawer @bind-Open="drawerOpen" Variant="DrawerVariant.Responsive" Elevation="0" Width="256px" Class="analytics-drawer">
        <PanelSidebar />
    </MudDrawer>
    <MudMainContent Class="analytics-main">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="analytics-content">
            <ImpersonationBanner />
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;
    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
