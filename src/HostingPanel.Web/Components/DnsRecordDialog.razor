@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject DirectAdminSession Session

<MudDialog>
    <DialogContent>
        <p>@L["DirectAdmin determines whether the change is permitted."]</p>
        <label for="dnsType">Type</label>
        <MudSelect T="string" @bind-Value="type" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="dnsType" Disabled="@busy">
            @foreach (var item in new [] {"A","AAAA","CNAME","MX","TXT","SRV","CAA","NS","PTR","DS","TLSA"})
            { <MudSelectItem T="string" Value='@item'>@item</MudSelectItem> }
        </MudSelect>
        <label for="dnsName">@L["Name"]</label>
        <MudTextField T="string" @bind-Value="name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dnsName" Placeholder="www" Disabled="@busy" />
        <label for="dnsValue">@L["Value"]</label>
        <MudTextField T="string" @bind-Value="value" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dnsValue" Disabled="@busy" Lines="3" />
        <label for="dnsTtl">@L["TTL (optional, 60–604800 seconds)"]</label>
        <MudTextField T="string" @bind-Value="ttl" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="dnsTtl" Disabled="@busy" />

        @if (error is not null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@busy" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">@(OriginalType is null ? L["Add DNS record"].Value : L["Save change"].Value)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Domain { get; set; } = "";
    [Parameter] public string? OriginalType { get; set; }
    [Parameter] public string? OriginalName { get; set; }
    [Parameter] public string? OriginalValue { get; set; }
    [Parameter] public string? OriginalTtl { get; set; }
    private string type = "A", name = "", value = "", ttl = "";
    private string? identity, error;
    private bool busy;
    protected override void OnInitialized()
    {
        identity = Session.Username;
        type = OriginalType ?? "A";
        name = OriginalName ?? "";
        value = OriginalValue ?? "";
        ttl = OriginalTtl ?? "";
    }
    private void Cancel() { if (!busy) Dialog.Cancel(); }
    private async Task Save()
    {
        if (busy || !Session.Connected || !string.Equals(identity, Session.Username, StringComparison.Ordinal)) return;
        busy = true; error = null;
        try
        {
            var (status, _) = await Session.ChangeDnsRecordAsync(Domain, OriginalType is null ? "add" : "edit",
                type, name, value, string.IsNullOrWhiteSpace(ttl) ? null : ttl,
                OriginalType, OriginalName, OriginalValue);
            if (status == 200) { Dialog.Close(DialogResult.Ok(true)); return; }
            error = status switch
            {
                409 => L["DirectAdmin reported a conflict for this DNS change."].Value,
                400 => L["Invalid DNS record data."].Value,
                403 => L["Permission to modify the DNS zone denied."].Value,
                _ => L["DNS change not confirmed (HTTP {0}).", status].Value
            };
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        { error = ex.Message; }
        finally { busy = false; }
    }
}
