<div class="page-header">
    <div>
        @if (Breadcrumb is not null)
        {
            <MudText Typo="Typo.overline" Color="Color.Secondary">@Breadcrumb</MudText>
        }
        <MudText Typo="Typo.h4" HtmlTag="h1">@TitleContent</MudText>
        @if (Description is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">@Actions</MudStack>
    }
</div>

@code {
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
    [Parameter, EditorRequired] public RenderFragment TitleContent { get; set; } = default!;
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
