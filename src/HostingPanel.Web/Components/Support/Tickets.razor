@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/tickets"
@using HostingPanel.Api.Services
@inject PanelSession Session
@inject TicketOperations TicketOps
@implements IDisposable
<PageTitle>Tickets — HostingPanel</PageTitle>

<PanelPageHeader>
    <Breadcrumb>@L["Support / Tickets"]</Breadcrumb>
    <TitleContent>@L["Ticket management"]</TitleContent>
    <Description>@L["Received tickets and own requests. DirectAdmin determines which tickets you can view."]</Description>
    <Actions><MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <CrudAddButton Href="/tickets/new" Disabled="@(!Session.Connected || loading)">@L["New ticket"]</CrudAddButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@loading" OnClick="Load">@L["↻ Refresh"]</MudButton>
    </MudStack></Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else
{
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <div class="dashboard-section-heading"><h2>@L["Ticket overview"]</h2>
            @if (tickets is not null) { <MudChip T="string" Size="Size.Small" Color="Color.Default">@tickets.Count tickets</MudChip> }
        </div>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6"><label for="ticketSearch">@L["Search"]</label>
                <MudTextField T="string" @bind-Value="search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="ticketSearch" Placeholder="@L["Subject, sender…"].Value" /></MudItem>
            <MudItem xs="12" sm="6"><label for="ticketFilter">@L["View"]</label>
                <MudSelect T="string" @bind-Value="filter" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="ticketFilter">
                    <MudSelectItem T="string" Value='@("all")'>@L["All tickets"]</MudSelectItem><MudSelectItem T="string" Value='@("received")'>@L["Received"]</MudSelectItem>
                    <MudSelectItem T="string" Value='@("request")'>@L["My requests"]</MudSelectItem><MudSelectItem T="string" Value='@("unread")'>@L["Unread"]</MudSelectItem>
                    <MudSelectItem T="string" Value='@("open")'>@L["Open"]</MudSelectItem><MudSelectItem T="string" Value='@("closed")'>@L["Closed"]</MudSelectItem>
                </MudSelect></MudItem>
        </MudGrid>
        @if (loading) { <PanelLoading>@L["Retrieving tickets…"]</PanelLoading> }
        @if (error is not null) { <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert> }
        @if (warning is not null) { <p class="error" role="status">@L["The overview may be incomplete: {0}", warning]</p> }
        @if (tickets is not null)
        {
            <div class="overview-scroll">
                <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="overview-table">
                    <thead><tr><th>@L["Status"]</th><th>@L["Subject"]</th><th>@L["From"]</th><th>@L["Origin"]</th><th>@L["Priority"]</th><th>@L["Date"]</th></tr></thead>
                    <tbody>
                        @foreach (var ticket in Visible)
                        {
                            <tr>
                                <td><MudChip T="string" Size="Size.Small" Color="@(ticket.Open ? Color.Success : Color.Default)">@(ticket.Open ? L["Open"].Value : L["Closed"].Value)</MudChip></td>
                                <td><a href="@($"/tickets/{ticket.Id}?source={ticket.Source}")">@ticket.Subject</a>
                                    @if (ticket.Unread) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["New"]</MudChip> }</td>
                                <td>@(string.IsNullOrWhiteSpace(ticket.FromName) ? ticket.From : ticket.FromName)</td>
                                <td>@(ticket.Source == "received" ? L["Received"].Value : L["Sent"].Value)</td>
                                <td>@ticket.Priority</td>
                                <td>@ticket.Timestamp</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
            @if (Visible.Count == 0) { <PanelEmptyState>@L["No tickets match this filter."]</PanelEmptyState> }
        }
    </MudPaper>
    <MudPaper Class="pa-4 my-3" Elevation="1">
        <div class="dashboard-section-heading"><h2>@L["Messages"]</h2><a href="/messages">@L["View all messages"]</a></div>
        @if (messageCount > 0)
        {
            <p><MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Messages: {0}", messageCount]</MudChip> @L["New messages also appear through SignalR at the top of the interface."]</p>
        }
        else { <p>@L["No messages in the current backend result."]</p> }
    </MudPaper>
}

@code {
    private List<TicketEntry>? tickets;
    private string search = "", filter = "all";
    private string? error, warning;
    private int messageCount;
    private readonly LatestRead read = new();
    private bool loading => read.Loading;
    private bool disposed;
    private bool refreshPending;

    private IReadOnlyList<TicketEntry> Visible => (tickets ?? []).Where(t =>
        (filter switch {
            "received" => t.Source == "received", "request" => t.Source == "request",
            "open" => t.Open, "closed" => !t.Open, "unread" => t.Unread, _ => true
        }) && (t.Subject.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               t.From.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               t.FromName.Contains(search, StringComparison.OrdinalIgnoreCase))).ToArray();

    private void OnTicketChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed || !Session.Connected) return;
        if (loading)
        {
            refreshPending = true;
            return;
        }
        await Load();
        if (!disposed) StateHasChanged();
    });

    private void OnSessionChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        read.Cancel();
        refreshPending = false;
        tickets = null;
        messageCount = 0;
        warning = error = null;
        var task = Load();
        StateHasChanged();
        await task;
        if (!disposed) StateHasChanged();
    });

    public void Dispose()
    {
        disposed = true;
        refreshPending = false;
        Session.TicketInboxChanged -= OnTicketChanged;
        Session.Changed -= OnSessionChanged;
        read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        Session.TicketInboxChanged += OnTicketChanged;
        Session.Changed += OnSessionChanged;
        await Load();
    }

    private async Task Load()
    {
        if (disposed || !Session.Connected) return;
        if (loading)
        {
            refreshPending = true;
            return;
        }
        var channel = Session.TicketChannel;
        bool Current() => !disposed && Session.Connected && Session.TicketChannel == channel;
        do
        {
            refreshPending = false;
            error = null;
            await read.RunAsync(ct => TicketOps.InboxAsync(ct), Current,
                result =>
                {
                    var (status, inbox, _) = result;
                    if (status != 200 || inbox is null)
                    {
                        ClearInventory();
                        error = L["The backend did not return the ticket list (HTTP {0}).", status].Value;
                        return;
                    }
                    tickets = inbox.Tickets.ToList();
                    messageCount = inbox.Messages.Count;
                    warning = inbox.Warnings.Count > 0 ? string.Join(", ", inbox.Warnings) : null;
                },
                ex =>
                {
                    ClearInventory();
                    error = ex.Message;
                });
            if (!Current()) return;
            StateHasChanged();
        } while (refreshPending && !loading);
    }

    private void ClearInventory()
    {
        tickets = null;
        messageCount = 0;
        warning = null;
    }
}
