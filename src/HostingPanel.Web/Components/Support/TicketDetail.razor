@using HostingPanel.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/tickets/{Id:long}"
@using System.Text.Json
@using HostingPanel.Api.Services
@inject PanelSession Session
@inject TicketOperations TicketOps
@implements IDisposable
@inject NavigationManager Navigation
<PageTitle>Ticket #@Id — HostingPanel</PageTitle>
<PanelPageHeader>
    <Breadcrumb><a href="/tickets">@L["Ticket management"]</a> / Ticket #@Id</Breadcrumb>
    <TitleContent>@(ticket is null ? $"Ticket #{Id}" : ticket.Subject)</TitleContent>
    <Description>@L["Messages and replies from DirectAdmin."]</Description>
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@loading" OnClick="Load">@L["↻ Refresh"]</MudButton></Actions>
</PanelPageHeader>
@if (!Session.Connected)
{
    <MudPaper Class="pa-4 my-3" Elevation="1">@L["Sign in first using the"] <a href="/">@L["dashboard"]</a>.</MudPaper>
}
else
{
    @if (error is not null) { <MudPaper Class="pa-4 my-3" Elevation="1"><MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert></MudPaper> }
    @if (loading) { <PanelLoading>@L["Retrieving ticket…"]</PanelLoading> }
    @if (ticket is not null)
    {
        <MudPaper Class="pa-4 my-3" Elevation="1">
            <div class="dashboard-section-heading"><h2>@L["Ticket details"]</h2>
                <MudChip T="string" Size="Size.Small" Color="@(IsOpen ? Color.Success : Color.Default)">@(IsOpen ? "Open" : L["Closed"].Value)</MudChip></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4"><label>@L["Sender"]</label><p>@ticket.FromName (@ticket.From)</p></MudItem>
                <MudItem xs="12" sm="4"><label>@L["Date"]</label><p>@ticket.Timestamp</p></MudItem>
                <MudItem xs="12" sm="4"><label>@L["Ticket number"]</label><p>@ticket.LegacyId</p></MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <p class="ticket-message">@ticket.Message</p>
        </MudPaper>
        @if (ticket.Replies is { } replies)
        {
            <MudPaper Class="pa-4 my-3" Elevation="1">
                <h2>@L["Conversation ({0} replies)", replies.Length]</h2>
                @foreach (var reply in replies)
                {
                    <article class="ticket-reply">
                        <header><strong>@Text(reply, "fromName")</strong>
                            <span>@Text(reply, "timestamp")</span></header>
                        <p class="ticket-message">@Text(reply, "message")</p>
                    </article>
                }
            </MudPaper>
        }
        <MudPaper Class="pa-4 my-3" Elevation="1">
            <h2>@L["Replies"]</h2>
            <p>@L["Replies are saved through DirectAdmin. Only backend confirmation is considered successful."]</p>
            <label for="ticketReply">@L["Message"]</label>
            <MudTextField T="string" @bind-Value="replyMessage" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="ticketReply" Lines="8" MaxLength="65536" />
            <label for="ticketTo">@L["Recipient"]</label>
            <MudTextField T="string" @bind-Value="recipient" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" InputId="ticketTo" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(sending || string.IsNullOrWhiteSpace(replyMessage) || string.IsNullOrWhiteSpace(recipient))" OnClick="SendReply">@L["Send reply"]</MudButton>
                @if (Source == "received")
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@sending" OnClick="ToggleStatus">@(IsOpen ? L["Close ticket"].Value : L["Reopen ticket"].Value)</MudButton>
                }
            </MudStack>
            @if (feedback is not null) { <p role="status">@feedback</p> }
        </MudPaper>
    }
}
@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string Source { get; set; } = "request";
    private TicketEntry? ticket;
    private string recipient = "creator", replyMessage = "";
    private string? error, feedback;
    private bool loading, sending;
    private bool IsOpen => ticket?.Open == true;
    private static string Text(JsonElement item, string name) =>
        item.TryGetProperty(name, out var value) ? value.ToString() : "";

    private void OnTicketChanged() => _ = InvokeAsync(async () =>
    {
        await Load();
        StateHasChanged();
    });
    public void Dispose() => Session.TicketInboxChanged -= OnTicketChanged;
    protected override void OnInitialized() => Session.TicketInboxChanged += OnTicketChanged;
    protected override async Task OnParametersSetAsync() { if (Session.Connected) await Load(); }
    private async Task Load()
    {
        if (loading || !Session.Connected) return;
        loading = true; error = null;
        try
        {
            var (status, entry) = await TicketOps.GetAsync(Id, Source);
            if (status != 200 || entry is null) { error = L["Ticket unavailable (HTTP {0}).", status].Value; ticket = null; return; }
            ticket = entry;
            recipient = Source == "received" ? ticket.From : "creator";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException)
        { error = ex.Message; ticket = null; }
        finally { loading = false; }
    }
    private async Task SendReply()
    {
        if (sending || ticket is null || string.IsNullOrWhiteSpace(replyMessage)) return;
        sending = true; feedback = null;
        try
        {
            var (status, body) = await TicketOps.ReplyAsync(ticket.LegacyId, new TicketReplyRequest(replyMessage, recipient, ticket.Subject, Source));
            if (body is null && status is >= 200 and < 300) { replyMessage = ""; await Load(); }
            else feedback = L["The backend did not confirm the reply (HTTP {0}): {1}", status, body].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException)
        { feedback = ex.Message; }
        finally { sending = false; }
    }
    private async Task ToggleStatus()
    {
        if (sending || ticket is null || Source != "received") return;
        sending = true; feedback = null;
        try
        {
            var (status, body) = await TicketOps.SetStatusAsync(ticket.LegacyId, new TicketStatusChange(Source, !IsOpen));
            if (body is null && status is >= 200 and < 300) await Load();
            else feedback = L["Status change not confirmed (HTTP {0}): {1}", status, body].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { feedback = ex.Message; }
        finally { sending = false; }
    }
}
