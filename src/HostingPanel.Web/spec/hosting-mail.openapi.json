{
  "openapi": "3.0.3",
  "info": {
    "title": "HostingPanel Mail API",
    "version": "1.0",
    "description": "Additional provider-neutral mail operations. Separate from the pinned DirectAdmin Swagger. Both backends support the documented subset. Kubernetes/Stalwart mutations require administrator privileges; DirectAdmin applies upstream permissions. Password changes currently return 501."
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/hosting/mail/{domain}/accounts": {
      "parameters": [
        {
          "name": "domain",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "listMailAccounts",
        "responses": {
          "200": {
            "description": "Authorized mailbox inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accounts"
                  ],
                  "properties": {
                    "accounts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MailAccount"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createMailAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mailbox created"
          },
          "default": {
            "description": "Operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/hosting/mail/{domain}/accounts/{name}": {
      "parameters": [
        {
          "name": "domain",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "updateMailAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mailbox updated"
          },
          "default": {
            "description": "Operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMailAccount",
        "parameters": [
          {
            "name": "confirmation",
            "in": "query",
            "required": true,
            "description": "Exact name@domain",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mailbox deleted"
          },
          "default": {
            "description": "Operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          }
        }
      },
      "MailAccount": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "quotaBytes": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "usedBytes": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "MailCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "password",
          "quotaBytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 256,
            "writeOnly": true
          },
          "quotaBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "MailUpdateRequest": {
        "type": "object",
        "properties": {
          "quotaBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "password": {
            "type": "string",
            "format": "password",
            "nullable": true,
            "writeOnly": true,
            "description": "Reserved; password changes currently return 501."
          }
        }
      }
    }
  }
}
